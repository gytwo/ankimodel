},
    
    selectMask(maskElement) {
    if (this.selectedMask && this.selectedMask !== maskElement) {
        this.selectedMask.classList.remove('selected');
        this.removeMaskControls(this.selectedMask);
    }
    
    this.selectedMask = maskElement;
    maskElement.classList.add('selected');
    
    if (this.mode === 'edit') {
        this.createMaskControls(maskElement);
    }
},
    
    startMoveMask() {
        if (!this.selectedMask) {
            this.showNotification('请先选择一个遮罩', 'warning');
            return;
        }
        this.isMovingMask = true;
        this.showNotification('拖动遮罩进行移动，释放鼠标完成', 'info');
    },
    
    moveSelectedMask(x, y) {
        if (!this.selectedMask || !this.isMovingMask || this.mode !== 'edit') return;
        const data = this.getCurrentImageData();
        if (!data || !data.masks) return;
        const wrapper = this.selectedMask.parentElement.parentElement;
        const wrapperRect = wrapper.getBoundingClientRect();
        const img = wrapper.querySelector('img');
        const naturalWidth = img.naturalWidth || wrapperRect.width;
        const naturalHeight = img.naturalHeight || wrapperRect.height;
        const absolutePos = CoordinateSystem.displayToAbsolute(
            x,
            y,
            naturalWidth,
            naturalHeight,
            wrapperRect.width,
            wrapperRect.height
        );
        const naturalRelX = (absolutePos.x / naturalWidth) * 100;
        const naturalRelY = (absolutePos.y / naturalHeight) * 100;
        
        const maskId = this.selectedMask.id;
        const newMasks = data.masks.map(mask => {
            if (mask.id === maskId) {
                return {
                    ...mask,
                    x: naturalRelX,
                    y: naturalRelY
                };
            }
            return mask;
        });
        
        const newData = {
            masks: newMasks,
            drawings: data.drawings || [],
            note: data.note || ''
        };
        
        this.selectedMask.style.left = x + 'px';
        this.selectedMask.style.top = y + 'px';
        
        this.saveImageData(this.activeImage, newData);
    },
    
    resizeSelectedMask(x, y) {
        if (!this.selectedMask || !this.isResizingMask || this.mode !== 'edit') return;
        const data = this.getCurrentImageData();
        if (!data || !data.masks) return;
        const wrapper = this.selectedMask.parentElement.parentElement;
        const wrapperRect = wrapper.getBoundingClientRect();
        const img = wrapper.querySelector('img');
        const naturalWidth = img.naturalWidth || wrapperRect.width;
        const naturalHeight = img.naturalHeight || wrapperRect.height;
        let newLeft = parseFloat(this.selectedMask.style.left);
        let newTop = parseFloat(this.selectedMask.style.top);
        let newWidth = parseFloat(this.selectedMask.style.width);
        let newHeight = parseFloat(this.selectedMask.style.height);
        const minSize = 20;
        if (this.resizeDirection) {
            switch(this.resizeDirection) {
                case 'br':
                    newWidth = Math.max(minSize, x - newLeft);
                    newHeight = Math.max(minSize, y - newTop);
                    break;
                case 'tr':
                    newWidth = Math.max(minSize, x - newLeft);
                    newHeight = Math.max(minSize, parseFloat(this.selectedMask.style.top) + parseFloat(this.selectedMask.style.height) - y);
                    newTop = y;
                    break;
                case 'bl':
                    newWidth = Math.max(minSize, parseFloat(this.selectedMask.style.left) + parseFloat(this.selectedMask.style.width) - x);
                    newHeight = Math.max(minSize, y - newTop);
                    newLeft = x;
                    break;
                case 'tl':
                    newWidth = Math.max(minSize, parseFloat(this.selectedMask.style.left) + parseFloat(this.selectedMask.style.width) - x);
                    newHeight = Math.max(minSize, parseFloat(this.selectedMask.style.top) + parseFloat(this.selectedMask.style.height) - y);
                    newLeft = x;
                    newTop = y;
                    break;
            }
        }
        if (newLeft < 0) newLeft = 0;
        if (newTop < 0) newTop = 0;
        if (newLeft + newWidth > wrapperRect.width) newWidth = wrapperRect.width - newLeft;
        if (newTop + newHeight > wrapperRect.height) newHeight = wrapperRect.height - newTop;
        if (newWidth < minSize) newWidth = minSize;
        if (newHeight < minSize) newHeight = minSize;
        this.selectedMask.style.left = newLeft + 'px';
        this.selectedMask.style.top = newTop + 'px';
        this.selectedMask.style.width = newWidth + 'px';
        this.selectedMask.style.height = newHeight + 'px';
        const absolutePos = CoordinateSystem.displayToAbsolute(
            newLeft,
            newTop,
            naturalWidth,
            naturalHeight,
            wrapperRect.width,
            wrapperRect.height
        );
        const absoluteSize = CoordinateSystem.displayToAbsolute(
            newLeft + newWidth,
            newTop + newHeight,
            naturalWidth,
            naturalHeight,
            wrapperRect.width,
            wrapperRect.height
        );
        
        const maskId = this.selectedMask.id;
        const newMasks = data.masks.map(mask => {
            if (mask.id === maskId) {
                return {
                    ...mask,
                    x: (absolutePos.x / naturalWidth) * 100,
                    y: (absolutePos.y / naturalHeight) * 100,
                    width: ((absoluteSize.x - absolutePos.x) / naturalWidth) * 100,
                    height: ((absoluteSize.y - absolutePos.y) / naturalHeight) * 100
                };
            }
            return mask;
        });
        
        const newData = {
            masks: newMasks,
            drawings: data.drawings || [],
            note: data.note || ''
        };
        
        this.saveImageData(this.activeImage, newData);
    },
    
    getMaskData(maskId) {
        if (!this.activeImage) return null;
        const data = this.getCurrentImageData();
        if (!data || !data.masks) return null;
        return data.masks.find(mask => mask.id === maskId);
    },
    
    eraseAt(x, y, imgId) {
        const canvas = document.getElementById(`drawings-${imgId}`);
        const ctx = canvas.getContext('2d');
        const data = this.getCurrentImageData();
        if (!data || !data.drawings) return;
        
        this.saveDrawHistory(imgId, 'pre_erase', {
            oldDrawings: JSON.parse(JSON.stringify(data.drawings))
        });
        
        const radius = this.settings.eraserSize / 2;
        const remainingDrawings = [];
        data.drawings.forEach(drawing => {
            if (!drawing.points || drawing.points.length < 2) return;
            const newPoints = [];
            for (let i = 0; i < drawing.points.length; i++) {
                const point = drawing.points[i];
                const wrapper = this.getWrapperByImgId(imgId);
                if (!wrapper) continue;
                const img = wrapper.querySelector('img');
                const imgRect = img.getBoundingClientRect();
                const pixelX = (point[0] / 100) * imgRect.width;
                const pixelY = (point[1] / 100) * imgRect.height;
                const distance = Math.sqrt(Math.pow(pixelX - x, 2) + Math.pow(pixelY - y, 2));
                if (distance > radius) {
                    newPoints.push(point);
                }
            }
            if (newPoints.length >= 2) {
                remainingDrawings.push({
                    ...drawing,
                    points: newPoints
                });
            }
        });
        
        const newData = {
            masks: data.masks || [],
            drawings: remainingDrawings,
            note: data.note || ''
        };
        
        this.saveImageData(imgId, newData);
        this.redrawCanvas(imgId);
    },
    
    setTool(tool) {
    const editTools = ['pen', 'eraser', 'mask_rect', 'mask_circle', 'note'];
    
    if (this.storage && this.storage.currentImageDataSource === 'field' && 
        editTools.includes(tool)) {
        
        const toolNames = {
            'pen': '画笔',
            'eraser': '橡皮',
            'mask_rect': '矩形遮罩',
            'mask_circle': '圆形遮罩',
            'note': '备注'
        };
        
        const switchToLocal = confirm(
            `当前为ImageCloze字段模式（只读）\n\n` +
            `是否切换到ImageCloze本地模式使用${toolNames[tool]}？`
        );
        
        if (switchToLocal) {
            this.switchImageDataSource();
            this.showNotification('已切换到ImageCloze本地模式，可以开始编辑', 'success');
        } else {
            if (this.mode !== 'review') {
                this.switchToReviewMode();
            }
            this.showNotification('字段模式下无法使用编辑工具，已回到复习模式', 'warning');
            return;
        }
    }
    
    this.currentTool = tool;
    document.querySelectorAll('.tool-btn').forEach(btn => {
        btn.classList.remove('active', 'layer-active', 'mask-active', 'drawing-active', 'note-active');
    });
    document.querySelectorAll('.action-btn').forEach(btn => {
        btn.classList.remove('active');
    });
    if (tool === 'pen') {
        document.getElementById('penBtn').classList.add('active', 'layer-active', 'drawing-active');
        document.getElementById('penSettings').style.display = 'block';
        document.getElementById('eraserSettings').style.display = 'none';
        document.getElementById('penColorSection').style.display = 'block';
        if (this.eraserPreview) {
            this.eraserPreview.remove();
            this.eraserPreview = null;
        }
        const layerStatus = document.getElementById('layerStatus');
        layerStatus.textContent = '编辑模式 - 画笔工具';
        layerStatus.className = 'layer-status-display show drawing-active';
        this.updateToolName('画笔工具');
    } else if (tool === 'eraser') {
        document.getElementById('eraserBtn').classList.add('active', 'layer-active', 'drawing-active');
        document.getElementById('penSettings').style.display = 'none';
        document.getElementById('eraserSettings').style.display = 'block';
        document.getElementById('penColorSection').style.display = 'none';
        const layerStatus = document.getElementById('layerStatus');
        layerStatus.textContent = '编辑模式 - 橡皮擦工具';
        layerStatus.className = 'layer-status-display show drawing-active';
        this.updateToolName('橡皮擦');
        this.showNotification('圆形橡皮擦已激活，可在激活的图片上擦除涂鸦', 'info');
    } else if (tool === 'mask_rect') {
        document.getElementById('maskRectBtn').classList.add('active', 'layer-active', 'mask-active');
