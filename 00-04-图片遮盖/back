        // 创建新元素
        var newSpan = document.createElement('span');
        newSpan.className = 'cloze-inactive';
        newSpan.setAttribute('data-ordinal', currentNumber);
        
        var cloze2_w = document.createElement('cloze2_w');
        cloze2_w.className = 'cz-' + currentNumber;
