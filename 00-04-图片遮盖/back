<script>
// ========== 1.显示所有挖空答案 ==========
function showAllCloze() {
    document.querySelectorAll('cloze2, cloze2_w').forEach(function(element) {
        var isInlineCloze2 = (element.tagName.toLowerCase() === 'cloze2' && element.style.display === 'inline');
        if (!isInlineCloze2) {
            element.classList.add('reveal-cloze2');
        }
    });
    
    // 更新挖空按钮文本
    var button = document.querySelector('.toggleAllClozebtn');
    if (button) {
        const textSpan = button.querySelector('.popup-badge-text');
        if (textSpan) {
            textSpan.textContent = 'cloze 隐';
        }
    }
    
    // 更新"显示下一个答案"的状态
    if (typeof clozeGroups !== 'undefined' && clozeGroups.length > 0) {
        currentGroupIndex = clozeGroups.length - 1;
        updateNextClozeButtonText();
    }
}

// ========== 2.隐藏所有挖空答案 ==========
function hideAllCloze() {
    document.querySelectorAll('cloze2, cloze2_w').forEach(function(element) {
        element.classList.remove('reveal-cloze2');
    });
    
    // 更新挖空按钮文本
    var button = document.querySelector('.toggleAllClozebtn');
    if (button) {
        const textSpan = button.querySelector('.popup-badge-text');
        if (textSpan) {
            textSpan.textContent = 'cloze 显';
        }
    }
    
    // 重置"显示下一个答案"的状态
    if (typeof currentGroupIndex !== 'undefined') {
        currentGroupIndex = -1;
    }
    if (typeof clozeGroups !== 'undefined') {
        clozeGroups = getAllClozeGroups();
        updateNextClozeButtonText();
    }
}

// ========== 3.切换所有挖空答案 ==========
function toggleAllCloze() {
    // 检查是否有显示的挖空答案
    var anyRevealed = false;
    document.querySelectorAll('cloze2, cloze2_w').forEach(function(el) {
        // 只检查 cloz2 元素（挖空内容），不检查 cloze2_w（占位符）
        if (el.tagName.toLowerCase() === 'cloze2' && el.classList.contains('reveal-cloze2')) {
            anyRevealed = true;
        }
    });
    
    // 根据状态调用相应函数
    if (anyRevealed) {
        hideAllCloze();
    } else {
        showAllCloze();
    }
}

// ========== 4.切换当前挖空答案 ==========
function toggleCloze(element) {
    if (!element || !element.classList) return;
    var className = element.classList[0];
    if (!className) return;
    
    var elements = document.querySelectorAll('.' + className);
    for (var i = 0; i < elements.length; i++) {
        var el = elements[i];
        if (!el.closest('.cloze')) {
            el.classList.toggle('reveal-cloze2');
        }
    }
}

// ========== 5.优化HTML结构 ==========
function optimizeClozeElements(element) {
    if (!element) element = document.body;
    
    let i = 0;
    while (i < element.children.length) {
        const child = element.children[i];
        optimizeClozeElements(child);
        
        if (child.tagName && child.tagName.toLowerCase() === 'cloze2') {
            const cloze2_w = child.querySelector('cloze2_w');
            const innerCloze2 = child.querySelector('cloze2:not(cloze2_w)');
            
            if (cloze2_w && innerCloze2) {
                element.insertBefore(cloze2_w, child);
                element.insertBefore(innerCloze2, child);
                
                while (child.firstChild) {
                    element.insertBefore(child.firstChild, child);
                }
                
                child.remove();
                continue;
            }
        }
        
        if (child.tagName && child.tagName.toLowerCase() === 'cloze2_w' && i > 0) {
            const prevSibling = element.children[i - 1];
            if (prevSibling.tagName && prevSibling.tagName.toLowerCase() === 'cloze2_w' &&
                prevSibling.className === child.className) {
                child.remove();
                continue;
            }
        }
        i++;
    }
}

// ========== 6.显示并跳转至下一个答案 ==========
// 全局变量：用于跟踪当前显示的挖空组索引
var currentGroupIndex = -1;
var clozeGroups = [];

// 6.1 获取所有需要显示的挖空组
function getAllClozeGroups() {
    const groups = new Set();
    
    document.querySelectorAll('cloze2').forEach(function(el) {
        if (!el.closest('.cloze') && !el.classList.contains('reveal-cloze2')) {
            const className = el.classList[0];
            if (className) {
                groups.add(className);
            }
        }
    });
    
    return Array.from(groups);
}

// 6.2 折叠所有其他元素（除了指定的元素）
function collapseAllExcept(element) {
    if (!element) return;
    
    // 折叠所有details（除了包含当前元素的details）
    var allDetails = document.querySelectorAll('details');
    allDetails.forEach(function(detail) {
        if (!detail.contains(element)) {
            detail.open = false;
        }
    });
    
    // 折叠所有node节点（除了包含当前元素的节点）
    var allNodes = document.querySelectorAll('.node');
    allNodes.forEach(function(node) {
        if (!node.contains(element)) {
            node.classList.remove('expanded');
            var bulletDot = node.querySelector('.bullet-dot');
            if (bulletDot) {
                bulletDot.style.boxShadow = '0 0 0 2px rgb(100, 106, 115), 0 0 0 4px rgb(200, 200, 200)';
                bulletDot.style.backgroundColor = 'transparent';
            }
        }
    });
    
    // 关闭所有弹窗（除了包含当前元素的弹窗）
    var allPopups = document.querySelectorAll('.popup-container.popup-visible');
    allPopups.forEach(function(popup) {
        if (!popup.contains(element)) {
            popup.classList.remove('popup-visible');
            var popupId = popup.id;
            var badgeId = popupId.replace('-popup', '-badge');
            var badge = document.getElementById(badgeId);
            if (badge) {
                badge.classList.remove('badge-active');
            }
        }
    });
}

// 6.3 展开当前元素的父元素（节点和details）
function expandCurrentElement(element) {
    if (!element) return;
    
    // 先展开包含当前元素的所有details
    var currentDetail = element;
    while (currentDetail) {
        if (currentDetail.tagName === 'DETAILS') {
            currentDetail.open = true;
        }
        currentDetail = currentDetail.parentElement;
    }
    
    // 展开包含当前元素的所有node节点
    var currentNode = element;
    while (currentNode) {
        if (currentNode.classList && currentNode.classList.contains('node')) {
            currentNode.classList.add('expanded');
            var bulletDot = currentNode.querySelector('.bullet-dot');
            if (bulletDot) {
                bulletDot.style.boxShadow = 'none';
                bulletDot.style.backgroundColor = 'rgb(100, 106, 115)';
            }
        }
        currentNode = currentNode.parentElement;
    }
}

// 6.4 展开包含当前元素的弹窗
function expandContainingPopup(element) {
    if (!element) return;
    
    // 向上查找，找到包含当前元素的弹窗
    var currentElement = element;
    var containingPopup = null;
    
    while (currentElement) {
        if (currentElement.classList && 
            currentElement.classList.contains('popup-container') &&
            currentElement.classList.contains('popup-visible')) {
            // 已经是打开的弹窗，直接返回
            return;
        }
        
        if (currentElement.classList && 
            currentElement.classList.contains('popup-container')) {
            containingPopup = currentElement;
            break;
        }
        currentElement = currentElement.parentElement;
    }
    
    // 如果找到了弹窗，打开它
    if (containingPopup) {
        var popupId = containingPopup.id;
        var badgeId = popupId.replace('-popup', '-badge');
        
        // 打开弹窗
        containingPopup.classList.add('popup-visible');
        
        // 激活对应的按钮
        var badge = document.getElementById(badgeId);
        if (badge) {
            badge.classList.add('badge-active');
        }
        
        // 将弹窗提到最前面
        if (typeof bringElementToFront === 'function') {
            setTimeout(function() {
                bringElementToFront(containingPopup);
            }, 10);
        }
    }
}

// 6.5 查找当前显示的组
function findCurrentVisibleGroup() {
    let lastVisibleGroup = null;
    document.querySelectorAll('cloze2').forEach(function(el) {
        if (!el.closest('.cloze') && el.classList.contains('reveal-cloze2')) {
            const className = el.classList[0];
            if (className) {
                lastVisibleGroup = className;
            }
        }
    });
    return lastVisibleGroup;
}

// 6.6 显示并跳转到下一组答案
function showNextCloze() {
    // 如果还未初始化，先初始化
    if (clozeGroups.length === 0) {
        clozeGroups = getAllClozeGroups();
    }
    
    // 如果没有任何挖空组，直接返回
    if (clozeGroups.length === 0) {
        return;
    }
    
    // ========== 简化逻辑：始终找到下一组未完全显示的 ==========
    
    // 1. 查找所有未完全显示的组
    const incompleteGroups = [];
    for (let i = 0; i < clozeGroups.length; i++) {
        const groupName = clozeGroups[i];
        const elements = document.querySelectorAll('.' + groupName);
        
        // 检查该组是否有未显示的挖空
        let hasHidden = false;
        for (let j = 0; j < elements.length; j++) {
            const el = elements[j];
            if (!el.closest('.cloze') && !el.classList.contains('reveal-cloze2')) {
                hasHidden = true;
                break;
            }
        }
        
        if (hasHidden) {
            incompleteGroups.push({
                groupName: groupName,
                index: i
            });
        }
    }
    
    // 2. 如果所有组都完全显示了，重置从头开始
    if (incompleteGroups.length === 0) {
        hideAllCloze();
        clozeGroups = getAllClozeGroups();
        
        // 重新查找未完全显示的组
        const newIncompleteGroups = [];
        for (let i = 0; i < clozeGroups.length; i++) {
            newIncompleteGroups.push({
                groupName: clozeGroups[i],
                index: i
            });
        }
        
        if (newIncompleteGroups.length === 0) return;
        
        // 选择第一组
        currentGroupIndex = newIncompleteGroups[0].index;
    } else {
        // 3. 找到当前显示组之后的第一组
        const currentVisibleGroup = findCurrentVisibleGroup();
        
        if (currentVisibleGroup) {
            // 从当前显示组之后开始找
            let startIndex = (clozeGroups.indexOf(currentVisibleGroup) + 1) % clozeGroups.length;
            let foundNext = false;
            
            // 循环查找下一组未完全显示的
            for (let i = 0; i < clozeGroups.length; i++) {
                const checkIndex = (startIndex + i) % clozeGroups.length;
                const groupName = clozeGroups[checkIndex];
                
                // 检查这组是否有未显示的
                const elements = document.querySelectorAll('.' + groupName);
                let hasHidden = false;
                for (let j = 0; j < elements.length; j++) {
                    const el = elements[j];
                    if (!el.closest('.cloze') && !el.classList.contains('reveal-cloze2')) {
                        hasHidden = true;
                        break;
                    }
                }
                
                if (hasHidden) {
                    currentGroupIndex = checkIndex;
                    foundNext = true;
                    break;
                }
            }
            
            if (!foundNext) {
                // 没找到，重置
                hideAllCloze();
                clozeGroups = getAllClozeGroups();
                currentGroupIndex = 0;
            }
        } else {
            // 没有当前显示组，选第一组未完全显示的
            currentGroupIndex = incompleteGroups[0].index;
        }
    }
    
    // ========== 逻辑结束 ==========
    
    // 获取当前组的类名
    const className = clozeGroups[currentGroupIndex];
    
    // 查找该组的所有挖空元素
    const elements = document.querySelectorAll('.' + className);
    if (elements.length === 0) {
        // 重新初始化
        clozeGroups = getAllClozeGroups();
        if (clozeGroups.length > 0) {
            currentGroupIndex = 0;
            showNextCloze(); // 重试
        }
        return;
    }
    
    // ========== 跳转定位功能 ==========
    
    // 1. 折叠所有其他元素（除了当前组）
    collapseAllExcept(elements[0]);
    
    // 2. 展开当前元素所在的弹窗
    expandContainingPopup(elements[0]);
    
    // 3. 显示该类的所有挖空
    for (var i = 0; i < elements.length; i++) {
        var el = elements[i];
        if (!el.closest('.cloze')) {
            el.classList.add('reveal-cloze2');
        }
    }
    
    // 4. 展开当前元素的父元素（节点和details）
    expandCurrentElement(elements[0]);
    
    // 5. 智能滚动：只在需要时滚动
    setTimeout(function() {
        if (elements.length > 0) {
            const firstElement = elements[0];
            const elementRect = firstElement.getBoundingClientRect();
            
            // 检查元素是否在可视区域内
            const isInViewport = (
                elementRect.top >= 0 &&
                elementRect.left >= 0 &&
                elementRect.bottom <= (window.innerHeight || document.documentElement.clientHeight) &&
                elementRect.right <= (window.innerWidth || document.documentElement.clientWidth)
            );
            
            // 检查元素是否部分可见（至少20%可见）
            const isPartiallyVisible = (
                elementRect.top < (window.innerHeight || document.documentElement.clientHeight) * 0.8 &&
                elementRect.bottom > (window.innerHeight || document.documentElement.clientHeight) * 0.2
            );
            
            // 如果元素完全不可见或只有很小部分可见，才滚动
            if (!isInViewport || !isPartiallyVisible) {
                firstElement.scrollIntoView({
                    behavior: 'smooth',
                    block: 'center'
                });
            }
        }
    }, 400);
    
    // 6. 更新按钮文本
    updateNextClozeButtonText();
}

// 6.7 更新下一个答案按钮文本
function updateNextClozeButtonText() {
    const button = document.querySelector('.showNextClozebtn');
    if (button && clozeGroups.length > 0) {
        const textSpan = button.querySelector('.popup-badge-text');
        if (textSpan) {
            textSpan.textContent = `Nc(${currentGroupIndex + 1}/${clozeGroups.length})`;
        }
    }
}

</script>


