    getMarkTypeFromElement(element) {
        if (element.classList.contains('mark-note')) return 'note';
        if (element.classList.contains('mark-bold')) return 'bold';
        if (element.classList.contains('mark-question')) return 'question';
        if (element.classList.contains('mark-highlight')) return 'highlight';
        if (element.classList.contains('mark')) {
            if (element.querySelector('h1, h2, h3, h4, h5, h6, u')) return 'html-tag';
        }
        return null;
    }

    copyToClipboard(text) {
        navigator.clipboard.writeText(text).catch(err => {
            const textArea = document.createElement('textarea');
            textArea.value = text;
            document.body.appendChild(textArea);
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);
        });
    }
    
    clearAllSelection() {
        this.selectedCurrentMarks.clear();
        this.selectedOtherMarks.clear();
        document.querySelectorAll('.anki-note-item-checkbox').forEach(checkbox => { checkbox.checked = false; });
        document.querySelectorAll('.anki-note-item').forEach(item => { item.classList.remove('selected'); });
        this.updateBatchActions();
        showMessage('已取消所有选择', 'success');
    }
}

class NoteMarkSystemCleaner {
    constructor(system) { this.system = system; }
    
    cleanup() {
        try {
            this.removeAllMarkElements();
            this.removeAllUIComponents();
            this.clearAllStorageData();
            this.removeAllEventListeners();
            this.clearGlobalReferences();
            this.clearAllTimers();
            return true;
        } catch (error) {
            showMessage('清理过程中出错', 'error');
            return false;
        }
    }
    
    removeAllMarkElements() {
        try {
            const marks = document.querySelectorAll('.mark');
            marks.forEach(mark => {
                const originalText = mark.textContent;
                const textNode = document.createTextNode(originalText);
                if (mark.parentNode) mark.parentNode.replaceChild(textNode, mark);
            });
            return true;
        } catch (error) { return false; }
    }
    
    removeAllUIComponents() {
        try {
            const components = ['ankiMarkToolbar', 'ankiNotesPanel', 'ankiNoteEditor', 'ankiMessage'];
            components.forEach(id => {
                const element = document.getElementById(id);
                if (element && element.parentNode) element.parentNode.removeChild(element);
            });
            return true;
        } catch (error) { return false; }
    }
    
    clearAllStorageData() {
        try {
            const storageKeys = ['notemark_system_config', 'notemark_current_data_source'];
            storageKeys.forEach(key => { localStorage.removeItem(key); });
            sessionStorage.removeItem('notemark_temp_data');
            return true;
        } catch (error) { return false; }
    }
    
    removeAllEventListeners() {
        try {
            const eventsToRemove = ['mouseup', 'touchend', 'click', 'keydown', 'selectionchange'];
            const dummyHandler = () => {};
            eventsToRemove.forEach(eventType => {
                document.removeEventListener(eventType, dummyHandler, true);
                document.removeEventListener(eventType, dummyHandler, false);
            });
            window.removeEventListener('scroll', dummyHandler);
            window.removeEventListener('resize', dummyHandler);
            return true;
        } catch (error) { return false; }
    }
    
    clearGlobalReferences() {
        try {
            if (window.NoteMark) delete window.NoteMark;
            if (window.NoteMarkSystem) delete window.NoteMarkSystem;
            if (window._NoteMarkSystemLoaded) delete window._NoteMarkSystemLoaded;
            const globalKeys = Object.keys(window).filter(key => key.includes('anki') || key.includes('notemark') || key.includes('NoteMark'));
            globalKeys.forEach(key => { try { delete window[key]; } catch (e) {} });
            return true;
        } catch (error) { return false; }
    }
    
    clearAllTimers() {
        try {
            const timerKeys = Object.keys(window).filter(key => key.includes('anki') || key.includes('notemark'));
            timerKeys.forEach(key => {
                if (key.startsWith('timeout_') || key.startsWith('interval_')) {
                    const timerId = window[key];
                    if (timerId) { clearTimeout(timerId); clearInterval(timerId); }
                    delete window[key];
                }
            });
            let maxTimerId = setTimeout(() => {}, 0);
            for (let i = maxTimerId - 100; i <= maxTimerId; i++) {
                clearTimeout(i);
                clearInterval(i);
            }
            return true;
        } catch (error) { return false; }
    }
}

class NoteMarkSystem {
    constructor() {
        this.currentSelection = null;
        this.currentRange = null;
        this.storage = new NoteMarkStorage();
        this.dataManager = new NoteMarkDataManager(this.storage);
        this.operations = new NoteMarkOperations(this);
        this.initialized = false;
        this.activeMarkElement = null;
        this.editingNoteId = null;
        this.isMobile = isMobile;
        this.categoryTypes = ['note', 'bold', 'question', 'highlight', 'html-tag'];
        this.categoryNames = { 'note': '📝 笔记', 'bold': '🔤 加粗', 'question': '❓ 疑问', 'highlight': '🟡 高亮', 'html-tag': '🏷️ HTML标签' };
        this.collapsedCategories = { 'note': true, 'bold': true, 'question': true, 'highlight': true, 'html-tag': true };
        this.lastSearchTerm = '';
        this.currentDataSource = 'local';
        this.cleaner = new NoteMarkSystemCleaner(this);
        this.categorizedMarks = null;
        this.markStats = null;
    }
    
    restart() {
        try {
            showMessage('正在重启系统...', 'warning');
            const restartDataSource = this.currentDataSource;
            const hasPopupSystem = typeof initAllPopups === 'function' || typeof setupPopupControl === 'function';
            this.cleaner.cleanup();
            delete window._NoteMarkSystemLoaded;
            delete window.NoteMarkSystem;
            delete window.NoteMark;
            setTimeout(() => {
                try {
                    window.NoteMarkSystem = new NoteMarkSystem();
                    window.NoteMarkSystem.currentDataSource = restartDataSource;
                    window.NoteMarkSystem.storage.setCurrentDataSource(restartDataSource);
                    window.NoteMarkSystem.initializeMarkSystem();
                    window.NoteMark = {
                        system: window.NoteMarkSystem,
                        storage: window.NoteMarkSystem.storage,
                        dataManager: window.NoteMarkSystem.dataManager,
                        operations: window.NoteMarkSystem.operations,
                        cleaner: window.NoteMarkSystem.cleaner,
                        showMessage: showMessage,
                        escapeHtml: escapeHtml,
                        restart: () => window.NoteMarkSystem.restart()
                    };
                    if (hasPopupSystem) {
                        setTimeout(() => { try { if (typeof initAllPopups === 'function') initAllPopups(); } catch (e) { } }, 300);
                    }
                    showMessage(`✅ 系统重启完成！数据源：${restartDataSource}`, 'success');
                } catch (error) {
                    showMessage(`重启失败: ${error.message}`, 'error');
                }
            }, 500);
            return true;
        } catch (error) {
            showMessage(`重启失败: ${error.message}`, 'error');
            return false;
        }
    }
    
    initializeMarkSystem() {
        if (this.initialized) return;
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => this.setupSystem());
        } else {
            setTimeout(() => this.setupSystem(), 300);
        }
    }
    
    setupSystem() {
        try {
            this.createSystemElements();
            this.bindSystemEvents();
            this.currentDataSource = this.storage.getCurrentDataSource();
            if (this.currentDataSource !== 'NoteMark本地' && this.currentDataSource !== 'NoteMark字段') {
                this.currentDataSource = 'NoteMark本地';
                this.storage.setCurrentDataSource('NoteMark本地');
            }
            this.refreshMarkCategorization();
            this.updatePanelToggle();
            this.initialized = true;
        } catch (error) {
            showMessage('系统初始化失败', 'error');
        }
    }
    
    createSystemElements() {
        if (!document.getElementById('ankiMarkToolbar')) {
            const toolbar = document.createElement('div');
            toolbar.id = 'ankiMarkToolbar';
            toolbar.innerHTML = `
            <div style="display: flex; gap: 4px; align-items: center; flex-wrap: wrap;">
                <div style="display: flex; gap: 2px; flex-wrap: nowrap;">
                    <button class="anki-btn anki-btn-h1" data-mark-type="html-tag" data-html-tag="h1" title="添加<h1>标签">H1</button>
                    <button class="anki-btn anki-btn-h2" data-mark-type="html-tag" data-html-tag="h2" title="添加<h2>标签">H2</button>
                    <button class="anki-btn anki-btn-h3" data-mark-type="html-tag" data-html-tag="h3" title="添加<h3>标签">H3</button>
                    <button class="anki-btn anki-btn-h4" data-mark-type="html-tag" data-html-tag="h4" title="添加<h4>标签">H4</button>
                    <button class="anki-btn anki-btn-h5" data-mark-type="html-tag" data-html-tag="h5" title="添加<h5>标签">H5</button>
                    <button class="anki-btn anki-btn-h6" data-mark-type="html-tag" data-html-tag="h6" title="添加<h6>标签">H6</button>
                </div>
                <div style="display: flex; gap: 2px; flex-wrap: nowrap;">
                    <button class="anki-btn anki-btn-underline" data-mark-type="html-tag" data-html-tag="u" title="添加<u>标签">U</button>
                    <button class="anki-btn" data-mark-type="bold" title="加粗" style="font-weight: bold;">B</button>
                    <button class="anki-btn" data-mark-type="question" title="疑问标记" style="background: #2196F3; color: white; font-weight: bold;">❓</button>
                    <button class="anki-btn" data-mark-type="highlight" title="高亮" style="background: #FFEB3B; color: #333;">H</button>
                    <button class="anki-btn" data-mark-type="note" title="添加笔记（支持富文本）" style="background: #4CAF50; color: white;">📝</button>
                    <button class="anki-btn" data-action="restart" title="重启系统（自动清理并重启）" style="background: #607D8B; color: white;">🔄</button>
                </div>
