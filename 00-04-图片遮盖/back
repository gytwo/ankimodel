    element.appendChild(resizeHandle);
}

// 5. 统一拖拽函数（支持鼠标和触摸）
function enableElementDrag(element, isSearchBox = false) {
    element.style.cursor = 'grab';
    element.style.userSelect = 'none';
    element.style.touchAction = 'none';
    
    const shouldStartDrag = (target) => {
        const tagName = target.tagName.toLowerCase();
        const className = target.className || '';
        
        // 排除可交互元素
        if (tagName === 'input' || 
            tagName === 'button' || 
            tagName === 'textarea' ||
            tagName === 'select' ||
            tagName === 'a') {
            return false;
        }
        
        // 排除特定类名元素
        if (className.includes('clickable') ||
            className.includes('toggle') ||
            className.includes('expand') ||
            className.includes('collapse') ||
            className.includes('action-btn') ||
            className.includes('quick-btn') ||
            className.includes('searchbtn') ||
            className.includes('popup-badge') ||
            className.includes('anki-btn') ||
            className.includes('anki-header-btn') ||
            className.includes('anki-editor-action-btn') ||
            className.includes('anki-editor-toolbar-btn') ||
            className.includes('anki-note-item-action') ||
            className.includes('anki-category-header') ||
            className.includes('anki-category-title') ||
            className.includes('anki-category-icon') ||
            className.includes('anki-category-count')) {
            return false;
        }
        
        // 排除内容区域
        if (target.closest('.content') ||
            target.closest('.text') ||
            target.closest('[contenteditable]') ||
            target.closest('.area') ||
            target.closest('.linkRender') ||
            target.closest('.anki-note-editor-content') ||
            target.closest('#ankiNotesSearch') ||
            target.closest('.anki-note-item') ||
            target.closest('.anki-note-editor-original')) {
            return false;
        }
        
        // 排除缩放手柄和关闭按钮
        if (className.includes('resize-handle') ||
            target.closest('.resize-handle') ||
            className.includes('popup-close') ||
            className.includes('search-close') ||
            className.includes('data-management-close') ||
            className.includes('anki-note-editor-close') ||
            className.includes('anki-preview-close') || 
            className.includes('#ankiNotesPanelClose')) {
            return false;
        }

        // 排除笔记面板的分类标题
        if (target.closest('.anki-category-header')) {
        return false;
    }

        // 排除笔记面板的三个区域（简单直接）
        if (target.closest('.current-card-ops') ||
            target.closest('.other-card-ops') ||
            target.closest('.notemarks-notice')) {
            return false;
        }
        
        // 排除预览窗口的内容区域
        if (target.closest('#ankiNotePreview .anki-preview-content')) {
            return false; // 内容区域不能拖拽
        }
 
       // 🔥 专门排除图片遮盖系统的内容区域
       if (target.closest('#dataManagementDialog .data-management-content') ||  // 数据管理弹窗内容区域
            target.closest('.data-management-btn')   ||  // 数据管理弹窗标题按钮区域
            target.closest('#guideDialog .data-management-content')) { // 使用指南内容
            return false;
        }

        return true;
    };
    
    // 点击提到最前面
    element.addEventListener('mousedown', function(e) {
        const target = e.target;
        if (!shouldStartDrag(target)) {
            bringElementToFront(element);
            return;
        }
        
        bringElementToFront(element);
    });
    
    // ==================== 鼠标拖拽 ====================
    element.addEventListener('mousedown', function startDrag(e) {
        const target = e.target;
        if (!shouldStartDrag(target)) {
            return;
        }
        
        e.preventDefault();
        e.stopPropagation();
        
        bringElementToFront(element);
        
        element.style.transform = 'none';
        
        const startX = e.clientX;
        const startY = e.clientY;
        const rect = element.getBoundingClientRect();
        const startLeft = rect.left;
        const startTop = rect.top;
        
        function drag(e) {
            const dx = e.clientX - startX;
            const dy = e.clientY - startY;
            
            const newLeft = startLeft + dx;
            const newTop = startTop + dy;
            
            const adjusted = ensureElementNotFullyInvisible(element, newLeft, newTop);
            
            element.style.left = adjusted.left + 'px';
            element.style.top = adjusted.top + 'px';
        }
        
        function stopDrag() {
            document.removeEventListener('mousemove', drag);
            document.removeEventListener('mouseup', stopDrag);
            element.style.cursor = 'grab';
            // ❌ 删除保存位置的代码
        }
        
        document.addEventListener('mousemove', drag);
        document.addEventListener('mouseup', stopDrag);
        element.style.cursor = 'grabbing';
    });
    
    // ==================== 触摸拖拽 ====================
    element.addEventListener('touchstart', function(e) {
        if (e.touches.length !== 1) return;
        
        const touch = e.touches[0];
        const target = document.elementFromPoint(touch.clientX, touch.clientY);
        
        if (target) {
            if (!shouldStartDrag(target)) {
                bringElementToFront(element);
                return;
            }
        }
        
        e.preventDefault();
        e.stopPropagation();
        
        bringElementToFront(element);
        
        element.style.transform = 'none';
        
        const startX = touch.clientX;
        const startY = touch.clientY;
        const rect = element.getBoundingClientRect();
        const startLeft = rect.left;
        const startTop = rect.top;
        
        function touchDrag(e) {
            if (e.touches.length !== 1) return;
            e.preventDefault();
            
            const touch = e.touches[0];
            const dx = touch.clientX - startX;
            const dy = touch.clientY - startY;
            
            const newLeft = startLeft + dx;
            const newTop = startTop + dy;
            
            const adjusted = ensureElementNotFullyInvisible(element, newLeft, newTop);
            
            element.style.left = adjusted.left + 'px';
            element.style.top = adjusted.top + 'px';
        }
        
        function touchEnd() {
            document.removeEventListener('touchmove', touchDrag);
            document.removeEventListener('touchend', touchEnd);
            // ❌ 删除保存位置的代码
        }
        
        document.addEventListener('touchmove', touchDrag, { passive: false });
        document.addEventListener('touchend', touchEnd);
    }, { passive: false });
}

// 6. 核心弹窗控制函数（集成版）
function setupPopupControl(popupId, badgeSelector, closeSelector) {
    var popup = document.getElementById(popupId);
    
    if (!popup) {
        return;
    }
    
    // 基础设置
    if (!popup.style.position || popup.style.position === 'static') {
        popup.style.position = 'fixed';
    }
    
    popup.style.cursor = 'grab';
    popup.style.userSelect = 'none';
    popup.style.touchAction = 'none';
    popup.style.zIndex = window.popupZIndex.base;
    
    // 移动端优化：防止点击穿透
    popup.style['-webkit-tap-highlight-color'] = 'transparent';
    
    setupResizeFunctionality(popup, false);
    enableElementDrag(popup, false);
    
    // 点击弹窗提到最前面
    popup.addEventListener('mousedown', function(e) {
        if (!e.target.closest('.resize-handle')) {
            bringElementToFront(popup);
        }
    });
    
    popup.addEventListener('touchstart', function(e) {
        if (e.touches.length === 1 && !e.target.closest('.resize-handle')) {
            bringElementToFront(popup);
        }
    }, { passive: false });
    
    // ==================== 处理按钮点击 ====================
    if (badgeSelector) {
        var badgeElements = [];
        
        if (badgeSelector.startsWith('.')) {
            badgeElements = document.querySelectorAll(badgeSelector);
        } else if (badgeSelector.startsWith('#')) {
            var element = document.getElementById(badgeSelector.substring(1));
            if (element) badgeElements = [element];
        } else {
            badgeElements = document.querySelectorAll(badgeSelector);
        }
        
        // 为每个按钮元素绑定点击事件
        badgeElements.forEach(function(badge) {
            badge.removeEventListener('click', badge._popupClickHandler);
            badge.removeEventListener('touchstart', badge._popupTouchHandler);
            
            badge._popupClickHandler = function(e) {
                if (e.target.closest('.anki-note-editor-close') || 
                    e.target.closest('.anki-editor-action-btn') ||
                    e.target.closest('.anki-editor-toolbar-btn')) {
                    return;
                }
                
                e.preventDefault();
        
                var isVisible = popup.classList.contains('popup-visible');
                
                if (!isVisible) {
                    popup.classList.add('popup-visible');
                    if (badge.classList) {
                        badge.classList.add('badge-active');
                    }
                    bringElementToFront(popup);
                    

                } else {
                    popup.classList.remove('popup-visible');
                    if (badge.classList) {
                        badge.classList.remove('badge-active');
                    }
                }
            };
            
            badge._popupTouchHandler = function(e) {
                e.preventDefault();
                e.stopPropagation();
                badge._popupClickHandler(e);
            };
            
            badge.addEventListener('click', badge._popupClickHandler);
            badge.addEventListener('touchstart', badge._popupTouchHandler, { passive: false });
        });
    }
    
    // ==================== 处理关闭按钮 ====================
    if (closeSelector) {
        var closeBtn = null;
        
        if (closeSelector.startsWith('.')) {
            closeBtn = document.querySelector(closeSelector);
        } else if (closeSelector.startsWith('#')) {
            closeBtn = document.getElementById(closeSelector.substring(1));
        } else {
            closeBtn = document.querySelector(closeSelector);
        }
        
        if (closeBtn) {
            closeBtn.removeEventListener('click', closeBtn._popupCloseHandler);
            closeBtn.removeEventListener('touchstart', closeBtn._popupCloseTouchHandler);
            
            closeBtn._popupCloseHandler = function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                popup.classList.remove('popup-visible');
                
                if (badgeSelector) {
                    var badges = [];
                    if (badgeSelector.startsWith('.')) {
                        badges = document.querySelectorAll(badgeSelector);
                    } else if (badgeSelector.startsWith('#')) {
                        var badge = document.getElementById(badgeSelector.substring(1));
                        if (badge) badges = [badge];
                    } else {
                        badges = document.querySelectorAll(badgeSelector);
                    }
                    
                    badges.forEach(function(badge) {
                        if (badge.classList) {
                            badge.classList.remove('badge-active');
                        }
                    });
                }
            };
            
            closeBtn._popupCloseTouchHandler = function(e) {
                e.preventDefault();
                e.stopPropagation();
                closeBtn._popupCloseHandler(e);
            };
            
            closeBtn.addEventListener('click', closeBtn._popupCloseHandler);
            closeBtn.addEventListener('touchstart', closeBtn._popupCloseTouchHandler, { passive: false });
        }
    }
}

// 7. 初始化所有弹窗
function initAllPopups() {
    // 弹窗配置
    const popupConfigs = [
        // 标准弹窗
        { id: 'note-popup', badge: '#note-badge', close: '#note-close' },
        { id: 'expand-popup', badge: '#expand-badge', close: '#expand-close' },
        { id: 'reference-popup', badge: '#reference-badge', close: '#reference-close' },
        { id: 'conclude-popup', badge: '#conclude-badge', close: '#conclude-close' },
        
        // 🔥 新增：图片遮盖系统的弹窗
        { id: 'dataManagementDialog', badge: null, close: '.popup-close[data-dialog-id="dataManagementDialog"]'  },
        { id: 'guideDialog', badge: null, close: '.popup-close[data-dialog-id="guideDialog"]' }
    ];
    
    // 初始化每个弹窗
    popupConfigs.forEach(function(config) {
        var popup = document.getElementById(config.id);
        if (popup) {
            setupPopupControl(config.id, config.badge, config.close);
        }
    });
    
    // 搜索框处理
    const searchBox = document.getElementById('searchBox');
    if (searchBox) {
        searchBox.classList.add('popup-visible');
        setupResizeFunctionality(searchBox, true);
        enableElementDrag(searchBox, true);

    }
