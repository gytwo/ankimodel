                                     60;
                    content.style.maxHeight = (newHeight - headerHeight) + 'px';
                    content.style.overflowY = 'auto';
                }
            }
        }
        
        function stopResize() {
            document.removeEventListener('mousemove', resize);
            document.removeEventListener('mouseup', stopResize);
        }
        
        document.addEventListener('mousemove', resize);
        document.addEventListener('mouseup', stopResize);
    });
    
    // ==================== 触摸缩放事件 ====================
    resizeHandle.addEventListener('touchstart', function(e) {
        if (e.touches.length !== 1) return;
        e.preventDefault();
        e.stopPropagation();
        
        bringElementToFront(element);
        
        var touch = e.touches[0];
        var startX = touch.clientX;
        var startY = touch.clientY;
        var startWidth = element.offsetWidth;
        var startHeight = element.offsetHeight;
        
        element.style.transform = 'none';
        
        function touchResize(e) {
            if (e.touches.length !== 1) return;
            e.preventDefault();
            
            var touch = e.touches[0];
            var dx = touch.clientX - startX;
            var dy = touch.clientY - startY;
            
            var minWidth = isSearchBox ? 150 : 150;
            var minHeight = isSearchBox ? 100 : 150;
            var maxWidth = isSearchBox ? 2000 : 2000;
            var maxHeight = isSearchBox ? 2000 : 2000;
            
            var newWidth = Math.max(minWidth, Math.min(startWidth + dx, maxWidth));
            var newHeight = Math.max(minHeight, Math.min(startHeight + dy, maxHeight));
            
            element.style.width = newWidth + 'px';
            element.style.height = newHeight + 'px';
            
            if (!isSearchBox) {
                var content = element.querySelector('.popup-content') || 
                             element.querySelector('.anki-note-editor-body') ||
                             element.querySelector('#ankiNotesPanelContent');
                if (content) {
                    var headerHeight = element.querySelector('.popup-header')?.offsetHeight || 
                                     element.querySelector('.anki-note-editor-header')?.offsetHeight ||
                                     element.querySelector('#ankiNotesPanelHeader')?.offsetHeight || 
                                     60;
                    content.style.maxHeight = (newHeight - headerHeight) + 'px';
