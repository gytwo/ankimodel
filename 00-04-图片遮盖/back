    groupMarksByType(marks) {
        const groups = {};
        marks.forEach(mark => {
            if (!groups[mark.type]) groups[mark.type] = [];
            groups[mark.type].push(mark);
        });
        return groups;
    }
    
    getTypeName(type) {
        const names = { 'note': '📝 笔记', 'bold': '🔤 加粗', 'question': '❓ 疑问', 'highlight': '🟡 高亮', 'html-tag': '🏷️ HTML标签' };
        return names[type] || type;
    }
    
    bindNoteItemsEvents() {
        const noteItems = document.querySelectorAll('.anki-note-item');
        noteItems.forEach(item => {
            const noteId = item.getAttribute('data-note-id');
            const checkbox = item.querySelector('.anki-note-item-checkbox');
            if (checkbox) {
                checkbox.onclick = (e) => {
                    e.stopPropagation();
                    this.toggleNoteSelection(noteId, checkbox.checked, item.classList.contains('current-card'));
                };
            }
            const originalTextElement = item.querySelector('.anki-note-item-original.click-to-edit');
            if (originalTextElement) {
                originalTextElement.onclick = (e) => {
                    if (this.system.isMobile) e.preventDefault();
                    e.stopPropagation();
                    this.jumpToNoteMark(noteId);
                    this.openNotePreview(noteId);
                    this.system.closeNotesPanel();
                };
            }
            const copyBtn = item.querySelector('.anki-note-item-action[title="复制内容"]');
            if (copyBtn) copyBtn.onclick = (e) => { e.stopPropagation(); this.copySingleNote(noteId); };
            const deleteBtn = item.querySelector('.anki-note-item-action[title="删除"]');
            if (deleteBtn) deleteBtn.onclick = (e) => { e.stopPropagation(); this.deleteSingleNote(noteId); };
            const sourceBadges = item.querySelectorAll('.anki-note-item-type[data-source-note-id]');
            sourceBadges.forEach(badge => {
                badge.onclick = (e) => {
                    if (this.system.isMobile) e.preventDefault();
                    e.stopPropagation();
                    const sourceNoteId = badge.getAttribute('data-source-note-id');
                    if (sourceNoteId) {
                        this.jumpToNoteMark(sourceNoteId);
                        this.openNotePreview(sourceNoteId);
                        this.system.closeNotesPanel();
                    }
                };
            });
        });
    }
    
    bindCategoryHeadersEvents() {
        const categoryHeaders = document.querySelectorAll('.anki-category-header');
        categoryHeaders.forEach(header => {
            header.onclick = null;
            header.onclick = (e) => {
                if (this.system.isMobile) e.preventDefault();
                e.stopPropagation();
                if (e.target.closest('.anki-category-action')) return;
                const category = header.getAttribute('data-category');
                const itemsContainer = header.nextElementSibling;
                if (!itemsContainer || !itemsContainer.classList.contains('anki-category-items')) return;
                const isCollapsed = header.classList.contains('collapsed');
                if (isCollapsed) {
                    header.classList.remove('collapsed');
                    this.system.collapsedCategories[category] = false;
                    itemsContainer.style.maxHeight = itemsContainer.scrollHeight + 'px';
                    setTimeout(() => { itemsContainer.style.maxHeight = 'none'; }, 300);
                } else {
                    header.classList.add('collapsed');
                    this.system.collapsedCategories[category] = true;
                    itemsContainer.style.maxHeight = itemsContainer.scrollHeight + 'px';
                    requestAnimationFrame(() => { itemsContainer.style.maxHeight = '0px'; });
                }
                this.system.storage.saveConfig({ collapsedCategories: this.system.collapsedCategories });
            };
        });
    }

    toggleNoteSelection(noteId, selected, isCurrentCard) {
        if (isCurrentCard) {
            if (selected) this.selectedCurrentMarks.add(noteId);
            else this.selectedCurrentMarks.delete(noteId);
        } else {
            if (selected) this.selectedOtherMarks.add(noteId);
            else this.selectedOtherMarks.delete(noteId);
        }
        this.updateBatchActions();
    }
    
    updateBatchActions() {
        const batchActions = document.getElementById('ankiNotesBatchActions');
        const selectedCount = document.getElementById('ankiBatchSelectedCount');
        const currentCount = document.getElementById('ankiBatchCurrentCount');
        const otherCount = document.getElementById('ankiBatchOtherCount');
        if (batchActions && selectedCount && currentCount && otherCount) {
            const totalSelected = this.selectedCurrentMarks.size + this.selectedOtherMarks.size;
            if (totalSelected > 0) {
                batchActions.classList.add('popup-visible');
                selectedCount.textContent = totalSelected;
                currentCount.textContent = this.selectedCurrentMarks.size;
                otherCount.textContent = this.selectedOtherMarks.size;
            } else {
                batchActions.classList.remove('popup-visible');
            }
        }
    }
    
    jumpToNoteMark(noteId) {
        const markElement = document.querySelector(`[data-mark-id="${noteId}"]`);
        if (!markElement) {
            showMessage('未找到对应的标记', 'warning');
            return;
        }
        if (typeof collapseAllDetails === 'function') collapseAllDetails();
        if (typeof collapseAllNodes === 'function') collapseAllNodes();
        document.querySelectorAll('details').forEach(detail => {
            const containsMark = detail.contains(markElement);
            if (containsMark) {
                detail.open = true;
                if (typeof updateButtonText === 'function') updateButtonText('收');
            }
        });
        document.querySelectorAll('.node').forEach((node) => {
            const containsMark = node.contains(markElement);
            if (containsMark) {
                node.classList.add('expanded');
                if (typeof updateButtonText === 'function') updateButtonText('收');
                const bulletDot = node.querySelector('.bullet-dot');
                if (bulletDot) {
                    bulletDot.style.boxShadow = 'none';
                    bulletDot.style.backgroundColor = 'rgb(100, 106, 115)';
                }
            }
        });
        setTimeout(() => {
            markElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
            const originalBg = markElement.style.backgroundColor;
            markElement.style.backgroundColor = '#FFEB3B';
            markElement.style.transition = 'background-color 0.3s';
            setTimeout(() => {
                markElement.style.backgroundColor = originalBg;
                setTimeout(() => {
                    markElement.style.backgroundColor = '#FFEB3B';
                    setTimeout(() => { markElement.style.backgroundColor = originalBg; }, 300);
                }, 300);
            }, 300);
        }, 100);
    }

openNotePreview(noteId) {

    // 获取笔记内容
    const marks = this.system.dataManager.getNoteMarksBySource(this.system.currentDataSource);
    const noteMark = marks.find(mark => mark.id === noteId);

    // 如果不是笔记类型，直接返回，不打开预览
    if (!noteMark || noteMark.type !== 'note') {
        return; // 直接返回，不执行后续的预览创建代码
    }

    // 移除已有笔记预览、笔记面板和编辑器
    ['ankiNoteEditor', 'ankiNotesPanel', 'ankiNotePreview'].forEach(id => {
        const element = document.getElementById(id);
        if (element) element.remove();
    });
    
    // 预览窗口创建代码
    const previewHtml = noteMark.note;
    const previewContainer = document.createElement('div');
    previewContainer.id = 'ankiNotePreview';
    previewContainer.className = 'anki-note-preview popup-visible';
    
    const previewHeader = document.createElement('div');
