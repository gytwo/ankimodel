        <button class="copy-name-btn" data-image-name="${escapedImageName}" 
                onclick="copyImageName(this)" title="点击复制图片名称: ${item.imageName}">
            🔗
        </button>
    <button class="add-note-btn" 
    onclick="
        // 1. 先跳转到图片（已包含激活）
        commonImageJump('${item.id}', '${item.imageName}');
        
