<script>
function restartImageSystem() {
    const tip = document.createElement('div');
    tip.textContent = '🔄 重启系统中，请稍候...';
    tip.style.cssText = 'position:fixed;top:120px;left:20px;background:#5AC8FA;color:white;padding:6px 12px;border-radius:4px;z-index:100000;font-size:13px;';
    document.body.appendChild(tip);
    
    setTimeout(() => {
        if (window.AnkiClozeInstance) {
            try {
                if (window.AnkiClozeInstance.cleanupBeforeRestart) {
                    window.AnkiClozeInstance.cleanupBeforeRestart();
                }
