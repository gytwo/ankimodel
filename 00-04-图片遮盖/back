        const handleMouseMove = (e) => {
            const wrapper = canvas.parentElement;
            if (wrapper.classList.contains('review-mode')) {
                return;
            }
            if (this.currentTool === 'eraser' && !isDrawing && this.mode === 'edit' && this.activeImage === imgId) {
                const rect = canvas.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                if (!this.eraserPreview) {
                    createEraserPreview();
                }
                updateEraserPreview(x, y);
            }
        };
        
        canvas.addEventListener('mousemove', handleMouseMove);
        canvas.addEventListener('mouseleave', () => {
            if (this.currentTool === 'eraser' && !isDrawing) {
                hideEraserPreview();
            }
        });
        canvas.addEventListener('mousedown', startDrawing);
        canvas.addEventListener('mousemove', draw);
        canvas.addEventListener('mouseup', stopDrawing);
        canvas.addEventListener('mouseout', stopDrawing);
        canvas.addEventListener('touchstart', (e) => {
            if (e.touches.length === 1) {
                startDrawing(e);
            }
        }, { passive: false });
        canvas.addEventListener('touchmove', (e) => {
            e.preventDefault();
            draw(e);
        }, { passive: false });
        canvas.addEventListener('touchend', stopDrawing);
        canvas.addEventListener('touchcancel', stopDrawing);
    },
    
    createMaskPreview(imgId, startX, startY) {
        this.maskPreview = {
            imgId: imgId,
            type: this.currentTool === 'mask_rect' ? 'rect' : 'circle',
            startX: startX,
            startY: startY
        };
        const maskLayer = document.getElementById(`masks-${imgId}`);
        const preview = document.createElement('div');
        preview.className = 'cloze-mask mask-preview';
        preview.style.backgroundColor = this.settings.maskColor;
        preview.style.borderColor = '#FFD54F';
        preview.style.left = startX + 'px';
        preview.style.top = startY + 'px';
        preview.style.width = '0px';
        preview.style.height = '0px';
        maskLayer.appendChild(preview);
        this.maskPreview.element = preview;
    },
    
    updateMaskPreview(x, y) {
        if (!this.maskPreview || !this.maskPreview.element) return;
        const startX = this.maskPreview.startX;
        const startY = this.maskPreview.startY;
        const preview = this.maskPreview.element;
        if (this.maskPreview.type === 'rect') {
            const left = Math.min(startX, x);
            const top = Math.min(startY, y);
            const width = Math.max(10, Math.abs(x - startX));
            const height = Math.max(10, Math.abs(y - startY));
            preview.style.left = left + 'px';
            preview.style.top = top + 'px';
            preview.style.width = width + 'px';
            preview.style.height = height + 'px';
            preview.style.borderRadius = '0';
        } else {
            const radius = Math.max(10, Math.sqrt(Math.pow(x - startX, 2) + Math.pow(y - startY, 2)) / 2);
            const centerX = (startX + x) / 2;
            const centerY = (startY + y) / 2;
            preview.style.left = (centerX - radius) + 'px';
            preview.style.top = (centerY - radius) + 'px';
            preview.style.width = (radius * 2) + 'px';
            preview.style.height = (radius * 2) + 'px';
            preview.style.borderRadius = '50%';
        }
    },
    
    finishMask(imgId) {
        if (!this.maskPreview || !this.maskPreview.element) return;
        const preview = this.maskPreview.element;
        const width = parseFloat(preview.style.width) || 0;
        const height = parseFloat(preview.style.height) || 0;
        if (width < 20 || height < 20) {
            preview.remove();
            this.maskPreview = null;
            return;
        }
        preview.classList.remove('mask-preview');
        const maskId = `mask-${Date.now()}`;
        preview.id = maskId;
        const wrapper = preview.parentElement.parentElement;
        const wrapperRect = wrapper.getBoundingClientRect();
        const img = wrapper.querySelector('img');
        const naturalWidth = img.naturalWidth || wrapperRect.width;
        const naturalHeight = img.naturalHeight || wrapperRect.height;
        const displayX = parseFloat(preview.style.left);
        const displayY = parseFloat(preview.style.top);
        const displayWidth = parseFloat(preview.style.width);
        const displayHeight = parseFloat(preview.style.height);
        const absolutePos = CoordinateSystem.displayToAbsolute(
            displayX,
            displayY,
            naturalWidth,
            naturalHeight,
            wrapperRect.width,
            wrapperRect.height
        );
        const absoluteSize = CoordinateSystem.displayToAbsolute(
            displayX + displayWidth,
            displayY + displayHeight,
            naturalWidth,
            naturalHeight,
            wrapperRect.width,
            wrapperRect.height
        );
        const naturalRelX = (absolutePos.x / naturalWidth) * 100;
        const naturalRelY = (absolutePos.y / naturalHeight) * 100;
        const naturalRelWidth = ((absoluteSize.x - absolutePos.x) / naturalWidth) * 100;
        const naturalRelHeight = ((absoluteSize.y - absolutePos.y) / naturalHeight) * 100;
        this.addMaskControls(preview);
        this.addMaskActionIcons(preview);
        
        const currentData = this.getCurrentImageData();
        const maskData = {
            id: maskId,
            type: this.maskPreview.type,
            x: naturalRelX,
            y: naturalRelY,
            width: naturalRelWidth,
            height: naturalRelHeight,
            color: this.settings.maskColor,
        };
        
        const newMasks = [...(currentData.masks || []), maskData];
        const newData = {
            masks: newMasks,
            drawings: currentData.drawings || [],
            note: currentData.note || ''
        };
        
        this.saveMaskHistory(imgId, 'add_mask', maskData);
        
        this.saveImageData(imgId, newData);
        
        this.selectMask(preview);
        this.maskPreview = null;
    },
    
    addMaskControls(maskElement) {
        maskElement.dataset.hasControls = 'false';
    },
    
    createMaskControls(maskElement) {
        if (maskElement.querySelector('.mask-control-point')) {
            return;
        }
        const directions = ['tl', 'tr', 'bl', 'br'];
        directions.forEach(dir => {
            const control = document.createElement('div');
            control.className = `mask-control-point ${dir}`;
            maskElement.appendChild(control);
        });
        if (!maskElement.querySelector('.mask-action-icons')) {
            this.addMaskActionIcons(maskElement);
        }
        maskElement.dataset.hasControls = 'true';
    },
    
    removeMaskControls(maskElement) {
        const controls = maskElement.querySelectorAll('.mask-control-point');
        controls.forEach(control => control.remove());
