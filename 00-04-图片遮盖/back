    removeMark(markElement) {
    try {
        const markId = markElement.getAttribute('data-mark-id');
        
        // ===== 新增：如果是嵌入式标记，先更新源笔记 =====
        const allMarks = this.storage.getAllNoteMarks();
        const mark = allMarks.find(m => m.id === markId);
        
        // 准备要保存的标记数组（默认就是 allMarks）
        let marksToSave = allMarks;
        
        if (mark && mark._embedded === true && mark._sourceNoteId) {
            // 找到源笔记标记
            const sourceNoteIndex = allMarks.findIndex(m => m.id === mark._sourceNoteId);
            if (sourceNoteIndex !== -1) {
                // 复制一份源笔记
                const sourceNote = { ...allMarks[sourceNoteIndex] };
                
                // 如果源笔记有 note 字段，从中移除这个嵌入式标记
                if (sourceNote.note) {
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = sourceNote.note;
                    const embeddedEl = tempDiv.querySelector(`[data-mark-id="${markId}"]`);
                    
                    if (embeddedEl) {
                        // 用纯文本替换嵌入式标记
                        const text = embeddedEl.textContent;
                        const textNode = document.createTextNode(text);
                        embeddedEl.parentNode.replaceChild(textNode, embeddedEl);
                        
                        // 更新源笔记的 note 字段
                        sourceNote.note = tempDiv.innerHTML;
                        
                        // 更新数组中的源笔记
                        marksToSave = [...allMarks];
                        marksToSave[sourceNoteIndex] = sourceNote;
                    }
                }
            }
        }
        // ===== 新增结束 =====
        
        // 从DOM移除标记
        const originalText = markElement.textContent;
        const textNode = document.createTextNode(originalText);
        markElement.parentNode.replaceChild(textNode, markElement);
        
        // 从存储中删除这个标记（使用更新后的 marksToSave）
        const remainingMarks = marksToSave.filter(m => m.id !== markId);
        this.storage.saveAllNoteMarks(remainingMarks);
        
        // 刷新
        this.refreshMarkCategorization();
        this.updatePanelToggle();
        
        showMessage('标记已移除', 'success');
        return true;
        
    } catch (error) {
        showMessage('移除标记失败', 'error');
        return false;
    }
}
    
    getMarkName(type) {
        const names = { bold: '加粗', underline: '下划线', highlight: '高亮', note: '笔记', 'html-tag': 'HTML标签' };
        return names[type] || type;
    }
    
    restoreAndCategorizeMarks() {
    // ===== 1. 临时移除 NotesPanel（放在try外部）=====
    const panel = document.getElementById('ankiNotesPanel');
    const panelParent = panel?.parentNode;
    const nextSibling = panel?.nextSibling;
    let panelRemoved = false;
    
    if (panel) {
        panel.remove();  // 从DOM中移除
        panelRemoved = true;
    }
    
    try {
        // ===== 2. 获取所有保存的标记 =====
        const marks = this.dataManager.getNoteMarksBySource(this.currentDataSource);
        
        // ===== 3. 清除所有现有的标记元素 =====
        document.querySelectorAll('.mark').forEach(mark => {
            const originalText = mark.textContent;
            const textNode = document.createTextNode(originalText);
            mark.parentNode.replaceChild(textNode, mark);
        });
        
        // ===== 4. 初始化分类结果 =====
        const currentCardMarks = [];
        const otherCardMarks = [];
        const restoredIds = [];
        
        // ===== 5. 遍历每个标记进行恢复 =====
        marks.forEach(mark => {
            if (!mark || !mark.text || !mark.type) return;
            
            const text = mark.text;
            const order = mark.order || 1;
            let found = false;
            let matchCount = 0;
            let lastMatchNode = null;
            let lastMatchPos = 0;
            
            // 创建文本遍历器（面板已移除，只需排除脚本样式）
            const walker = document.createTreeWalker(
                document.body,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode: function(node) {
                        // 检查所有祖先是否在 NoteMarkData 中
                        if (node.parentElement && node.parentElement.closest('#NoteMarkData')) {
                            return NodeFilter.FILTER_REJECT;  // 跳过整个NoteMarkData分支
                        }
                        // 排除脚本和样式标签
                        if (node.parentNode && 
                            (node.parentNode.nodeName === 'SCRIPT' || 
                             node.parentNode.nodeName === 'STYLE' ||
                             node.parentNode.nodeName === 'NOSCRIPT')) {
                            return NodeFilter.FILTER_REJECT;
                        }
                        return NodeFilter.FILTER_ACCEPT;
                    }
                },
                false
            );
            
            // 第一阶段：精确匹配（按order）
            let node;
            while ((node = walker.nextNode())) {
                const nodeText = node.textContent;
                let pos = 0;
                
                while ((pos = nodeText.indexOf(text, pos)) !== -1) {
                    matchCount++;
                    
                    // 记录最后匹配的位置（用于模糊匹配）
                    lastMatchNode = node;
                    lastMatchPos = pos;
                    
                    // 精确匹配order
                    if (matchCount === order) {
                        if (this.RestoreNoteMarks(node, pos, text.length, mark)) {
                            currentCardMarks.push(mark);
                            restoredIds.push(mark.id);
                            found = true;
                            break;
                        }
                    }
                    pos += text.length;
                }
                if (found) break;
            }
            
            // 第二阶段：模糊匹配（如果精确匹配失败但文本存在）
            if (!found && matchCount > 0 && lastMatchNode) {
                if (this.RestoreNoteMarks(lastMatchNode, lastMatchPos, text.length, mark)) {
                    currentCardMarks.push(mark);
                    restoredIds.push(mark.id);
                    found = true;
                }
            }
            
            // 第三阶段：完全找不到
            if (!found) {
                otherCardMarks.push(mark);
            }
        });
        
        // ===== 6. 处理嵌入式标记（如果有） =====
        marks.forEach(mark => {
            if (mark._embedded === true && mark._sourceNoteId) {
                if (restoredIds.includes(mark._sourceNoteId)) {
                    const currentIndex = currentCardMarks.findIndex(m => m.id === mark.id);
                    const otherIndex = otherCardMarks.findIndex(m => m.id === mark.id);
                    if (otherIndex !== -1) otherCardMarks.splice(otherIndex, 1);
                    if (currentIndex === -1) currentCardMarks.push(mark);
                } else {
                    const currentIndex = currentCardMarks.findIndex(m => m.id === mark.id);
                    const otherIndex = otherCardMarks.findIndex(m => m.id === mark.id);
                    if (currentIndex === -1 && otherIndex === -1) otherCardMarks.push(mark);
                }
            }
        });
        
        // ===== 7. 处理下划线转换 =====
        setTimeout(() => {
            const uTags = document.querySelectorAll('.mark u');
            uTags.forEach(uTag => {
                if (!uTag.closest('.cloze-inactive') && !uTag.closest('cloze2')) {
                    if (window.convertSingleUnderline) window.convertSingleUnderline(uTag);
                }
            });
        }, 50);
        
        // ===== 8. 返回结果 =====
        return { currentCardMarks, otherCardMarks, restoredIds };
        
    } catch (error) {
        console.error('恢复标记失败:', error);
        return { currentCardMarks: [], otherCardMarks: [], restoredIds: [] };
        
    } finally {
        // ===== 9. 无论成功还是失败，都要恢复面板 =====
        if (panelRemoved && panelParent) {
            try {
                if (nextSibling) {
                    panelParent.insertBefore(panel, nextSibling);
                } else {
                    panelParent.appendChild(panel);
                }
            } catch (e) {
                console.error('恢复面板失败:', e);
            }
        }
    }
}
    
