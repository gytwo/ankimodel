<!-- ========== 二、大纲伸缩功能 ========== -->
<script>
// ========== （一）大纲伸缩函数：统一切换details和node ==========
function toggleOutlineBoth() {
    const anyOpen = checkIfAnyDetailsOpen() || checkIfAnyNodesOpen();
    
    if (anyOpen) {
        collapseAllDetails();
        collapseAllNodes();
        updateButtonText('展');
    } else {
        expandAllDetails();
        expandAllNodes();
        updateButtonText('收');
    }
}

// ========== 辅助函数 ==========
function checkIfAnyDetailsOpen() {
    const details = document.querySelectorAll('details');
    return Array.from(details).some(d => d.open);
}

function checkIfAnyNodesOpen() {
    const nodes = document.querySelectorAll('.node');
    return Array.from(nodes).some(node => {
        const hasExpandableContent = node.querySelector('.children, .note, .image-list, .image-item, .cloze') !== null;
        return hasExpandableContent && node.classList.contains('expanded');
    });
}

function updateButtonText(text) {
    var button = document.querySelector('.toggleOutlineBothbtn');
    if (button) {
        const textSpan = button.querySelector('.popup-badge-text');
        if (textSpan) {
            textSpan.textContent = text;
        }
    }
}
</script>

<script>
// ========== 1.自动将标题转换为details ==========
function convertTitlesToDetails() {
    const areaElements = document.querySelectorAll('.area');
    
    if (areaElements.length === 0) {
        convertTitlesInElementToDetails(document.body);
        return;
    }
    
    areaElements.forEach(area => {
        convertTitlesInElementToDetails(area);
    });
}

function convertTitlesInElementToDetails(element) {
    let html = element.innerHTML;
    
    // 一次性收集所有标题和details标签
    const combinedRegex = /<(h[1-6])([^>]*)>([\s\S]*?)<\/\1>|<(\/?details[^>]*)>/gi;
    
    // 收集所有匹配的元素
    const allElements = [];
    let match;
    
    while ((match = combinedRegex.exec(html)) !== null) {
        if (match[1]) { // 这是标题元素
            allElements.push({
                type: 'heading',
                tag: match[1],
                content: match[3],
                level: parseInt(match[1].charAt(1)),
                start: match.index,
                end: match.index + match[0].length,
                html: match[0],
                nestedInDetails: false // h标记：初始为【NO】
            });
        } else if (match[4]) { // 这是details标签
            const isClosing = match[4].startsWith('/');
            allElements.push({
                type: 'details-tag',
                tag: 'details',
                isClosing: isClosing,
                start: match.index,
                end: match.index + match[0].length,
                html: match[0],
                interruptsHeading: false // details标记：初始为【NO】
            });
        }
    }
    
    if (allElements.length === 0) return;
    
    // ========== 标记嵌套关系 ==========
    
    // 标记1：<details>的后面是否紧跟着<h>
    for (let i = 0; i < allElements.length - 1; i++) {
        const current = allElements[i];
        const next = allElements[i + 1];
        
        if (current.type === 'details-tag' && !current.isClosing && 
            next.type === 'heading') {
            // <details>后面紧跟着<h>，把这个<details>标记为【YES】
            current.interruptsHeading = true; // 【YES】要替换
        }
    }
    
    // 标记2：<h>的前面是否紧跟着<details>
    for (let i = 1; i < allElements.length; i++) {
        const current = allElements[i];
        const prev = allElements[i - 1];
        
        if (current.type === 'heading' && 
            prev.type === 'details-tag' && !prev.isClosing) {
            // <h>前面紧跟着<details>，把这个<h>标记为【YES】
            current.nestedInDetails = true; // 【YES】n=0
        }
    }
    
    let resultHTML = html;
    
    // 获取所有标题（用于计算maxLevel）
    const headings = allElements.filter(el => el.type === 'heading');
    const maxLevel = headings.length > 0 ? Math.min(...headings.map(h => h.level)) : 0;
    
    // ========== 从后往前开始替换 ==========
    for (let i = allElements.length - 1; i >= 0; i--) {
        const current = allElements[i];
        
        if (current.type === 'heading') {
            // 碰到h，标记为YES的直接令n=0，标记为NO的按原逻辑替换
            
            // 找到当前标题之前的最近标题（用于计算n值）
            let previousHeading = null;
            for (let j = i - 1; j >= 0; j--) {
                if (allElements[j].type === 'heading') {
                    previousHeading = allElements[j];
                    break;
                }
            }
            
            let n = 0;
            
            // 标记为YES的直接令n=0
            if (current.nestedInDetails) {
                n = 0;
            } else if (!previousHeading) {
                n = 0;
            } else {
                const levelDiff = current.level - previousHeading.level;
                
                if (levelDiff < 0) {
                    n = Math.abs(levelDiff) + 1;
                } else if (levelDiff === 0) {
                    n = 1;
                } else {
                    n = 0;
                }
            }
            
            // 构建闭合标签
            let closeTags = '';
            for (let j = 0; j < n; j++) {
                closeTags += '</details>';
            }
            
            // 构建details结构
            const startReplacement = closeTags + '<details><summary>' + current.content + '</summary>';
            
            resultHTML = resultHTML.substring(0, current.start) + 
                       startReplacement + 
                       resultHTML.substring(current.end);
            
        } else if (current.type === 'details-tag') {
            if (!current.isClosing) {
                // 碰到details，标记为Yes的替换为</details><details>，标记为NO的不替换
                if (current.interruptsHeading) {
                    // 标记为YES：替换为</details><details>
                    const replacement = '</details><details>';
                    resultHTML = resultHTML.substring(0, current.start) + 
                               replacement + 
                               resultHTML.substring(current.end);
                }
                // 标记为NO：不替换
            }
            // </details>：完全不用处理
        }
    }
    
    // 文档末尾闭合
    if (headings.length > 0) {
        const lastHeading = headings[headings.length - 1];
        const levelDiff = lastHeading.level - maxLevel;
        const finalN = levelDiff + 1;
        
        let finalCloseTags = '';
        for (let i = 0; i < finalN; i++) {
            finalCloseTags += '</details>';
        }
        resultHTML += finalCloseTags;
    }
    
    element.innerHTML = resultHTML;
}

</script>

<!-- ==========（二） details批量控制 ========== -->
<script>

//展开所有details
function expandAllDetails() {
    document.querySelectorAll('details').forEach(detail => {
        detail.open = true;
    });
}

//折叠所有details
function collapseAllDetails() {
    document.querySelectorAll('details').forEach(detail => {
        detail.open = false;
    });
}

//切换所有details
function toggleAllDetails() {
    if (checkIfAnyDetailsOpen()) {
        collapseAllDetails();
        updateButtonText('展');
    } else {
        expandAllDetails();
        updateButtonText('收');
    }
}

</script>

<!-- ========== （三）node节点功能 ========== -->
<script>
// ========== 1.节点事件设置 ==========
function setupNodeEvents() {
    // 删除所有没有.content的<li class="node">
    document.querySelectorAll('li.node:not(:has(.content))').forEach(badNode => {
        // 把这个节点的所有内容移到父元素中
        const parent = badNode.parentNode;
        while (badNode.firstChild) {
            parent.insertBefore(badNode.firstChild, badNode);
        }
        // 删除空的<li>
        badNode.remove();
    });


    document.querySelectorAll('.node').forEach((node, index) => {
        const bullet = node.querySelector('.bullet');
        const bulletDot = bullet ? bullet.querySelector('.bullet-dot') : null;
        const contentDiv = node.querySelector('.content'); 
        
        // 检查是否有可展开的内容
        const hasExpandableContent = () => {
            // 检查是否有children元素
            const children = node.querySelector('.children');
            if (children && children.children.length > 0) return true;
            
            // 检查是否有note元素
            const note = node.querySelector('.note');
            if (note) return true;
            
            // 检查是否有image-list或image-item
            const imageList = node.querySelector('.image-list, .image-item');
            if (imageList) return true;
            
            // 检查是否有cloze
            const cloze = node.querySelector('.cloze');
            if (cloze) return true;
            
            return false;
        };
        
        const canExpand = hasExpandableContent();
        
        // 🔥 修复：如果没有bullet元素，为顶层节点创建或设置样式
        if (!bullet && contentDiv) {
            // 为顶层节点添加点击事件
            contentDiv.style.cursor = 'pointer';
            contentDiv.title = '点击展开/折叠';
        }
        
        // 如果没有bullet但有bulletDot，设置样式
        if (bulletDot) {
            if (!canExpand) {
                // 设置为不可点击的样式
                bulletDot.style.boxShadow = 'none';
                bulletDot.style.backgroundColor = 'transparent';
                bulletDot.style.border = '1px solid #ccc';
                return; // 跳过这个节点
            }
            
            // 检查是否有cloze元素
            const hasCloze = node.querySelector('.cloze') !== null;
            
            // 初始状态：有cloze就展开，否则折叠
            if (hasCloze) {
                node.classList.add('expanded');
                bulletDot.style.boxShadow = 'none';
                bulletDot.style.backgroundColor = 'rgb(100, 106, 115)';
            } else {
                node.classList.remove('expanded');
                bulletDot.style.boxShadow = '0 0 0 2px rgb(100, 106, 115), 0 0 0 4px rgb(200, 200, 200)';
                bulletDot.style.backgroundColor = 'transparent';
            }
        }
        
        // 点击事件函数
        function toggleNode(e) {
            e.stopPropagation();
            const isExpanded = node.classList.toggle('expanded');
            
            // 更新bullet样式
            if (bulletDot) {
                if (isExpanded) {
                    bulletDot.style.boxShadow = 'none';
                    bulletDot.style.backgroundColor = 'rgb(100, 106, 115)';
                } else {
                    bulletDot.style.boxShadow = '0 0 0 2px rgb(100, 106, 115), 0 0 0 4px rgb(200, 200, 200)';
                    bulletDot.style.backgroundColor = 'transparent';
                }
            }
        }
        
        // 添加点击事件
        if (contentDiv) { 
            contentDiv.style.cursor = 'pointer';
            contentDiv.onclick = toggleNode;
        }
        
        if (bullet) {
            bullet.onclick = toggleNode;
        }
    });
}

// ========== 2.节点批量控制 ==========

