<!-- ========== 零、主题设置========== -->
<script>
  /*
   * 存储模块：ankiStorage 设计模式
   * 提供统一的配置读写接口，localStorage 优先，window 对象回退（防止 localStorage 被禁用）
   * 配置项统一使用 'anki_cfg_' 前缀，与参考模板键名规范保持一致
   */
  window.ankiStorage = window.ankiStorage || (function () {
    var P = 'anki_cfg_'; /* 配置项键名前缀 */
    return {
      setConfig: function (k, v) {
        try { localStorage.setItem(P + k, JSON.stringify(v)); }
        catch (e) { window['_acfg_' + k] = v; }
      },
      getConfig: function (k) {
        try {
          var v = localStorage.getItem(P + k);
          return v !== null ? JSON.parse(v) : undefined;
        } catch (e) { return window['_acfg_' + k]; }
      }
    };
  })();

  /* 主题初始化 */
  (function () {
    var saved = (window.ankiStorage && window.ankiStorage.getConfig('cardTheme')) || '1';
    
    // 给 html 添加主题类
    var htmlEl = document.documentElement;
    htmlEl.classList.remove('theme-dousha', 'theme-zhulu', 'theme-xiangya', 'theme-danya', 'theme-dailv', 'theme-yase');
    if (saved === '1') htmlEl.classList.add('theme-dousha');
    else if (saved === '2') htmlEl.classList.add('theme-zhulu');
    else if (saved === '3') htmlEl.classList.add('theme-xiangya');
    else if (saved === '4') htmlEl.classList.add('theme-danya');
    else if (saved === '5') htmlEl.classList.add('theme-dailv');
    else htmlEl.classList.add('theme-yase');
    
    // 更新按钮文字和图标
    var btn = document.querySelector('.toggleThemebtn');
    if (btn) {
      var iconSpan = btn.querySelector('.popup-badge-icon');
      var textSpan = btn.querySelector('.popup-badge-text');
      
      if (saved === '1') {
        if (iconSpan) iconSpan.textContent = '🌿';
        if (textSpan) textSpan.textContent = '豆沙';
      } else if (saved === '2') {
        if (iconSpan) iconSpan.textContent = '🎋';
        if (textSpan) textSpan.textContent = '竹露';
      } else if (saved === '3') {
        if (iconSpan) iconSpan.textContent = '🦷';
        if (textSpan) textSpan.textContent = '象牙';
      } else if (saved === '4') {
        if (iconSpan) iconSpan.textContent = '🪶';
        if (textSpan) textSpan.textContent = '淡雅';
      } else if (saved === '5') {
        if (iconSpan) iconSpan.textContent = '🏔️';
        if (textSpan) textSpan.textContent = '黛绿';
      } else {
        if (iconSpan) iconSpan.textContent = '🌙';
        if (textSpan) textSpan.textContent = '牙色';
      }
    }
  })();

  /* 主题切换函数 */
  function toggleTheme() {
    var htmlEl = document.documentElement;
    
    var current = 'dousha';
    if (htmlEl.classList.contains('theme-zhulu')) current = 'zhulu';
    else if (htmlEl.classList.contains('theme-xiangya')) current = 'xiangya';
    else if (htmlEl.classList.contains('theme-danya')) current = 'danya';
    else if (htmlEl.classList.contains('theme-dailv')) current = 'dailv';
    else if (htmlEl.classList.contains('theme-yase')) current = 'yase';
    
    var next = '';
    if (current === 'dousha') next = 'zhulu';
    else if (current === 'zhulu') next = 'xiangya';
    else if (current === 'xiangya') next = 'danya';
    else if (current === 'danya') next = 'dailv';
    else if (current === 'dailv') next = 'yase';
    else next = 'dousha';
    
    htmlEl.classList.remove('theme-dousha', 'theme-zhulu', 'theme-xiangya', 'theme-danya', 'theme-dailv', 'theme-yase');
    htmlEl.classList.add('theme-' + next);
    
    var themeNum = next === 'dousha' ? '1' : (next === 'zhulu' ? '2' : (next === 'xiangya' ? '3' : (next === 'danya' ? '4' : (next === 'dailv' ? '5' : '6'))));
    if (window.ankiStorage) {
      window.ankiStorage.setConfig('cardTheme', themeNum);
    }
    
    // 更新按钮文字和图标
    var btn = document.querySelector('.toggleThemebtn');
    if (btn) {
      var iconSpan = btn.querySelector('.popup-badge-icon');
      var textSpan = btn.querySelector('.popup-badge-text');
      
      if (next === 'dousha') {
        if (iconSpan) iconSpan.textContent = '🌿';
        if (textSpan) textSpan.textContent = '豆沙';
      } else if (next === 'zhulu') {
        if (iconSpan) iconSpan.textContent = '🎋';
        if (textSpan) textSpan.textContent = '竹露';
      } else if (next === 'xiangya') {
        if (iconSpan) iconSpan.textContent = '🦷';
        if (textSpan) textSpan.textContent = '象牙';
      } else if (next === 'danya') {
        if (iconSpan) iconSpan.textContent = '🪶';
        if (textSpan) textSpan.textContent = '淡雅';
      } else if (next === 'dailv') {
        if (iconSpan) iconSpan.textContent = '🏔️';
        if (textSpan) textSpan.textContent = '黛绿';
      } else if (next === 'yase') {
        if (iconSpan) iconSpan.textContent = '🌙';
        if (textSpan) textSpan.textContent = '牙色';
      }
    }
  }
</script>

