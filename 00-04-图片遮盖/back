    //收集总体统计信息  
    function collectDetailedStatistics() {
    const ankiCloze = window.AnkiClozeInstance;
    
    if (!ankiCloze) {
        return {
            error: '图片系统未初始化',
            mainPage: { 
                images: 0, 
                wrapped: 0, 
                withData: 0,
                allImages: [],    // 所有图片
                wrappedImages: [] // 已包装图片
            },
            popup: { 
                images: 0, 
                wrapped: 0, 
                withData: 0,
                allImages: [],
                wrappedImages: []
            },
            noteMark: { 
                total: 0, 
                opened: 0, 
                notOpened: 0, 
                withData: 0, 
                wrapped: 0,
                allImages: [],    // 所有NoteMark图片
                wrappedImages: [] // 已包装图片
            },
            total: { 
                images: 0, 
                wrapped: 0, 
                withData: 0 
            }
        };
    }
    
    const stats = {
        mainPage: {
            images: 0,
            wrapped: 0,
            withData: 0,
            allImages: [],
            wrappedImages: []
        },
        popup: {
            images: 0,
            wrapped: 0,
            withData: 0,
            allImages: [],
            wrappedImages: []
        },
        noteMark: {
            total: 0,
            opened: 0,
            notOpened: 0,
            withData: 0,
            wrapped: 0,
            allImages: [],
            wrappedImages: []
        },
        total: {
            images: 0,
            wrapped: 0,
            withData: 0
        }
    };
    
    // ==================== 1. 收集所有图片分类 ====================
    const allDomImages = document.querySelectorAll('img[data-cloze-id]');
    const domImageFilenames = new Set();
    
    // 用于记录每张图片的分类信息
    const imageCategories = new Map(); // filename -> category
    const imageWrappedStatus = new Map(); // filename -> wrapped status
    const imageDataStatus = new Map(); // filename -> has data
    
    // 先处理DOM中的所有图片
    allDomImages.forEach(img => {
        try {
            const src = img.src;
            const filename = src.split('/').pop() || src;
            domImageFilenames.add(filename);
            
            // 检查包装状态
            const wrapper = img.closest('.cloze-image-wrapper');
            const isWrapped = wrapper && wrapper.classList.contains('cloze-image-wrapper');
            
            // 检查数据状态
            const imgId = img.dataset.clozeId;
            let hasData = false;
            if (imgId) {
                const data = ankiCloze.getImageData(imgId);
                hasData = (data.masks && data.masks.length > 0) || 
                         (data.drawings && data.drawings.length > 0) ||
                         (data.note && data.note.trim() !== '');
            }
            
            // 判断分类
            const popupInfo = ankiCloze.isImageInPopup(wrapper || img.parentElement);
            const isInPopup = popupInfo.inPopup;
            
            // 记录分类信息
            imageCategories.set(filename, isInPopup ? 'popup' : 'mainPage');
            imageWrappedStatus.set(filename, isWrapped);
            imageDataStatus.set(filename, hasData);
            
            // 创建图片信息对象
            const imageInfo = {
                id: imgId,
                filename: filename,
                src: src,
                alt: img.alt || '',
                wrapped: isWrapped,
                hasData: hasData,
                category: isInPopup ? 'popup' : 'mainPage'
            };
            
            // 统计主页面和Popup图片（非NoteMark图片）
            if (isInPopup) {
                stats.popup.images++;
                stats.popup.allImages.push(imageInfo);
                if (isWrapped) {
                    stats.popup.wrapped++;
                    stats.popup.wrappedImages.push(imageInfo);
                }
                if (hasData) stats.popup.withData++;
            } else {
                stats.mainPage.images++;
                stats.mainPage.allImages.push(imageInfo);
                if (isWrapped) {
                    stats.mainPage.wrapped++;
                    stats.mainPage.wrappedImages.push(imageInfo);
                }
                if (hasData) stats.mainPage.withData++;
            }
            
        } catch (error) {
            console.error('统计DOM图片时出错:', error);
        }
    });
    
    // ==================== 2. 统计笔记标记图片 ====================
    const noteMarkFilenames = new Set();
    
    if (window.NoteMarkSystem && window.NoteMarkSystem.categorizedMarks) {
        try {
            if (window.NoteMarkSystem.refreshMarkCategorization) {
                window.NoteMarkSystem.refreshMarkCategorization();
            }
            
            const { currentCardMarks } = window.NoteMarkSystem.categorizedMarks;
            
            currentCardMarks.forEach(mark => {
                if (mark.type === 'note' && mark.note) {
                    const imgRegex = /<img[^>]+src="([^">]+)"[^>]*>/g;
                    const noteContent = mark.note;
                    let match;
                    
                    while ((match = imgRegex.exec(noteContent)) !== null) {
                        const src = match[1];
                        if (!src) continue;
                        
                        const filename = src.split('/').pop() || src;
                        noteMarkFilenames.add(filename);
                        
                        // 创建NoteMark图片信息
                        const imageInfo = {
                            id: ankiCloze.imageIdMap?.get(filename),
                            filename: filename,
                            src: src,
                            alt: '',
                            wrapped: false,
                            hasData: false,
                            category: 'noteMark',
                            opened: false
                        };
                        
                        // 检查是否已打开
                        if (domImageFilenames.has(filename)) {
                            stats.noteMark.opened++;
                            imageInfo.opened = true;
                            
                            // 检查已打开图片的包装状态
                            const isWrapped = imageWrappedStatus.get(filename);
                            const hasData = imageDataStatus.get(filename);
                            
                            imageInfo.wrapped = isWrapped || false;
                            imageInfo.hasData = hasData || false;
                            
                            if (isWrapped) {
                                stats.noteMark.wrapped++;
                                stats.noteMark.wrappedImages.push(imageInfo);
                            }
                            if (hasData) stats.noteMark.withData++;
                            
                        } else {
                            stats.noteMark.notOpened++;
                        }
                        
                        stats.noteMark.allImages.push(imageInfo);
                        stats.noteMark.total++;
                    }
                }
            });
            
        } catch (error) {
            console.warn('统计笔记标记图片时出错:', error);
        }
    }
    
    // ==================== 3. 重新计算分类统计（剔除NoteMark图片） ====================
    // 重置主页面和Popup统计
    stats.mainPage.images = 0;
    stats.mainPage.wrapped = 0;
    stats.mainPage.withData = 0;
    stats.mainPage.allImages = [];
    stats.mainPage.wrappedImages = [];
    
    stats.popup.images = 0;
    stats.popup.wrapped = 0;
    stats.popup.withData = 0;
    stats.popup.allImages = [];
    stats.popup.wrappedImages = [];
    
    // 重新统计非NoteMark图片
    domImageFilenames.forEach(filename => {
        const category = imageCategories.get(filename);
        
        // 如果是笔记标记图片，跳过
        if (noteMarkFilenames.has(filename)) {
            return;
        }
        
        // 统计非笔记标记图片
        if (category === 'mainPage') {
            stats.mainPage.images++;
            const isWrapped = imageWrappedStatus.get(filename);
            const hasData = imageDataStatus.get(filename);
            
            const imageInfo = {
                id: ankiCloze.imageIdMap?.get(filename),
                filename: filename,
                src: '', // 可以从其他方式获取
                alt: '',
                wrapped: isWrapped || false,
                hasData: hasData || false,
                category: 'mainPage'
            };
            
            stats.mainPage.allImages.push(imageInfo);
            if (isWrapped) {
                stats.mainPage.wrapped++;
                stats.mainPage.wrappedImages.push(imageInfo);
            }
            if (hasData) stats.mainPage.withData++;
            
        } else if (category === 'popup') {
            stats.popup.images++;
            const isWrapped = imageWrappedStatus.get(filename);
            const hasData = imageDataStatus.get(filename);
            
            const imageInfo = {
                id: ankiCloze.imageIdMap?.get(filename),
                filename: filename,
                src: '',
                alt: '',
                wrapped: isWrapped || false,
                hasData: hasData || false,
                category: 'popup'
            };
            
            stats.popup.allImages.push(imageInfo);
            if (isWrapped) {
                stats.popup.wrapped++;
                stats.popup.wrappedImages.push(imageInfo);
            }
            if (hasData) stats.popup.withData++;
        }
    });
    
    // ==================== 4. 计算总体统计 ====================
    stats.total.images = stats.mainPage.images + stats.popup.images + stats.noteMark.total;
    stats.total.wrapped = stats.mainPage.wrapped + stats.popup.wrapped + stats.noteMark.wrapped;
    stats.total.withData = stats.mainPage.withData + stats.popup.withData + stats.noteMark.withData;
    
    return stats;
}


