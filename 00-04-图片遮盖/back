<!-- ==============================================
    Anki 笔记标记系统（文本系统）【搭配Anki卡片基本模板及Anki图片处理系统】
    功能：直接在复习界面添加标记及笔记【下划线标记会自动转化为填空】；
         双数据来源自由切换【本地+字段】
    注意：需要点击Cur按钮复制当前卡片数据并黏贴到NoteMarkData，
         才能借助anki字段同步机制实现设备间的同步
    ============================================ -->

<div id="NoteMarkData" style="display:none;">{{edit:NoteMarkData}}</div>

<script>
// ========== Anki笔记标记系统完整核心代码 ==========

'use strict';

if (window._NoteMarkSystemLoaded) {
    console.log('NoteMarkSystem 已加载');
    throw new Error('NoteMarkSystem 已加载');
}
window._NoteMarkSystemLoaded = true;

const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

function showMessage(text, type) {
    let message = document.getElementById('ankiMessage');
    if (!message) {
        message = document.createElement('div');
        message.id = 'ankiMessage';
        message.className = 'anki-message';
        document.body.appendChild(message);
    }
    
    // 重置状态
    message.style.display = 'block';
    message.style.opacity = '1';
    message.textContent = text;
    
    // 设置颜色
    const colors = {
        'error': '#f44336',
        'warning': '#ff9800',
        'success': '#4CAF50'
    };
    message.style.background = colors[type] || '#4CAF50';
    
    // 清除之前的定时器
    if (message._hideTimeout) {
        clearTimeout(message._hideTimeout);
        message._hideTimeout = null;
    }
    
    // 显示消息
    message.classList.add('popup-visible');
    
    // 设置新的隐藏定时器
    message._hideTimeout = setTimeout(() => {
        message.classList.remove('popup-visible');
        setTimeout(() => {
            message.style.display = 'none';
            message._hideTimeout = null;
        }, 300);
    }, 1500); // 显示1.5秒
}

function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}


class NoteMarkStorage {
    constructor() {
        this.STORAGE_KEY = 'notemark_system_data';
        this.CONFIG_KEY = 'notemark_system_config';
        this.CURRENT_SOURCE_KEY = 'notemark_current_data_source';
    }
    
    getAllNoteMarks() {
        try {
            const dataStr = localStorage.getItem(this.STORAGE_KEY);
            if (!dataStr) return [];
            const data = JSON.parse(dataStr);
            if (!data.NoteMarkData || !Array.isArray(data.NoteMarkData.notemarks)) return [];
            return data.NoteMarkData.notemarks;
        } catch (error) { return []; }
    }
    
    saveAllNoteMarks(notemarks) {
        try {
            const data = { NoteMarkData: { notemarks: notemarks } };
            localStorage.setItem(this.STORAGE_KEY, JSON.stringify(data));
            return true;
        } catch (error) { showMessage('保存数据失败', 'error'); return false; }
    }
    
    removeNoteMark(markId) {
        try {
            const notemarks = this.getAllNoteMarks();
            const filtered = notemarks.filter(mark => mark.id !== markId);
            return this.saveAllNoteMarks(filtered);
        } catch (error) { return false; }
    }
    
    clearAllNoteMarks() {
        try { localStorage.removeItem(this.STORAGE_KEY); return true; } catch (error) { return false; }
    }
    
    saveConfig(config) {
        try { localStorage.setItem(this.CONFIG_KEY, JSON.stringify(config)); return true; } catch (error) { return false; }
    }
    
    getConfig() {
        try {
            const configStr = localStorage.getItem(this.CONFIG_KEY);
            return configStr ? JSON.parse(configStr) : {};
        } catch (error) { return {}; }
    }
    
    getCurrentDataSource() {
        try {
            const source = localStorage.getItem(this.CURRENT_SOURCE_KEY);
            return source || 'NoteMark本地';
        } catch (error) { return 'NoteMark本地'; }
    }
    
    setCurrentDataSource(source) {
        try {
            if (source === 'NoteMark本地' || source === 'NoteMark字段') {
                localStorage.setItem(this.CURRENT_SOURCE_KEY, source);
                return true;
            }
            return false;
        } catch (error) { return false; }
    }
    
    clearDataSource() {
        try { localStorage.removeItem(this.CURRENT_SOURCE_KEY); return true; } catch (error) { return false; }
    }
}

class NoteMarkDataManager {
    constructor(storage) { this.storage = storage; }
    
    getNoteMarksBySource(source) {
        if (source === 'NoteMark字段') {
            return this.loadFromAnkiField() || [];
        } else {
            return this.storage.getAllNoteMarks();
        }
    }

    generateNoteMarkId(type) {
        const timestamp = Date.now();
        const random = Math.random().toString(36).substr(2, 9);
        const prefix = type === 'html-tag' ? 'html' : type === 'note' ? 'note' : type;
        return `${prefix}_${timestamp}_${random}`;
    }
    
    createNoteMarkData(selection, type, noteContent = '', htmlTag = '') {
        const id = this.generateNoteMarkId(type);
        const text = selection.toString().trim();
        if (!text) return null;
        const positionInfo = this.calculateTextPosition(selection, text);
        const markData = {
            id: id, type: type, text: text, timestamp: new Date().toISOString(),
            order: positionInfo.order, total: positionInfo.total
        };
        if (type === 'note') markData.note = noteContent || '';
        if (type === 'html-tag') markData.htmlTag = htmlTag || '';
        return markData;
    }
    
    calculateTextPosition(selection, text) {
        const fullText = document.body.textContent || '';
        let total = 0, pos = 0;
        while ((pos = fullText.indexOf(text, pos)) !== -1) { total++; pos += text.length; }
        if (total === 0) return { order: 1, total: 0 };
        const range = selection.getRangeAt(0);
        const startRange = document.createRange();
        startRange.selectNodeContents(document.body);
        startRange.setEnd(range.startContainer, range.startOffset);
        const charsBeforeSelection = startRange.toString().length;
        let order = 1, pos2 = 0, count = 0;
        while ((pos2 = fullText.indexOf(text, pos2)) !== -1) {
            count++;
            const start = pos2, end = pos2 + text.length;
            if (charsBeforeSelection >= start && charsBeforeSelection <= end) {
                order = count;
                break;
            }
            pos2 += text.length;
        }
        return { order: order, total: total };
    }
    
    prepareFieldExportData(system) {
        if (!system.categorizedMarks) return null;
        const currentCardMarks = system.categorizedMarks.currentCardMarks;
        if (currentCardMarks.length === 0) return null;
        const cleanMarks = currentCardMarks.map(mark => {
            const cleanMark = { ...mark };
            delete cleanMark._isRecoverable;
            delete cleanMark._restored;
            return cleanMark;
        });
        return { NoteMarkData: { notemarks: cleanMarks } };
    }
    
    categorizeMarksByRestoration(restorationResult) {
        const { currentCardMarks, otherCardMarks, restoredIds } = restorationResult;
        const finalCurrentCardMarks = [...currentCardMarks];
        const finalOtherCardMarks = [...otherCardMarks];
        const allMarks = [...currentCardMarks, ...otherCardMarks];
        allMarks.forEach(mark => {
            if (mark._embedded === true && mark._sourceNoteId) {
                if (restoredIds.includes(mark._sourceNoteId)) {
                    const otherIndex = finalOtherCardMarks.findIndex(m => m.id === mark.id);
                    if (otherIndex !== -1) finalOtherCardMarks.splice(otherIndex, 1);
                    const currentIndex = finalCurrentCardMarks.findIndex(m => m.id === mark.id);
                    if (currentIndex === -1) finalCurrentCardMarks.push(mark);
                }
            }
        });
        return { currentCardMarks: finalCurrentCardMarks, otherCardMarks: finalOtherCardMarks };
    }
    
    countCategorizedMarks(categorizedMarks) {
        const { currentCardMarks, otherCardMarks } = categorizedMarks;
        const currentCounts = {}, otherCounts = {};
        currentCardMarks.forEach(mark => { currentCounts[mark.type] = (currentCounts[mark.type] || 0) + 1; });
        otherCardMarks.forEach(mark => { otherCounts[mark.type] = (otherCounts[mark.type] || 0) + 1; });
        return {
            current: { total: currentCardMarks.length, byType: currentCounts },
            other: { total: otherCardMarks.length, byType: otherCounts },
            total: currentCardMarks.length + otherCardMarks.length
        };
    }
    
    importFromField(jsonString) {
        try {
            const importedData = JSON.parse(jsonString);
            if (!importedData.NoteMarkData || !Array.isArray(importedData.NoteMarkData.notemarks)) {
                showMessage('字段数据格式错误：缺少 NoteMarkData.notemarks', 'error');
                return false;
            }
            const importedNoteMarks = importedData.NoteMarkData.notemarks;
            const validNoteMarks = importedNoteMarks.filter(mark => mark && mark.id && mark.type && mark.text);
            if (validNoteMarks.length === 0) {
                showMessage('字段中没有有效的标记数据', 'error');
                return false;
            }
            const success = this.storage.saveAllNoteMarks(validNoteMarks);
            if (success) {
                showMessage(`从字段导入了 ${validNoteMarks.length} 个标记`, 'success');
                return true;
            } else {
                showMessage('保存导入数据失败', 'error');
                return false;
            }
        } catch (error) {
            showMessage(`解析字段数据失败: ${error.message}`, 'error');
            return false;
        }
    }
    
    removeDuplicates(noteMarks) {
        const seen = new Set();
        return noteMarks.filter(mark => {
            if (seen.has(mark.id)) return false;
            seen.add(mark.id);
            return true;
        });
    }
    
    loadFromAnkiField() {
        try {
            const field = document.getElementById('NoteMarkData');
            if (!field) return null;
            const content = field.textContent || '';
            if (!content.trim()) return null;
            const data = JSON.parse(content);
            return data.NoteMarkData?.notemarks || null;
        } catch (error) { return null; }
    }
}

class NoteMarkOperations {
    constructor(system) {
        this.system = system;
        this.selectedCurrentMarks = new Set();
        this.selectedOtherMarks = new Set();
    }
    
    handleCopyMarks(filterCondition, description) {
    // 使用当前数据源的数据
    const allMarks = this.system.dataManager.getNoteMarksBySource(this.system.currentDataSource);
    const marksToCopy = allMarks.filter(filterCondition);
    
    if (marksToCopy.length === 0) {
        showMessage(`没有${description}的标记`, 'warning');
        return;
    }
    
    let textToCopy = `【${description}】共 ${marksToCopy.length} 项\n\n`;
    marksToCopy.forEach(mark => {
        let prefix;
        if (mark.type === 'note') prefix = `【笔记】`;
        else if (mark.type === 'html-tag') prefix = `【<${mark.htmlTag}>标签】`;
        else prefix = `【${this.getTypeName(mark.type)}】`;
        
        textToCopy += `${prefix}${mark.text}\n`;
        if (mark.type === 'note' && mark.note) textToCopy += `  笔记：${mark.note}\n`;
        textToCopy += '\n';
    });
    
    this.copyToClipboard(textToCopy);
    showMessage(`已复制 ${marksToCopy.length} 个${description}标记`, 'success');
}
    
    handleDeleteMarks(filterCondition, description) {
    const allMarks = this.system.storage.getAllNoteMarks();
    const marksToDelete = allMarks.filter(filterCondition);
    
    if (marksToDelete.length === 0) {
        showMessage(`没有${description}的标记`, 'warning');
        return;
    }
    
    if (confirm(`确定要删除${description}的 ${marksToDelete.length} 个标记吗？`)) {
        
        // ===== 第1步：先处理嵌入式标记，更新源笔记 =====
        let updatedMarks = [...allMarks];
        const embeddedMarks = marksToDelete.filter(m => m._embedded === true);
        
        // 处理每个嵌入式标记，从源笔记的note字段中移除
        embeddedMarks.forEach(mark => {
            if (mark._sourceNoteId) {
                const sourceNoteIndex = updatedMarks.findIndex(m => m.id === mark._sourceNoteId);
                
                if (sourceNoteIndex !== -1) {
                    const sourceNote = { ...updatedMarks[sourceNoteIndex] };
                    
                    // 如果源笔记有 note 字段，从中移除这个嵌入式标记
                    if (sourceNote.note) {
                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = sourceNote.note;
                        
                        // 查找这个嵌入式标记对应的元素
                        const embeddedEl = tempDiv.querySelector(`[data-mark-id="${mark.id}"]`);
                        
                        if (embeddedEl) {
                            // 用纯文本替换嵌入式标记
                            const text = embeddedEl.textContent;
                            const textNode = document.createTextNode(text);
                            embeddedEl.parentNode.replaceChild(textNode, embeddedEl);
                            
                            // 更新源笔记的 note 字段
                            sourceNote.note = tempDiv.innerHTML;
                            
                            // 更新数组中的源笔记
                            updatedMarks[sourceNoteIndex] = sourceNote;
                        }
                    }
                }
            }
        });
        
        // ===== 第2步：保存更新后的源笔记（此时还不删除任何标记）=====
        this.system.storage.saveAllNoteMarks(updatedMarks);
        
        // ===== 第3步：从DOM中删除所有要删除的标记 =====
        marksToDelete.forEach(mark => {
            const markElement = document.querySelector(`[data-mark-id="${mark.id}"]`);
            if (markElement) {
                const originalText = markElement.textContent;
                const textNode = document.createTextNode(originalText);
                markElement.parentNode.replaceChild(textNode, markElement);
            }
        });
        
        // ===== 第4步：从存储中删除所有要删除的标记 =====
        // 重新获取最新的所有标记（因为第2步已经保存了更新后的源笔记）
        const currentMarks = this.system.storage.getAllNoteMarks();
        const remainingMarks = currentMarks.filter(mark => 
            !marksToDelete.some(m => m.id === mark.id)
        );
        this.system.storage.saveAllNoteMarks(remainingMarks);
        
        // ===== 第5步：更新选中状态 =====
        marksToDelete.forEach(mark => {
            this.selectedCurrentMarks.delete(mark.id);
            this.selectedOtherMarks.delete(mark.id);
        });
        
        // ===== 第6步：刷新分类数据 =====
        if (this.system.categorizedMarks) {
            marksToDelete.forEach(mark => {
                this.system.categorizedMarks.currentCardMarks = 
                    this.system.categorizedMarks.currentCardMarks.filter(m => m.id !== mark.id);
                this.system.categorizedMarks.otherCardMarks = 
                    this.system.categorizedMarks.otherCardMarks.filter(m => m.id !== mark.id);
            });
        }
        
        // ===== 第7步：刷新显示 =====
        this.refreshNotesDisplay();
        this.system.updatePanelToggle();
        this.updateBatchActions();
        
        showMessage(`已删除 ${marksToDelete.length} 个${description}标记`, 'success');
    }
}
    
    getRecoverableMarkIds() {
        if (!this.system.categorizedMarks) return new Set();
        return new Set(this.system.categorizedMarks.currentCardMarks.map(mark => mark.id));
    }
    
    getButtonContext(button) {
        const categoryHeader = button.closest('.anki-category-header');
        const isCurrentCard = document.getElementById('ankiCurrentNotesList')?.contains(categoryHeader);
        const recoverableMarkIds = this.getRecoverableMarkIds();
        return { isCurrentCard, recoverableMarkIds };
    }
    
    copyAllNotes() { this.handleCopyMarks(() => true, '所有'); }
    deleteAllNotes() { this.handleDeleteMarks(() => true, '所有'); }
    
    handleAreaOperation(area, isCopy = true) {
        const containerId = area === 'current' ? 'ankiCurrentNotesList' : 'ankiOtherNotesList';
        const container = document.getElementById(containerId);
        const noteItems = container?.querySelectorAll('.anki-note-item') || [];
        const markIds = Array.from(noteItems).map(item => item.getAttribute('data-note-id')).filter(id => id);
        if (markIds.length === 0) {
            const areaName = area === 'current' ? '当前卡片' : '非当前卡片';
            showMessage(`${areaName}没有标记`, 'warning');
            return;
        }
        const description = area === 'current' ? '当前卡片' : '非当前卡片';
        const filterCondition = mark => markIds.includes(mark.id);
        if (isCopy) this.handleCopyMarks(filterCondition, description);
        else this.handleDeleteMarks(filterCondition, description);
    }
    
    bindCategoryButtonsEvents() {
        document.querySelectorAll('.anki-category-copy').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const category = btn.getAttribute('data-category');
                this.handleCategoryOperation(btn, category, true);
            });
        });
        document.querySelectorAll('.anki-category-delete').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const category = btn.getAttribute('data-category');
                this.handleCategoryOperation(btn, category, false);
            });
        });
    }
    
    handleCategoryOperation(button, category, isCopy = true) {
        const categoryHeader = button.closest('.anki-category-header');
        const categoryItemsContainer = categoryHeader.nextElementSibling;
        if (!categoryItemsContainer || !categoryItemsContainer.classList.contains('anki-category-items')) return;
        const noteItems = categoryItemsContainer.querySelectorAll('.anki-note-item');
        if (noteItems.length === 0) {
            showMessage(`没有${this.getTypeName(category)}类型的标记`, 'warning');
            return;
        }
        const currentNotesList = document.getElementById('ankiCurrentNotesList');
        const otherNotesList = document.getElementById('ankiOtherNotesList');
        let areaName = '';
        if (currentNotesList && currentNotesList.contains(categoryHeader)) areaName = '当前卡片';
        else if (otherNotesList && otherNotesList.contains(categoryHeader)) areaName = '非当前卡片';
        const typeName = this.getTypeName(category);
        const description = `${areaName}${typeName}`;
        const markIds = Array.from(noteItems).map(item => item.getAttribute('data-note-id')).filter(id => id);
        if (isCopy) this.handleCopyMarks(mark => markIds.includes(mark.id), description);
        else this.handleDeleteMarks(mark => markIds.includes(mark.id), description);
    }
    
    copySingleNote(noteId) { this.handleCopyMarks(mark => mark.id === noteId, '单个'); }
    deleteSingleNote(noteId) { this.handleDeleteMarks(mark => mark.id === noteId, '单个'); }
    
    copySelected() {
        const selectedIds = [...this.selectedCurrentMarks, ...this.selectedOtherMarks];
        if (selectedIds.length === 0) {
            showMessage('请先选择要复制的标记', 'warning');
            return;
        }
        this.handleCopyMarks(mark => selectedIds.includes(mark.id), '选中的');
    }
    
    deleteSelected() {
        const selectedIds = [...this.selectedCurrentMarks, ...this.selectedOtherMarks];
        if (selectedIds.length === 0) {
            showMessage('请先选择要删除的标记', 'warning');
            return;
        }
        this.handleDeleteMarks(mark => selectedIds.includes(mark.id), '选中的');
    }

    refreshNotesDisplay(searchTerm = '') {
        this.system.refreshMarkCategorization();
        let filteredCurrent = this.system.categorizedMarks.currentCardMarks;
        let filteredOther = this.system.categorizedMarks.otherCardMarks;
        if (searchTerm.trim()) {
            const term = searchTerm.toLowerCase();
            filteredCurrent = filteredCurrent.filter(mark => 
                mark.text.toLowerCase().includes(term) ||
                (mark.type === 'note' && mark.note && mark.note.toLowerCase().includes(term))
            );
            filteredOther = filteredOther.filter(mark => 
                mark.text.toLowerCase().includes(term) ||
                (mark.type === 'note' && mark.note && mark.note.toLowerCase().includes(term))
            );
        }
        this.updateStats(filteredCurrent.length, filteredOther.length);
        this.renderCurrentNotesList(filteredCurrent);
        this.renderOtherNotesList(filteredOther);
        this.bindNoteItemsEvents();
        this.bindCategoryHeadersEvents();
        this.bindCategoryButtonsEvents();
        this.updateBatchActions();
    }
    
    updateStats(currentCount, otherCount) {
        const statsElement = document.getElementById('ankiDataStats');
        if (statsElement) statsElement.textContent = `(当前卡: ${currentCount} | 非当前卡: ${otherCount})`;
    }
    
    copyRecoverableToField() {
    // 直接从 restoreAndCategorizeMarks 获取原始数据
    const { currentCardMarks } = this.system.restoreAndCategorizeMarks();
    
    if (currentCardMarks.length === 0) {
        showMessage('当前卡片没有标记', 'warning');
        return;
    }
    
    const cleanMarks = currentCardMarks.map(mark => {
        const cleanMark = { ...mark };
        delete cleanMark._isRecoverable;
        delete cleanMark._restored;
        return cleanMark;
    });
    
    const exportData = { NoteMarkData: { notemarks: cleanMarks } };
    const jsonString = JSON.stringify(exportData);
    this.copyToClipboard(jsonString);
    
    showMessage(`✅ 已复制 ${currentCardMarks.length} 个当前卡标记`, 'success');
}
    
    copyAllToField() {
    // 1. 确保分类数据是最新的
    if (!this.system.categorizedMarks) {
        this.system.refreshMarkCategorization();
    }
    
    // 2. 获取所有标记（当前卡片 + 非当前卡片）
    const currentMarks = this.system.categorizedMarks?.currentCardMarks || [];
    const otherMarks = this.system.categorizedMarks?.otherCardMarks || [];
    const allMarks = [...currentMarks, ...otherMarks];
    
    if (allMarks.length === 0) {
        showMessage('没有标记', 'warning');
        return;
    }
    
    // 3. 清理内部属性
    const cleanMarks = allMarks.map(mark => {
        const cleanMark = { ...mark };
        delete cleanMark._isRecoverable;
        delete cleanMark._restored;
        return cleanMark;
    });
    
    // 4. 复制到剪贴板
    const exportData = { NoteMarkData: { notemarks: cleanMarks } };
    const jsonString = JSON.stringify(exportData);
    this.copyToClipboard(jsonString);
    
    showMessage(`✅ 已复制 ${allMarks.length} 个标记\n📊 当前卡: ${currentMarks.length}, 非当前卡: ${otherMarks.length}`, 'success');
}
    
    clearAllSelection() {
        this.selectedCurrentMarks.clear();
        this.selectedOtherMarks.clear();
        document.querySelectorAll('.anki-note-item-checkbox').forEach(checkbox => { checkbox.checked = false; });
        document.querySelectorAll('.anki-note-item').forEach(item => { item.classList.remove('selected'); });
        this.updateBatchActions();
        showMessage('已取消所有选择', 'success');
    }
    
    deleteAllUnrecoverable() {
        if (!this.system.categorizedMarks) {
            showMessage('没有分类数据', 'warning');
            return;
        }
        const unrecoverableMarks = this.system.categorizedMarks.otherCardMarks;
        if (unrecoverableMarks.length === 0) {
            showMessage('没有不可恢复的标记', 'warning');
            return;
        }
        if (confirm(`确定要删除所有 ${unrecoverableMarks.length} 个不可恢复标记吗？\n这些标记可能来自已删除的卡片或修改的文本。`)) {
            const recoverableMarks = this.system.categorizedMarks.currentCardMarks;
            this.system.storage.saveAllNoteMarks(recoverableMarks);
            this.selectedOtherMarks.clear();
            this.system.refreshMarkCategorization();
            this.refreshNotesDisplay();
            this.system.updatePanelToggle();
            showMessage(`已删除 ${unrecoverableMarks.length} 个不可恢复标记`, 'success');
        }
    }
    
    deleteAllRecoverable() {
        if (!this.system.categorizedMarks) {
            showMessage('没有分类数据', 'warning');
            return;
        }
        const recoverableMarks = this.system.categorizedMarks.currentCardMarks;
        if (recoverableMarks.length === 0) {
            showMessage('没有可恢复的标记', 'warning');
            return;
        }
        if (confirm(`确定要删除所有 ${recoverableMarks.length} 个可恢复标记吗？`)) {
            const unrecoverableMarks = this.system.categorizedMarks.otherCardMarks;
            this.system.storage.saveAllNoteMarks(unrecoverableMarks);
            recoverableMarks.forEach(mark => {
                const markElement = document.querySelector(`[data-mark-id="${mark.id}"]`);
                if (markElement) {
                    const originalText = markElement.textContent;
                    const textNode = document.createTextNode(originalText);
                    markElement.parentNode.replaceChild(textNode, markElement);
                }
            });
            this.selectedCurrentMarks.clear();
            this.system.refreshMarkCategorization();
            this.refreshNotesDisplay();
            this.system.updatePanelToggle();
            showMessage(`已删除 ${recoverableMarks.length} 个可恢复标记`, 'success');
        }
    }
    
