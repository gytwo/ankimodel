    // 电子书链接
    document.querySelectorAll('a[href*="clbr://"]').forEach(link => {
        link.style.cssText = 'cursor: pointer; color: #1890ff; text-decoration: underline;';
        link.addEventListener('click', handleClick);
    });
    
    // 🔥 页面加载时立即移动所有内容
    setTimeout(() => {
        moveAllContentToTooltipsOnLoad();
    }, 0);
    
    // 🔥 新增：定期清理孤立的tooltip
    setInterval(() => {
        document.querySelectorAll('.tooltip').forEach(tooltip => {
            if (!tooltip.classList.contains('show')) {
                // 检查tooltip是否孤立（没有对应的点击元素）
                const tooltipId = tooltip.id;
                if (tooltipId && !document.querySelector(`[data-tooltip-id="${tooltipId}"]`)) {
                    if (tooltip._cleanup) {
