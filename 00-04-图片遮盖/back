        if (actionIcons) {
            actionIcons.remove();
        }
        maskElement.dataset.hasControls = 'false';
    },
    
    addMaskActionIcons(maskElement) {
    const actionIcons = document.createElement('div');
    actionIcons.className = 'mask-action-icons';
    
    // 删除按钮
    const deleteBtn = document.createElement('button');
    deleteBtn.className = 'mask-action-btn delete';
    deleteBtn.innerHTML = '🗑️';
    deleteBtn.style.pointerEvents = 'auto'; // 确保可点击
    // ✅ 修复：同时绑定点击和触摸事件
    const handleDelete = (e) => {
        e.preventDefault();
        e.stopPropagation();
        this.deleteSelectedMask();
        return false;
    };
    
    // PC端：点击事件
    deleteBtn.addEventListener('click', handleDelete);
    
    // 移动端：触摸事件
