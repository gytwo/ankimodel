<script>
// ==================== 自然尺寸坐标转换系统 ====================
const CoordinateSystem = {
    pointsToNaturalRelative(points, naturalWidth, naturalHeight) {
        if (!points || !Array.isArray(points)) return [];
        return points.map(point => {
            if (!Array.isArray(point) || point.length < 2) return point;
            const relX = (point[0] / naturalWidth) * 100;
            const relY = (point[1] / naturalHeight) * 100;
            return [relX, relY];
        });
    },
    
    naturalRelativeToPoints(relPoints, naturalWidth, naturalHeight) {
        if (!relPoints || !Array.isArray(relPoints)) return [];
        return relPoints.map(point => {
            if (!Array.isArray(point) || point.length < 2) return point;
            const x = (point[0] / 100) * naturalWidth;
            const y = (point[1] / 100) * naturalHeight;
            return [x, y];
        });
    },
    
    absoluteToDisplay(x, y, naturalWidth, naturalHeight, displayWidth, displayHeight) {
        const scaleX = displayWidth / naturalWidth;
        const scaleY = displayHeight / naturalHeight;
        return {
            x: x * scaleX,
            y: y * scaleY,
            scaleX: scaleX,
            scaleY: scaleY
        };
    },
    
    displayToAbsolute(x, y, naturalWidth, naturalHeight, displayWidth, displayHeight) {
        const scaleX = displayWidth / naturalWidth;
        const scaleY = displayHeight / naturalHeight;
        return {
            x: x / scaleX,
            y: y / scaleY
        };
    }
};

// ==================== 响应式渲染器 ====================
class ResponsiveRenderer {
    constructor(ankiCloze) {
        this.ankiCloze = ankiCloze;
        this.resizeObservers = new Map();
        this.debounceTimer = null;
        this.isResizing = false;
    }
    
    setupResizeObserver(wrapper, imgId) {
        if (this.resizeObservers.has(imgId)) {
            this.resizeObservers.get(imgId).disconnect();
        }
        
        if (typeof ResizeObserver === 'undefined') {
            this.setupFallbackResizeListener(wrapper, imgId);
            return;
        }
        
        const observer = new ResizeObserver((entries) => {
            if (this.isResizing) return;
            clearTimeout(this.debounceTimer);
            this.debounceTimer = setTimeout(() => {
                this.handleResize(imgId, entries[0]);
            }, 150);
        });
        observer.observe(wrapper);
        this.resizeObservers.set(imgId, observer);
        
        const popupInfo = this.ankiCloze.isImageInPopup(wrapper);
        if (popupInfo.inPopup && popupInfo.popup) {
            const popupObserver = new ResizeObserver(() => {
                if (window.AnkiClozeInstance) {
                    window.AnkiClozeInstance.redrawImage(imgId);
                    window.AnkiClozeInstance.redrawCanvas(imgId);
                }
            });
            
            popupObserver.observe(popupInfo.popup);
            this.resizeObservers.set(`popup-${imgId}`, popupObserver);
        }
    }
    
    setupFallbackResizeListener(wrapper, imgId) {
        const handleResize = () => {
            if (!this.ankiCloze.activeImage || this.ankiCloze.activeImage !== imgId) {
                return;
            }
            clearTimeout(this.debounceTimer);
            this.debounceTimer = setTimeout(() => {
                const wrapperRect = wrapper.getBoundingClientRect();
                this.handleResize(imgId, { contentRect: wrapperRect });
            }, 200);
        };
        window.addEventListener('resize', handleResize);
        this.resizeObservers.set(imgId, {
            disconnect: () => {
                window.removeEventListener('resize', handleResize);
            }
        });
    }
    
    handleResize(imgId, entry) {
        if (!this.ankiCloze.activeImage || this.ankiCloze.activeImage !== imgId) {
            return;
        }
        this.isResizing = true;
        const newWidth = entry.contentRect.width;
        const newHeight = entry.contentRect.height;
        this.redrawAllForNewSize(imgId, newWidth, newHeight);
        setTimeout(() => {
            this.isResizing = false;
        }, 50);
    }
    
    redrawAllForNewSize(imgId, displayWidth, displayHeight) {
        const data = this.ankiCloze.getImageData(imgId);
        if (!data) return;
        
        const wrapper = this.ankiCloze.getWrapperByImgId(imgId);
        if (!wrapper) return;
        
        const img = wrapper.querySelector('img');
        const naturalWidth = img?.naturalWidth || displayWidth;
        const naturalHeight = img?.naturalHeight || displayHeight;
        
        if (data.masks && data.masks.length > 0) {
            data.masks.forEach(maskData => {
                if (maskData.x !== undefined && maskData.y !== undefined) {
                    const displayPos = CoordinateSystem.absoluteToDisplay(
                        (maskData.x / 100) * naturalWidth,
                        (maskData.y / 100) * naturalHeight,
                        naturalWidth,
                        naturalHeight,
                        displayWidth,
                        displayHeight
                    );
                    maskData._displayX = displayPos.x;
                    maskData._displayY = displayPos.y;
                    maskData._displayWidth = (maskData.width / 100) * naturalWidth * displayPos.scaleX;
                    maskData._displayHeight = (maskData.height / 100) * naturalHeight * displayPos.scaleY;
                }
            });
            this.ankiCloze.redrawImage(imgId);
        }
        
        if (data.drawings && data.drawings.length > 0) {
            this.ankiCloze.redrawCanvas(imgId);
        }
    }
    
    forceRedraw(imgId) {
        const wrapper = document.querySelector(`img[data-cloze-id="${imgId}"]`)?.parentElement;
        if (!wrapper) return;
        const wrapperRect = wrapper.getBoundingClientRect();
        this.redrawAllForNewSize(imgId, wrapperRect.width, wrapperRect.height);
    }
    
    cleanup() {
        this.resizeObservers.forEach(observer => observer.disconnect());
        this.resizeObservers.clear();
        clearTimeout(this.debounceTimer);
    }
    
    cleanupForImage(imgId) {
        const observer = this.resizeObservers.get(imgId);
        if (observer) {
            observer.disconnect();
            this.resizeObservers.delete(imgId);
        }
    }
};

// ==================== 本地存储管理器 ====================
class LocalStorageManager {
    constructor() {
        this.prefix = 'anki-cloze-';
    }
    
    getLocalStorageKey(fieldName) {
        return `${this.prefix}${fieldName}`;
    }
    
    loadFromLocalStorage(fieldName) {
        try {
            const key = this.getLocalStorageKey(fieldName);
            const storedData = localStorage.getItem(key);
            if (!storedData) {
                return null;
            }
            const parsed = JSON.parse(storedData);
            return parsed;
        } catch (error) {
            return null;
        }
    }
    
    clearLocalStorage(fieldName) {
        try {
            const key = this.getLocalStorageKey(fieldName);
            localStorage.removeItem(key);
            return true;
        } catch (error) {
            return false;
        }
    }
    
    getAllLocalKeys() {
        const keys = [];
        for (let i = 0; i < localStorage.length; i++) {
            const key = localStorage.key(i);
            if (key.startsWith(this.prefix)) {
                keys.push(key);
            }
        }
        return keys;
    }
    
    getStorageStats() {
        const keys = this.getAllLocalKeys();
        let totalSize = 0;
        keys.forEach(key => {
            try {
                const data = localStorage.getItem(key);
                totalSize += data ? data.length : 0;
            } catch (e) {}
        });
        return {
            keys: keys.length,
            totalSize: totalSize,
            totalSizeKB: (totalSize / 1024).toFixed(2)
        };
    }
};

// ==================== 双层存储系统 ====================
class DualLayerStorage {
    constructor() {
        this.config = {
            fieldName: 'ImageClozeData'
        };
        
        this.storageField = document.getElementById('ImageClozeData');
        this.localStorage = new LocalStorageManager();
        
        this.currentImageDataSource = localStorage.getItem('anki-cloze-data-source') || 'local';
        // 移除：this.hasUnsavedChanges = false;
    }
    
    getFieldData() {
        try {
            const content = this.storageField.textContent || '';
            if (!content.trim()) {
                return {};
            }
            return JSON.parse(content);
        } catch (error) {
            return {};
        }
    }
    
    getAllData() {
        if (this.currentImageDataSource === 'field') {
            return this.getFieldData();
        } else {
            return this.localStorage.loadFromLocalStorage(this.config.fieldName) || {};
        }
    }
    
    getImageData(imgId) {
        const allData = this.getAllData();
        const data = allData[imgId];
        
        if (data) {
            return {
                data: allData[imgId],
                source: this.currentImageDataSource
            };
        }
        return { data: null, source: 'none' };
    }
    
    saveImageData(imgId, imageData) {
        try {
            // 获取所有数据
            let allData = this.getAllData();
            if (!allData) {
                allData = {};
            }
            
            // 判断是否为空数据
            const hasMasks = imageData.masks && imageData.masks.length > 0;
            const hasDrawings = imageData.drawings && imageData.drawings.length > 0;
            const hasNote = imageData.note && imageData.note.trim() !== '';
            
            const shouldDelete = !hasMasks && !hasDrawings && !hasNote;
            
            if (shouldDelete) {
                // 删除空数据
                if (allData[imgId]) {
                    delete allData[imgId];
                    this.showNotification('空数据已删除', 'info');
                }
            } else {
                // 保存非空数据
                allData[imgId] = imageData;
            }
            
            // 直接操作 localStorage
            const key = `anki-cloze-${this.config.fieldName}`;
            const jsonData = JSON.stringify(allData);
            localStorage.setItem(key, jsonData);
            
            return { success: true, message: '保存成功' };
            
        } catch (error) {
            return { success: false, message: error.message };
        }
    }
    
    setImageDataSource(source) {
        if (source === 'local' || source === 'field') {
            if (this.currentImageDataSource === source) {
                return { success: true, changed: false };
            }
            
            const oldSource = this.currentImageDataSource;
            this.currentImageDataSource = source;
            localStorage.setItem('anki-cloze-data-source', source);
            
            return {
                success: true,
                changed: true,
                oldSource: oldSource,
                newSource: source
            };
        }
        return { success: false, changed: false };
    }
    
    getImageDataSourceInfo() {
        const isLocal = this.currentImageDataSource === 'local';
        return {
            current: this.currentImageDataSource,
            displayName: isLocal ? 'ImageCloze本地' : 'ImageCloze字段',
            isLocal: isLocal,
            isField: !isLocal
        };
    }
    
    copyToClipboard(dataType = 'current') {
        try {
            let dataToCopy;
            
            if (dataType === 'current') {
                const allData = this.getAllData();
                const currentPageImageIds = this.getCurrentPageImageIds();
                const filteredData = {};
                
                currentPageImageIds.forEach(imgId => {
                    if (allData[imgId]) {
                        filteredData[imgId] = allData[imgId];
                    }
                });
                
                dataToCopy = filteredData;
            } else {
                dataToCopy = this.getAllData();
            }
            
            const jsonString = JSON.stringify(dataToCopy);
            
            const textarea = document.createElement('textarea');
            textarea.value = jsonString;
            textarea.style.position = 'fixed';
            textarea.style.left = '-9999px';
            textarea.style.top = '-9999px';
            textarea.style.opacity = '0';
            textarea.setAttribute('readonly', '');
            document.body.appendChild(textarea);
            
            try {
                textarea.select();
                textarea.setSelectionRange(0, 99999);
                const successful = document.execCommand('copy');
                if (!successful && navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(jsonString);
                }
                
                const imageCount = Object.keys(dataToCopy).length;
                let maskCount = 0;
                let drawingCount = 0;
                
                Object.values(dataToCopy).forEach(imgData => {
                    maskCount += (imgData.masks && imgData.masks.length) || 0;
                    drawingCount += (imgData.drawings && imgData.drawings.length) || 0;
                });
                
                return {
                    success: true,
                    imageCount: imageCount,
                    maskCount: maskCount,
                    drawingCount: drawingCount,
                    size: jsonString.length,
                    dataType: dataType
                };
            } finally {
                document.body.removeChild(textarea);
            }
        } catch (error) {
            return {
                success: false,
                error: error.message
            };
        }
    }
    
    getCurrentPageImageIds() {
    const currentPageImageIds = new Set();
    
    // ✅ 1. 先刷新笔记标记分类（确保笔记数据最新）
    if (window.NoteMarkSystem && window.NoteMarkSystem.refreshMarkCategorization) {
        try {
            window.NoteMarkSystem.refreshMarkCategorization();
        } catch (error) {
            console.warn('刷新笔记标记分类时出错:', error);
        }
    }
    
    // ✅ 2. 获取当前数据源的所有数据（getAllData() 已区分数据来源）
    const allData = this.getAllData();
    
    // ✅ 3. 找出所有有数据的图片ID
    const dataImageIds = new Set();
    Object.keys(allData).forEach(imgId => {
        if (!imgId.startsWith('img-')) return;
        
        const imgData = allData[imgId];
        if (!imgData) return;
        
        const hasMasks = imgData.masks && imgData.masks.length > 0;
        const hasDrawings = imgData.drawings && imgData.drawings.length > 0;
        const hasNote = imgData.note && imgData.note.trim() !== '';
        
        if (hasMasks || hasDrawings || hasNote) {
            dataImageIds.add(imgId);
        }
    });
    
    // ✅ 4. 获取本地所有已包装的图片ID
    const localWrappedImageIds = new Set();
    const domWrappedImages = document.querySelectorAll('.cloze-image-wrapper img[data-cloze-id]');
    domWrappedImages.forEach(img => {
        const imgId = img.dataset.clozeId;
        if (imgId) {
            localWrappedImageIds.add(imgId);
        }
    });
    
    // ✅ 5. 核心逻辑：有数据 且 有包装器 → 属于当前卡片
    dataImageIds.forEach(imgId => {
        if (localWrappedImageIds.has(imgId)) {
            currentPageImageIds.add(imgId);
        }
    });
    
    // ✅ 6. 单独处理笔记标记中的图片
    if (window.NoteMarkSystem && window.NoteMarkSystem.categorizedMarks) {
        const { currentCardMarks } = window.NoteMarkSystem.categorizedMarks;
        
        currentCardMarks.forEach(mark => {
            if (mark.type === 'note' && mark.note) {
                const imgRegex = /<img[^>]+src="([^">]+)"[^>]*>/g;
                const noteContent = mark.note;
                let match;
                
                while ((match = imgRegex.exec(noteContent)) !== null) {
                    const src = match[1];
                    if (!src) continue;
                    
                    const filename = src.split('/').pop() || src;
                    
                    // 生成或获取图片ID
                    let imgId = null;
                    if (window.AnkiClozeInstance && window.AnkiClozeInstance.imageIdMap) {
                        imgId = window.AnkiClozeInstance.imageIdMap.get(filename);
                    }
                    
                    if (!imgId && window.AnkiClozeInstance) {
                        imgId = window.AnkiClozeInstance.generateStableImageId({ src: src });
                    }
                    
                    if (imgId) {
                        // ✅ 笔记标记属于当前卡片，且图片本地没有包装器
                        if (!localWrappedImageIds.has(imgId)) {
                            // 如果已经通过第5步加入（有数据且有包装器），则不再重复加入
                            if (!currentPageImageIds.has(imgId)) {
                                currentPageImageIds.add(imgId);
                            }
                        } else {
                            // 如果有包装器，已经在第5步处理过了
                            // 不需要重复处理
                        }
                    }
                }
            }
        });
    }
    
    return currentPageImageIds;
}



    getImageCountByCard(data = null, imageIdMap = null) {
        const sourceData = data || this.getAllData();
        const currentPageImageIds = this.getCurrentPageImageIds();
        
        let currentCardCount = 0;
        let otherCardCount = 0;
        let currentCardMasks = 0;
        let currentCardDrawings = 0;
        let otherCardMasks = 0;
        let otherCardDrawings = 0;
        
        const currentCardImages = [];
        const otherCardImages = [];
        
        Object.keys(sourceData).forEach(imgId => {
            if (!imgId.startsWith('img-')) return;
            
            const imgData = sourceData[imgId];
            const masks = (imgData.masks && imgData.masks.length) || 0;
            const drawings = (imgData.drawings && imgData.drawings.length) || 0;
            const note = imgData.note || '';
            
            // ✅ 只要有遮罩、涂鸦或备注，就显示在列表中
            if (masks > 0 || drawings > 0 || note) {
                // ✅ 获取图片名称
                let imageName = '';
                
                // 安全的从 imageIdMap 获取图片名称
                if (imageIdMap && typeof imageIdMap === 'object' && typeof imageIdMap.get === 'function') {
                    // 反向查找：通过ID找文件名
                    for (let [filename, id] of imageIdMap.entries()) {
                        if (id === imgId) {
                            imageName = filename;
                            break;
                        }
                    }
                }
                
                // 如果没找到，使用 imgId 作为图片名称
                if (!imageName) {
                    imageName = imgId.replace('img-', '');
                }
                
                const imageItem = {
                    id: imgId,
                    masks: masks,
                    drawings: drawings,
                    note: note,
                    imageName: imageName
                };
                
                if (currentPageImageIds.has(imgId)) {
                    currentCardCount++;
                    currentCardMasks += masks;
                    currentCardDrawings += drawings;
                    currentCardImages.push(imageItem);
                } else {
                    otherCardCount++;
                    otherCardMasks += masks;
                    otherCardDrawings += drawings;
                    otherCardImages.push(imageItem);
                }
            }
        });
        
        return {
            currentCard: currentCardCount,
            otherCard: otherCardCount,
            total: currentCardCount + otherCardCount,
            currentCardMasks: currentCardMasks,
            currentCardDrawings: currentCardDrawings,
            otherCardMasks: otherCardMasks,
            otherCardDrawings: otherCardDrawings,
            totalMasks: currentCardMasks + otherCardMasks,
            totalDrawings: currentCardDrawings + otherCardDrawings,
            currentCardImages: currentCardImages,
            otherCardImages: otherCardImages
        };
    }


    clearAllData() {
        try {
            const allData = this.getAllData();
            const imageCount = Object.keys(allData).filter(k => k.startsWith('img-')).length;
            
            if (imageCount === 0) {
                this.showNotification('没有数据可清除', 'info');
                return false;
            }
            
            let totalMasks = 0;
            let totalDrawings = 0;
            
            Object.values(allData).forEach(imgData => {
                totalMasks += (imgData.masks && imgData.masks.length) || 0;
                totalDrawings += (imgData.drawings && imgData.drawings.length) || 0;
            });
            
            const confirmationMessage = `确定要清除所有卡片的所有图片数据吗？\n\n` +
                `📊 将清除：\n` +
                `•所有卡片共 ${imageCount} 张图片有编辑数据\n` +
                `•包含 ${totalMasks} 个遮罩，${totalDrawings} 个涂鸦\n\n` +
                `⚠️ 此操作无法撤销！`;
            
            if (!confirm(confirmationMessage)) {
                return false;
            }

            // ✅ 先清空所有渲染
            document.querySelectorAll('.cloze-mask-layer').forEach(layer => {
                layer.innerHTML = '';
            });
            
            document.querySelectorAll('.cloze-drawing-layer').forEach(canvas => {
                if (canvas.getContext) {
                    canvas.getContext('2d').clearRect(0, 0, canvas.width, canvas.height);
                }
            });
            
            // 直接保存空对象
            const key = `anki-cloze-${this.config.fieldName}`;
            localStorage.setItem(key, '{}');
            
            // 清除撤销历史
            if (window.AnkiClozeInstance) {
                window.AnkiClozeInstance.maskHistory.clear();
                window.AnkiClozeInstance.drawHistory.clear();
            }
            
            this.showNotification(`已清除所有数据（${imageCount} 张图片）`, 'success');
            return true;
            
        } catch (error) {
            this.showNotification(`清除失败: ${error.message}`, 'error');
            return false;
        }
    }
    
    getStorageStats() {
        const dataSourceInfo = this.getImageDataSourceInfo();
        const allData = this.getAllData();
        const imageCount = Object.keys(allData).filter(k => k.startsWith('img-')).length;
        const dataSize = JSON.stringify(allData).length;
        const localStats = this.localStorage.getStorageStats();
        
        let totalMasks = 0;
        let totalDrawings = 0;
        
        Object.values(allData).forEach(imgData => {
            totalMasks += (imgData.masks && imgData.masks.length) || 0;
            totalDrawings += (imgData.drawings && imgData.drawings.length) || 0;
        });
        
        return {
            dataSource: dataSourceInfo.current,
            dataSourceDisplay: dataSourceInfo.displayName,
            totalImages: imageCount,
            totalMasks: totalMasks,
            totalDrawings: totalDrawings,
            dataSize: dataSize,
            dataSizeKB: (dataSize / 1024).toFixed(2),
            localStorageStats: localStats
        };
    }
    
    showNotification(message, type) {
        if (window.AnkiClozeInstance && window.AnkiClozeInstance.showNotification) {
            window.AnkiClozeInstance.showNotification(message, type);
        } else {
            const notification = document.createElement('div');
            notification.textContent = message;
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: ${type === 'error' ? '#f44336' : type === 'warning' ? '#ff9800' : '#4CAF50'};
                color: white;
                padding: 12px 20px;
                border-radius: 4px;
                z-index: 10000;
                font-size: 14px;
                box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            `;
            document.body.appendChild(notification);
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.parentNode.removeChild(notification);
                }
            }, 3000);
        }
    }
};

// ==================== 主系统（无缓存架构） ====================
const AnkiCloze = {
    mode: 'review',
    currentTool: 'pen',
    currentLayer: 'drawing',
    storage: null,
    responsiveRenderer: null,
    settings: {
        maskColor: '#FFF9C4',
        drawColor: '#FF0000',
        penSize: 1,
        eraserSize: 30
    },
    activeImage: null,
    activeImageName: null,
    selectedMask: null,
    isDrawingMask: false,
    isMovingMask: false,
    isResizingMask: false,
    resizeDirection: null,
    maskPreview: null,
    dragStartX: 0,
    dragStartY: 0,
    eraserPreview: null,
    maskHistory: new Map(),
    drawHistory: new Map(),
    menuVisible: false,
    // 移除：systemActivated = false,
    firstTimeUse: true,
    tutorialShown: false,
    imageIdMap: new Map(),
    
    // ==================== 数据访问方法 ====================
    
    getImageData(imgId) {
        if (!this.storage) return null;
        const result = this.storage.getImageData(imgId);
        const data = result.data || {};
        return {
            masks: Array.isArray(data.masks) ? data.masks : [],
            drawings: Array.isArray(data.drawings) ? data.drawings : [],
            note: typeof data.note === 'string' ? data.note : ''
        };
    },
    
    getCurrentImageData() {
        if (!this.activeImage) return { masks: [], drawings: [], note: '' };
        return this.getImageData(this.activeImage);
    },

    getMasks(imgId) {
        const data = this.getImageData(imgId);
        return data.masks || [];
    },

    getDrawings(imgId) {
        const data = this.getImageData(imgId);
        return data.drawings || [];
    },

    getNote(imgId) {
        const data = this.getImageData(imgId);
        return data.note || '';
    },
    
    saveImageData(imgId, imageData) {
        if (!this.storage) return false;
        
        // 格式化数据
        const formattedData = this.formatImageData(imageData);
        
        // 保存格式化后的数据
        const result = this.storage.saveImageData(imgId, formattedData);

        // 保存成功后刷新数据管理
        if (result.success && this.refreshDataManagement) {
            setTimeout(() => {
                this.refreshDataManagement();
            }, 100);
        }
        return result.success;
    },
    
    formatImageData(imageData) {
        const formatDecimal = (num) => {
            if (typeof num !== 'number' || isNaN(num)) return 0;
            return Math.round(num * 100) / 100;
        };
        
        return {
            masks: imageData.masks ? imageData.masks.map(mask => ({
                id: mask.id,
                type: mask.type,
                x: formatDecimal(mask.x || 0),
                y: formatDecimal(mask.y || 0),
                width: formatDecimal(mask.width || 0),
                height: formatDecimal(mask.height || 0),
                color: mask.color
            })) : [],
            drawings: imageData.drawings ? imageData.drawings.map(drawing => ({
                type: drawing.type,
                color: drawing.color,
                size: drawing.size,
                points: drawing.points ?
                    drawing.points.map(point => [
                        formatDecimal(point[0]),
                        formatDecimal(point[1])
                    ]) : []
            })) : [],
            note: imageData.note || ''
        };
    },
    
    // ==================== 撤销历史管理 ====================
    
    saveMaskHistory(imgId, action, data = null) {
        const history = this.maskHistory.get(imgId) || [];
        history.push({ action, data, timestamp: Date.now() });
        if (history.length > 10) {
            history.shift();
        }
        this.maskHistory.set(imgId, history);
    },
    
    saveDrawHistory(imgId, action, data = null) {
        const history = this.drawHistory.get(imgId) || [];
        history.push({ action, data, timestamp: Date.now() });
        if (history.length > 10) {
            history.shift();
        }
        this.drawHistory.set(imgId, history);
    },
    
    undoMaskAction() {
        if (!this.activeImage) {
            this.showNotification('请先单击图片以激活图片处理工具', 'warning');
            return;
        }
        
        const history = this.maskHistory.get(this.activeImage);
        if (!history || history.length === 0) {
            this.showNotification('没有可撤销的遮罩操作', 'info');
            return;
        }
        
        const lastAction = history.pop();
        const data = this.getCurrentImageData();
        
        switch(lastAction.action) {
            case 'add_mask':
                if (lastAction.data) {
                    const newMasks = data.masks.filter(mask => mask.id !== lastAction.data.id);
                    const newData = {
                        masks: newMasks,
                        drawings: data.drawings || [],
                        note: data.note || ''
                    };
                    
                    this.saveImageData(this.activeImage, newData);
                    this.redrawImage(this.activeImage);
                    this.showNotification('遮罩操作已撤销', 'success');
                }
                break;
                
            case 'clear_masks':
                if (lastAction.data && lastAction.data.masks) {
                    const newData = {
                        masks: lastAction.data.masks,
                        drawings: data.drawings || [],
                        note: data.note || ''
                    };
                    
                    this.saveImageData(this.activeImage, newData);
                    this.redrawImage(this.activeImage);
                    this.showNotification('已恢复遮罩', 'success');
                }
                break;
                
            case 'delete_mask':
                if (lastAction.data && lastAction.data.mask) {
                    const newMasks = [...(data.masks || []), lastAction.data.mask];
                    const newData = {
                        masks: newMasks,
                        drawings: data.drawings || [],
                        note: data.note || ''
                    };
                    
                    this.saveImageData(this.activeImage, newData);
                    this.redrawImage(this.activeImage);
                    this.showNotification('已恢复遮罩', 'success');
                }
                break;
                
            case 'update_masks':
                if (lastAction.data && lastAction.data.oldMasks) {
                    const newData = {
                        masks: lastAction.data.oldMasks,
                        drawings: data.drawings || [],
                        note: data.note || ''
                    };
                    
                    this.saveImageData(this.activeImage, newData);
                    this.redrawImage(this.activeImage);
                    this.showNotification('遮罩状态已恢复', 'success');
                }
                break;
        }
    },
    
    undoDrawAction() {
        if (!this.activeImage) {
            this.showNotification('请先单击图片以激活图片处理工具', 'warning');
            return;
        }
        
        const history = this.drawHistory.get(this.activeImage);
        if (!history || history.length === 0) {
            this.showNotification('没有可撤销的涂鸦操作', 'info');
            return;
        }
        
        const lastAction = history.pop();
        const data = this.getCurrentImageData();
        
        switch(lastAction.action) {
            case 'add_drawing':
                if (data.drawings && data.drawings.length > 0) {
                    const newDrawings = data.drawings.slice(0, -1);
                    const newData = {
                        masks: data.masks || [],
                        drawings: newDrawings,
                        note: data.note || ''
                    };
                    
                    this.saveImageData(this.activeImage, newData);
                    this.redrawCanvas(this.activeImage);
                    this.showNotification('涂鸦操作已撤销', 'success');
                }
                break;
                
            case 'clear_drawings':
                if (lastAction.data && lastAction.data.drawings) {
                    const newData = {
                        masks: data.masks || [],
                        drawings: lastAction.data.drawings,
                        note: data.note || ''
                    };
                    
                    this.saveImageData(this.activeImage, newData);
                    this.redrawCanvas(this.activeImage);
                    this.showNotification('已恢复涂鸦', 'success');
                }
                break;
                
            case 'update_drawings':
                if (lastAction.data && lastAction.data.oldDrawings) {
                    const newData = {
                        masks: data.masks || [],
                        drawings: lastAction.data.oldDrawings,
                        note: data.note || ''
                    };
                    
                    this.saveImageData(this.activeImage, newData);
                    this.redrawCanvas(this.activeImage);
                    this.showNotification('涂鸦状态已恢复', 'success');
                }
                break;
        }
    },
    
    undoAllActions() {
        if (!this.activeImage) return;
        
        const drawHistory = this.drawHistory.get(this.activeImage);
        const maskHistory = this.maskHistory.get(this.activeImage);
        
        let latestOp = null;
        let source = null;
        
        if (drawHistory && drawHistory.length > 0) {
            const lastDraw = drawHistory[drawHistory.length - 1];
            latestOp = lastDraw;
            source = 'drawing';
        }
        
        if (maskHistory && maskHistory.length > 0) {
            const lastMask = maskHistory[maskHistory.length - 1];
            if (!latestOp || lastMask.timestamp > latestOp.timestamp) {
                latestOp = lastMask;
                source = 'mask';
            }
        }
        
        if (source === 'mask') {
            this.undoMaskAction();
        } else if (source === 'drawing') {
            this.undoDrawAction();
        } else {
            this.showNotification('没有更多可撤销的操作', 'info');
        }
    },
    
    // ==================== 渲染方法 ====================
    
    redrawImage(imgId) {
        const wrapper = this.getWrapperByImgId(imgId);
        if (!wrapper) return;
        
        const maskLayer = wrapper.querySelector('.cloze-mask-layer');
        if (!maskLayer) return;
        
        maskLayer.innerHTML = '';
        
        const data = this.getImageData(imgId);
        
        if (!data || !data.masks || data.masks.length === 0) {
            return;
        }
        
        const wrapperRect = wrapper.getBoundingClientRect();
        const img = wrapper.querySelector('img');
        const naturalWidth = img.naturalWidth || wrapperRect.width;
        const naturalHeight = img.naturalHeight || wrapperRect.height;
        
        data.masks.forEach(maskData => {
            if (!maskData || typeof maskData !== 'object') return;
            
            const displayPos = CoordinateSystem.absoluteToDisplay(
                (maskData.x / 100) * naturalWidth,
                (maskData.y / 100) * naturalHeight,
                naturalWidth,
                naturalHeight,
                wrapperRect.width,
                wrapperRect.height
            );
            
            const displayWidth = (maskData.width / 100) * naturalWidth * displayPos.scaleX;
            const displayHeight = (maskData.height / 100) * naturalHeight * displayPos.scaleY;
            
            const mask = document.createElement('div');
            mask.className = `cloze-mask ${maskData.type || 'rect'}`;
            mask.id = maskData.id;
            mask.style.left = displayPos.x + 'px';
            mask.style.top = displayPos.y + 'px';
            mask.style.width = displayWidth + 'px';
            mask.style.height = displayHeight + 'px';
            mask.style.backgroundColor = maskData.color || '#FFF9C4';
            
            if (maskData.type === 'circle') {
                mask.style.borderRadius = '50%';
            }
            
            maskLayer.appendChild(mask);
        });
    },
    
    redrawCanvas(imgId) {
        const wrapper = this.getWrapperByImgId(imgId);
        if (!wrapper) return;
        
        const canvas = wrapper.querySelector('.cloze-drawing-layer');
        if (!canvas) return;
        
        const ctx = canvas.getContext('2d');
        
        const data = this.getImageData(imgId);
        
        if (!ctx || !data) return;
        
        const img = wrapper.querySelector('img');
        const imgRect = img.getBoundingClientRect();
        
        const canvasWidth = Math.max(imgRect.width, 100);
        const canvasHeight = Math.max(imgRect.height, 100);
        
        if (canvas.width !== canvasWidth || canvas.height !== canvasHeight) {
            canvas.width = canvasWidth;
            canvas.height = canvasHeight;
        }
        
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        
        if (data.drawings && data.drawings.length > 0) {
            data.drawings.forEach(drawing => {
                if (!drawing.points || drawing.points.length < 2) return;
                
                ctx.beginPath();
                ctx.strokeStyle = drawing.color || '#FF0000';
                ctx.lineWidth = drawing.size || 1;
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';
                
                drawing.points.forEach((point, index) => {
                    if (point.length < 2) return;
                    
                    const pixelX = (point[0] / 100) * imgRect.width;
                    const pixelY = (point[1] / 100) * imgRect.height;
                    
                    if (index === 0) {
                        ctx.moveTo(pixelX, pixelY);
                    } else {
                        ctx.lineTo(pixelX, pixelY);
                    }
                });
                
                ctx.stroke();
            });
        }
    },
    
    // ==================== 辅助方法 ====================
    
    isImageInPopup(element) {
        if (!element) return { inPopup: false };
        
        let elementToCheck = element;
        const popupIds = ['popup1', 'popup2', 'popup3', 'popup4', 'note-popup', 'expand-popup', 'reference-popup', 'conclude-popup', 'ankiNoteEditor', 'ankiNotePreview', 'ankiNotesPanel'];
        
        for (const popupId of popupIds) {
            const popup = document.getElementById(popupId);
            if (popup) {
                let current = elementToCheck;
                while (current && current !== document.body) {
                    if (popup.contains(current)) {
                        return {
                            inPopup: true,
                            popup: popup,
                            popupId: popupId
                        };
                    }
                    current = current.parentElement;
                }
            }
        }
        
        return { inPopup: false };
    },
    
    isPopupVisible(popupElement) {
        if (!popupElement) return false;
        return popupElement.classList.contains('popup-visible');
    },
    
    checkInPopupWindow(popupInfo, wrapper) {
        if (!popupInfo || !popupInfo.popup) {
            return;
        }
        
        const isVisible = this.isPopupVisible(popupInfo.popup);
        if (!isVisible) {
            this.deactivateCurrentImage();
            return;
        }
        
        const popup = popupInfo.popup;
        const popupRect = popup.getBoundingClientRect();
        const wrapperRect = wrapper.getBoundingClientRect();
        
        const isCompletelyOutOfView = (
            wrapperRect.bottom < popupRect.top ||
            wrapperRect.top > popupRect.bottom
        );
        
        if (isCompletelyOutOfView) {
            this.deactivateCurrentImage();
            return;
        }
    },
    
    isNodeCollapsed(node) {
        if (!node || !node.classList || !node.classList.contains('node')) return false;
        
        const bullet = node.querySelector('.bullet');
        if (!bullet) return false;
        
        const bulletDot = bullet.querySelector('.bullet-dot');
        if (bulletDot) {
            const style = window.getComputedStyle(bulletDot);
            const isBoxShadowForCollapsed = style.boxShadow.includes('0 0 0 2px rgb(100, 106, 115)') && 
                                           style.boxShadow.includes('0 0 0 4px rgb(200, 200, 200)');
            const isTransparent = style.backgroundColor === 'transparent' || 
                                 style.backgroundColor === 'rgba(0, 0, 0, 0)';
            
            if (isBoxShadowForCollapsed && isTransparent) {
                return true;
            }
        }
        
        const nodeElements = Array.from(node.children).filter(child => 
            !child.classList.contains('bullet') && 
            !child.classList.contains('content')
        );
        
        if (nodeElements.length > 0) {
            const firstChild = nodeElements[0];
            return firstChild.style.display === 'none';
        }
        
        return false;
    },
    
    checkInNormalWindow(wrapper) {
        const wrapperRect = wrapper.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        const isCompletelyOutOfView = (
            wrapperRect.bottom < 0 ||
            wrapperRect.top > viewportHeight
        );
        if (isCompletelyOutOfView) {
            this.deactivateCurrentImage();
            return;
        }
    },
    
    getDetailsContainer(element) {
        if (!element) return null;
        let current = element;
        while (current && current !== document.body) {
            if (current.tagName === 'DETAILS') {
                return current;
            }
            current = current.parentElement;
        }
        return null;
    },
    
    async init() {
