// ==================== 备注输入功能====================
function showNoteInput() {
    if (!window.AnkiClozeInstance?.activeImage) return;
    
    const ankiCloze = window.AnkiClozeInstance;
    const imgId = ankiCloze.activeImage;
    
    const existingData = ankiCloze.getCurrentImageData();
    const currentNote = existingData.note || '';
    
    const dialog = document.createElement('div');
    dialog.className = 'anki-cloze-note-dialog';
    dialog.style.cssText = `
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: white;
        width: 320px;
        border-radius: 8px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.2);
        z-index: 100000;
        border: 1px solid #ddd;
    `;
    
    dialog.innerHTML = `
        <div style="padding: 20px; border-bottom: 1px solid #eee;">
            <div style="font-size: 16px; font-weight: 600; color: #333; margin-bottom: 8px;">图片备注</div>
            <div style="font-size: 13px; color: #666;">为当前图片添加备注以整理笔记列表</div>
        </div>
        
        <div style="padding: 20px;">
            <textarea id="noteInputField" placeholder="输入备注内容..." 
                style="width: 100%; height: 80px; padding: 12px; border: 1px solid #ddd; 
                border-radius: 6px; font-size: 14px; resize: vertical; box-sizing: border-box;
                font-family: inherit;">${currentNote}</textarea>
        </div>
        
        <div style="padding: 16px 20px 20px; background: #f9f9f9; border-top: 1px solid #eee;
             border-radius: 0 0 8px 8px; display: flex; gap: 10px; justify-content: flex-end;">
            <button id="noteCancelBtn" style="
                padding: 8px 16px;
                background: #f0f0f0;
                border: 1px solid #ddd;
                border-radius: 4px;
                color: #666;
                cursor: pointer;
                font-size: 13px;
            ">取消</button>
            <button id="noteSaveBtn" style="
                padding: 8px 24px;
                background: #4A90E2;
                border: none;
                border-radius: 4px;
                color: white;
                cursor: pointer;
                font-weight: 500;
                font-size: 13px;
            ">保存</button>
        </div>
    `;
    
    document.body.appendChild(dialog);
    
    const textarea = dialog.querySelector('#noteInputField');
    const cancelBtn = dialog.querySelector('#noteCancelBtn');
    const saveBtn = dialog.querySelector('#noteSaveBtn');
    
    const close = () => {
        if (dialog.parentNode) {
            document.body.removeChild(dialog);
        }
    };
    
    saveBtn.onclick = () => {
        const noteText = textarea.value.trim();
        
        const dataToSave = {
            masks: existingData.masks || [],
            drawings: existingData.drawings || [],
            note: noteText
        };
        
        const saveSuccess = ankiCloze.storage.saveImageData(imgId, dataToSave);
        
        if (saveSuccess) {
            close();
            if (ankiCloze.refreshDataManagement) {
                ankiCloze.refreshDataManagement();
            }
            if (ankiCloze.showNotification) {
                ankiCloze.showNotification('备注已保存', 'success');
            }
        }
    };
    
    cancelBtn.onclick = close;
    
    const escHandler = (e) => {
        if (e.key === 'Escape') close();
    };
    document.addEventListener('keydown', escHandler);
    
    setTimeout(() => {
        textarea.focus();
        if (currentNote) textarea.select();
    }, 10);
    
    dialog.addEventListener('click', (e) => {
        if (e.target === dialog) close();
    });
    
    const originalClose = close;
    close = () => {
        document.removeEventListener('keydown', escHandler);
        originalClose();
    };
}

