    RestoreNoteMarks(textNode, offset, length, markData) {
        try {
            const { id, type, text, htmlTag } = markData;
            const markedText = textNode.textContent.substring(offset, offset + length);
            if (type === 'html-tag' && htmlTag && ['h1','h2','h3','h4','h5','h6'].includes(htmlTag)) {
                if (textNode.parentNode && textNode.parentNode.tagName === 'DIV' && textNode.parentNode.textContent.trim() === text) {
                    const div = textNode.parentNode;
                    const heading = document.createElement(htmlTag);
                    heading.textContent = text;
                    heading.setAttribute('data-mark-id', id);
                    heading.className = 'mark';
                    this.bindMarkEvents(heading, type);
                    div.parentNode.replaceChild(heading, div);
                    return true;
                }
            }
            let element;
            if (type === 'html-tag' && htmlTag) {
                if (['h1','h2','h3','h4','h5','h6'].includes(htmlTag)) {
                    element = document.createElement(htmlTag);
                    element.textContent = markedText;
                    element.setAttribute('data-mark-id', id);
                    element.className = 'mark';
                } else {
                    element = document.createElement('span');
                    element.setAttribute('data-mark-id', id);
                    element.className = 'mark';
                    const htmlElement = document.createElement(htmlTag);
                    htmlElement.textContent = markedText;
                    element.appendChild(htmlElement);
                    if (htmlTag === 'u') {
                        setTimeout(() => {
                            if (window.convertSingleUnderline) window.convertSingleUnderline(htmlElement);
                        }, 10);
                    }
                }
            } else {
                element = document.createElement('span');
                element.setAttribute('data-mark-id', id);
                element.className = `mark mark-${type}`;
                element.textContent = markedText;
            }
            this.bindMarkEvents(element, type);
            const beforeText = textNode.textContent.substring(0, offset);
            const afterText = textNode.textContent.substring(offset + length);
            if (textNode.parentNode) {
                const parent = textNode.parentNode;
                const newNodes = [];
                if (beforeText) newNodes.push(document.createTextNode(beforeText));
                newNodes.push(element);
                if (afterText) newNodes.push(document.createTextNode(afterText));
                const fragment = document.createDocumentFragment();
                newNodes.forEach(node => fragment.appendChild(node));
                parent.replaceChild(fragment, textNode);
                return true;
            }
            return false;
        } catch (error) {
            return false;
        }
    }
    
