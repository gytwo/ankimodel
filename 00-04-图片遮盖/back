    function scrollToImage(imgId) {
    const img = document.querySelector(`img[data-cloze-id="${imgId}"]`);
    if (!img) {
        window.AnkiClozeInstance?.showNotification(`未找到图片: ${imgId}`, 'warning');
        return;
    }
    
    const ankiCloze = window.AnkiClozeInstance;
    if (!ankiCloze) {
        window.alert('系统未初始化');
        return;
    }
    
    const popupInfo = ankiCloze.isImageInPopup(img.parentElement);
    const isInPopup = popupInfo.inPopup;
    const popup = popupInfo.popup;
    
    
    // 打开目标弹窗
    if (isInPopup && popup) {
        popup.classList.add('popup-visible');
        // 将该弹窗提到最前面
        bringElementToFront(popup);
    }
    
    if (typeof collapseAllDetails === 'function') collapseAllDetails();
    if (typeof collapseAllNodes === 'function') collapseAllNodes();
    
    document.querySelectorAll('details').forEach(detail => {
        if (detail.contains(img) && !detail.open) {
            detail.open = true;
            if (typeof updateButtonText === 'function') updateButtonText('收');
        }
    });
    
    document.querySelectorAll('.node').forEach((node) => {
        if (node.contains(img) && !node.classList.contains('expanded')) {
            node.classList.add('expanded');
            if (typeof updateButtonText === 'function') updateButtonText('收');
            const bulletDot = node.querySelector('.bullet-dot');
            if (bulletDot) {
                bulletDot.style.boxShadow = 'none';
                bulletDot.style.backgroundColor = 'rgb(100, 106, 115)';
            }
        }
    });
    
    if (isInPopup && popup) {
        // 查找弹窗中的滚动容器
        const scrollContainers = [
          '.popup-content',
          '.anki-preview-content'
        ];
        
        let scrollContainer = null;
        for (const selector of scrollContainers) {
            const container = popup.querySelector(selector);
            if (container && container.scrollHeight > container.clientHeight) {
                scrollContainer = container;
                break;
            }
        }
        
        // 如果没有找到特定滚动容器，就用弹窗本身
        if (!scrollContainer) {
            // 检查弹窗本身是否可以滚动
            if (popup.scrollHeight > popup.clientHeight) {
                scrollContainer = popup;
            } else {
                // 如果弹窗也不能滚动，尝试查找任何可滚动的子元素
                const allChildren = popup.querySelectorAll('*');
                for (const child of allChildren) {
                    if (child.scrollHeight > child.clientHeight && child.contains(img)) {
                        scrollContainer = child;
                        break;
                    }
                }
            }
        }
        
        if (scrollContainer) {
            // 等待弹窗完全显示后再计算位置
            setTimeout(() => {
                // 计算图片在滚动容器中的位置
                const imgRect = img.getBoundingClientRect();
                const containerRect = scrollContainer.getBoundingClientRect();
                const containerScrollTop = scrollContainer.scrollTop || 0;
                
                // 计算相对位置
                const imgTopRelative = imgRect.top - containerRect.top + containerScrollTop;
                
                // 计算目标滚动位置（让图片在容器中央）
                const targetScroll = imgTopRelative - (containerRect.height / 2) + (imgRect.height / 2);
                
                // 平滑滚动
                scrollContainer.scrollTo({
                    top: targetScroll,
                    behavior: 'smooth'
                });
            }, 50); // 等待50ms确保弹窗渲染完成
        }
        // 如果没有可滚动的容器，只高亮图片
        
    } else {
        // 非弹窗图片：直接滚动到视图中夹
        img.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    
    // 高亮图片
    img.style.boxShadow = '0 0 0 4px rgba(107, 143, 249, 0.5)';
    img.style.transition = 'box-shadow 0.3s ease';
    
    setTimeout(() => {
        img.style.boxShadow = '';
    }, 2000);
    
    window.AnkiClozeInstance?.showNotification(`已跳转到图片`, 'success');
}

// 创建公共跳转函数（包含跳转和激活）
function commonImageJump(imgId, imageName) {
    const targetImgId = imgId;
    let shouldOpenNotePreview = false;
    let noteMarkId = null;
    
    // 1. ✅ 先刷新笔记标记分类，确保获取最新的分类数据
    if (window.NoteMarkSystem && window.NoteMarkSystem.refreshMarkCategorization) {
        try {
            window.NoteMarkSystem.refreshMarkCategorization();
        } catch (error) {
            console.warn('刷新笔记标记分类时出错:', error);
        }
    }
    
    // 2. 检查这个图片是否属于当前卡片的笔记标记
    if (window.NoteMarkSystem && window.NoteMarkSystem.categorizedMarks && imageName) {
        const { currentCardMarks } = window.NoteMarkSystem.categorizedMarks;
        
        for (const mark of currentCardMarks) {
            if (mark.type === 'note' && mark.note && mark.note.includes(imageName)) {
                // 从HTML中提取图片信息进行精确匹配
                const imgRegex = /<img[^>]+src="([^">]+)"[^>]*>/g;
                const noteContent = mark.note;
                let match;
                let imageFoundInNote = false;
                
                while ((match = imgRegex.exec(noteContent)) !== null) {
                    const src = match[1];
                    const filename = src.split('/').pop() || src;
                    if (filename === imageName || src.includes(imageName)) {
                        imageFoundInNote = true;
                        break;
                    }
                }
                
                if (imageFoundInNote) {
                    shouldOpenNotePreview = true;
                    noteMarkId = mark.id;
                    break;
                }
            }
        }
    }
    
    // 3. 如果应该打开笔记预览
    if (shouldOpenNotePreview && noteMarkId) {
        // 先打开笔记预览（这会创建图片）
        if (window.NoteMarkSystem.operations && window.NoteMarkSystem.operations.openNotePreview) {
            window.NoteMarkSystem.operations.openNotePreview(noteMarkId);
        }
        
        // 等待笔记预览完全打开，图片被创建和包装
        setTimeout(() => {
            // 现在图片应该已经存在了，执行跳转
            scrollToImage(targetImgId);
            
            // 跳转后延迟150ms再激活图片
            setTimeout(() => {
                const wrapper = document.querySelector(`img[data-cloze-id="${targetImgId}"]`)?.parentElement;
                if (wrapper && window.AnkiClozeInstance) {
                    window.AnkiClozeInstance.activateImage(targetImgId, wrapper);
                }
            }, 150);
        }, 100); // 等待笔记预览完全打开
        
        return; // 直接返回，不执行后面的通用逻辑
    }
    
    // 4. 非笔记标记的图片执行跳转和激活
    scrollToImage(targetImgId);
    
    // 非笔记标记的图片也延迟激活
    setTimeout(() => {
        const wrapper = document.querySelector(`img[data-cloze-id="${targetImgId}"]`)?.parentElement;
        if (wrapper && window.AnkiClozeInstance) {
            window.AnkiClozeInstance.activateImage(targetImgId, wrapper);
        }
    }, 250);
}


