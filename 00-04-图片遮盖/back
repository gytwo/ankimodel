// ==================== 复制函数 ====================
function CopyCurrentData() {
    if (!window.AnkiClozeInstance) {
        alert('系统未初始化');
        return;
    }
    
    const ankiCloze = window.AnkiClozeInstance;
    const storage = ankiCloze.storage;
    
    // ========== 直接执行复制 ==========
    try {
        const result = storage.copyToClipboard('current');
        
        if (result.success) {
            let detailMessage = `✅ 复制成功`;
            
            detailMessage += `\n📱 图片：${result.imageCount}张`;
            
            if (result.maskCount > 0 || result.drawingCount > 0) {
                detailMessage += `\n📊 包含：`;
                
                if (result.maskCount > 0) {
                    detailMessage += ` 🎭${result.maskCount}个遮罩`;
                }
                if (result.drawingCount > 0) {
                    detailMessage += ` 🎨${result.drawingCount}个涂鸦`;
                }
            } else {
                detailMessage += `\n⚠️ 无遮罩和涂鸦`;
            }
            
            if (result.size && result.size > 0) {
                const sizeKB = (result.size / 1024).toFixed(1);
                detailMessage += `\n💾 大小：${sizeKB < 1 ? result.size + ' 字节' : sizeKB + ' KB'}`;
            }
            
            const dataSourceInfo = storage.getImageDataSourceInfo();
            detailMessage += `\n🔗 数据源：${dataSourceInfo.displayName}`;
            detailMessage += `\n🔗 类型：当前卡片`;
            detailMessage += `\n\n📋 已复制到剪贴板，请粘贴到Anki的ImageClozeData字段`;
            
            ankiCloze.showNotification(detailMessage, 'success');
            
        } else {
            ankiCloze.showNotification(`复制失败: ${result.error}`, 'warning');
        }
        
        if (ankiCloze.refreshDataManagement) {
            ankiCloze.refreshDataManagement();
        }
        
    } catch (error) {
        ankiCloze.showNotification(`复制过程出错: ${error.message}`, 'error');
    }
}


