<script>
// == 0.多卡多空转换：anki原始渲染的cloze格式 -> 版本B===
//== 【自动转换为所需格式，从而取消对HideAllCloze插件的依赖】===
//== 【该转换是在anki原始解析已经生成新卡片的基础上的进一步转换，生成的挖空为多卡多空】 ===
function convertClozeAttributes() {
    function genId() {
        return Math.floor(Math.random() * 65536).toString(16).padStart(4, '0');
    }
    
    // 1. 处理当前卡片的cloze（显示[...]的）
    var currentCloze = document.querySelectorAll('span.cloze:not([data-has-nested])');
    
    currentCloze.forEach(function(el) {
        var ordinal = el.getAttribute('data-ordinal');
        var originalContent = el.getAttribute('data-cloze') || '';
        
        if (!ordinal) return;
        
        var id = genId();
        
        // 创建嵌套结构
        var nestedHTML = 
            '<cloze2_w class="cz-' + ordinal + '" data-cloze-id="' + id + '"></cloze2_w>' +
            '<cloze2 class="cz-' + ordinal + ' czi-' + id + '">' + originalContent + '</cloze2>';
        
        // 只更新data-cloze属性
        el.setAttribute('data-cloze', nestedHTML);
        el.setAttribute('data-has-nested', 'true'); // 标记已处理
        
        // 保持其他内容不变
    });
    
    // 2. 处理非当前卡片的cloze（显示完整内容的）
    var inactiveCloze = document.querySelectorAll('span.cloze-inactive:not([data-has-nested])');
    
    inactiveCloze.forEach(function(el) {
        var ordinal = el.getAttribute('data-ordinal');
        if (!ordinal) return;
        
        var id = genId();
        
        // 保存原来的内容
        var originalHTML = el.innerHTML;
        
        // 创建嵌套结构
        var nestedHTML = 
            '<cloze2_w class="cz-' + ordinal + '" data-cloze-id="' + id + '"></cloze2_w>' +
            '<cloze2 class="cz-' + ordinal + ' czi-' + id + '">' + originalHTML + '</cloze2>';
        
        // 只更新innerHTML，不替换整个元素
        el.innerHTML = nestedHTML;
        el.setAttribute('data-has-nested', 'true'); // 标记已处理
    });
}
