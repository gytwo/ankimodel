    switchImageDataSource() {
    try {
        const isCurrentlyLocal = this.storage.currentImageDataSource === 'local';
        
        if (isCurrentlyLocal) {
            this.storage.setImageDataSource('field');
            this.showNotification('已切换到ImageCloze字段', 'success');
        } else {
            const shouldMerge = confirm(
                `🔄 从字段模式切换到本地模式\n\n` +
                `是否将字段数据合并到本地存储？\n\n` +
                `【合并】字段数据 + 本地特殊\n` +
                `【不合并】本地原始数据\n`
            );
            
            if (shouldMerge) {
                const fieldData = this.storage.getFieldData();
                const localData = this.storage.localStorage.loadFromLocalStorage(this.storage.config.fieldName) || {};
                
                const currentCardImageIds = this.storage.getCurrentPageImageIds();
                const mergedData = { ...localData };
                
                currentCardImageIds.forEach(imgId => {
                    if (fieldData[imgId]) {
                        mergedData[imgId] = fieldData[imgId];
                    }
                });
                
                try {
                    const key = `anki-cloze-${this.storage.config.fieldName}`;
                    localStorage.setItem(key, JSON.stringify(mergedData));
                } catch (error) {
                    this.showNotification(`数据合并失败: ${error.message}`, 'error');
                }
            }
            
            this.storage.setImageDataSource('local');
            this.showNotification(
                `已切换到本地模式${shouldMerge ? '（已合并字段数据）' : '（使用本地数据）'}`,
                'success'
            );
        }
        
        this.maskHistory.clear();
        this.drawHistory.clear();

        document.querySelectorAll('.cloze-mask-layer').forEach(layer => {
            layer.innerHTML = '';
        });
        
        document.querySelectorAll('.cloze-drawing-layer').forEach(canvas => {
            if (canvas.getContext) {
                canvas.getContext('2d').clearRect(0, 0, canvas.width, canvas.height);
            }
        });
        
        if (!this.imageIdMap) {
            const allImages = document.querySelectorAll('img:not([data-no-cloze])');
            this.imageIdMap = new Map();
            
            allImages.forEach(img => {
                const imgId = img.dataset.clozeId || this.generateStableImageId(img);
                if (imgId) {
                    const filename = this.getImageFilename(img);
                    this.imageIdMap.set(filename, imgId);
                }
            });
        }
        
        this.restoreAllMarks();
        
        const stats = this.storage.getImageCountByCard(null, this.imageIdMap || new Map());
        const info = this.storage.getImageDataSourceInfo();

        this.showNotification(
            `已切换到${info.displayName}，` +
            `加载了${stats.currentCard}张图片的数据，` +
            `共${stats.currentCardMasks}个遮罩，${stats.currentCardDrawings}个涂鸦`,        
            'success'
        );
        
        this.refreshDataManagement();
        
        this.updateImageDataSourceDisplay();
        this.updateQuickToolbar();
        
    } catch (error) {
        this.showNotification(`切换失败：${error.message}`, 'error');
    }
},
    
