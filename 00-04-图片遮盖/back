   mergeFieldToLocal() {
    try {
        const fieldMarks = this.dataManager.loadFromAnkiField() || [];
        const localMarks = this.storage.getAllNoteMarks();
        
        if (fieldMarks.length === 0) {
            return true; // 字段为空，无需合并
        }
        
        // 合并策略：字段为主 + 本地特殊
        const fieldMarkIds = new Set(fieldMarks.map(mark => mark.id));
        const localSpecialMarks = localMarks.filter(mark => !fieldMarkIds.has(mark.id));
        const mergedMarks = [...fieldMarks, ...localSpecialMarks];
        
        const success = this.storage.saveAllNoteMarks(mergedMarks);
        
        if (success) {
            this.refreshMarkCategorization();
            return true;
        }
        
        return false;
    } catch (error) {
        showMessage(`合并数据失败：${error.message}`, 'error');
        return false;
    }
}
    
