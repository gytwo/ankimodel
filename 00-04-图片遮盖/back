    showNotification(message, type = 'info', duration = 1000) {
        const existing = document.querySelector('.system-notification');
        if (existing) existing.remove();
        const notification = document.createElement('div');
        notification.className = `system-notification ${type}`;
        notification.innerHTML = `
        <span>${type === 'info' ? 'ℹ️' : type === 'warning' ? '⚠️' : type === 'success' ? '✅' : '❌'}</span>
        <span>${message}</span>
        `;
        document.body.appendChild(notification);
        
        if (message.includes('\n')) {
            notification.style.whiteSpace = 'pre-line';
            notification.style.textAlign = 'left';
            notification.style.padding = '12px 16px';
            notification.style.lineHeight = '1.5';
            notification.style.maxWidth = '350px';
            notification.style.maxHeight = '200px';
            notification.style.overflowY = 'auto';
        }
        
        setTimeout(() => {
            if (notification.parentNode) {
                notification.style.opacity = '0';
                notification.style.transform = 'translateX(-50%) translateY(-15px)';
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.parentNode.removeChild(notification);
                    }
                }, 300);
            }
        }, duration);
    },
    
