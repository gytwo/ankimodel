                maskLayer.setAttribute('data-img-id', imgId);
                wrapper.appendChild(maskLayer);
            }
            
            let drawLayer = wrapper.querySelector('.cloze-drawing-layer');
            if (!drawLayer) {
                drawLayer = document.createElement('canvas');
                drawLayer.className = 'cloze-drawing-layer';
                drawLayer.id = `drawings-${imgId}`;
                drawLayer.style.pointerEvents = 'none';
                drawLayer.setAttribute('data-img-id', imgId);
                wrapper.appendChild(drawLayer);
                drawLayer.width = Math.max(imgRect.width, 100);
                drawLayer.height = Math.max(imgRect.height, 100);
                drawLayer.style.width = '100%';
                drawLayer.style.height = '100%';
            }
            
            if (!maskLayer.hasAttribute('data-events-bound')) {
                this.setupMaskLayerEvents(maskLayer, wrapper, imgId);
                maskLayer.setAttribute('data-events-bound', 'true');
