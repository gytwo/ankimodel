            toggle.id = 'ankiNotesPanelToggle';
            toggle.title = '显示笔记列表';
            document.body.appendChild(toggle);
        }
    }
    
    bindSystemEvents() {
        document.addEventListener('mouseup', (e) => this.handleSelection(e));
        document.addEventListener('touchend', (e) => this.handleSelection(e));
        this.bindToolbarButtons();
        document.addEventListener('click', (e) => this.handleGlobalClick(e));
        document.addEventListener('keydown', (e) => this.handleKeydown(e));
        if (this.isMobile) this.fixMobileScroll();
    }
    
    fixMobileScroll() {
        const notesPanel = document.getElementById('ankiNotesPanel');
        if (!notesPanel) return;
        const enableScroll = () => {
            const panelContent = document.getElementById('ankiNotesPanelContent');
            if (!panelContent) return;
            panelContent.style.cssText += `-webkit-overflow-scrolling: touch !important; overflow-y: auto !important; touch-action: pan-y !important;`;
            panelContent.addEventListener('touchstart', (e) => { e.stopPropagation(); }, { passive: true });
            panelContent.addEventListener('touchmove', (e) => { e.stopPropagation(); }, { passive: true });
        };
        const observer = new MutationObserver(() => {
            if (notesPanel.classList.contains('popup-visible')) setTimeout(enableScroll, 50);
        });
        observer.observe(notesPanel, { attributes: true, attributeFilter: ['class'] });
        if (notesPanel.classList.contains('popup-visible')) setTimeout(enableScroll, 50);
    }
    
    bindToolbarButtons() {
        const buttons = document.querySelectorAll('#ankiMarkToolbar button[data-mark-type]');
        buttons.forEach(btn => {
            const newBtn = btn.cloneNode(true);
            btn.parentNode.replaceChild(newBtn, btn);
            newBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                e.preventDefault();
                const type = newBtn.getAttribute('data-mark-type');
                const htmlTag = newBtn.getAttribute('data-html-tag');
                const extraData = {};
                if (htmlTag) extraData.htmlTag = htmlTag;
                this.applyMark(type, extraData);
            });
        });
        const restartBtn = document.querySelector('#ankiMarkToolbar button[data-action="restart"]');
        if (restartBtn) {
            const newRestartBtn = restartBtn.cloneNode(true);
            restartBtn.parentNode.replaceChild(newRestartBtn, restartBtn);
            newRestartBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                e.preventDefault();
                this.restart();
            });
        }
    }
    
    handleSelection(event) {
        const delay = event.type === 'touchend' ? 100 : 50;
        setTimeout(() => {
            try {
                const selection = window.getSelection();
                const selectedText = selection.toString().trim();
                if (selectedText && selectedText.length > 1 && selection.rangeCount > 0) {
                    const clickedElement = event.target;
                    const isToolbar = clickedElement.closest('#ankiMarkToolbar');
                    const isMark = clickedElement.closest('.mark');
                    const isPanel = clickedElement.closest('#ankiNotesPanel');
                    const isToggle = clickedElement.closest('#ankiNotesPanelToggle');
                    if (!isToolbar && !isMark && !isPanel && !isToggle) {
                        this.currentSelection = selectedText;
                        this.currentRange = selection.getRangeAt(0).cloneRange();
                        let x, y;
                        if (event.type === 'touchend' && event.changedTouches) {
                            const touch = event.changedTouches[0];
                            x = touch.clientX;
                            y = touch.clientY;
                        } else {
                            x = event.clientX;
                            y = event.clientY;
                        }
                        this.showToolbar(x, y);
                    }
                }
            } catch (error) {}
        }, delay);
    }
    
    showToolbar(x, y) {
        const toolbar = document.getElementById('ankiMarkToolbar');
        if (!toolbar) return;
        const viewportWidth = window.innerWidth;
        const viewportHeight = window.innerHeight;
        const toolbarWidth = 200;
        const toolbarHeight = 80;
        let posX = x;
        let posY = y + 20;
        if (posX + toolbarWidth > viewportWidth) posX = viewportWidth - toolbarWidth - 10;
        if (posX < 10) posX = 10;
        if (posY + toolbarHeight > viewportHeight) {
            posY = y - toolbarHeight - 10;
            if (posY < 10) posY = viewportHeight - toolbarHeight - 10;
        }
        toolbar.style.left = posX + 'px';
        toolbar.style.top = posY + 'px';
        toolbar.style.transform = 'none';
        toolbar.style.bottom = 'auto';
        toolbar.style.display = 'block';
        setTimeout(() => {
            if (toolbar.style.display === 'block') this.hideToolbar();
        }, 5000);
    }
    
    hideToolbar() {
        const toolbar = document.getElementById('ankiMarkToolbar');
        if (toolbar) {
            toolbar.style.display = 'none';
            toolbar.style.transform = 'none';
            toolbar.style.bottom = 'auto';
        }
        this.currentSelection = null;
        this.currentRange = null;
    }
    
    applyMark(type, extraData = {}) {
    // === 字段模式下的限制 ===
    if (this.currentDataSource === 'NoteMark字段') {
        const convertToLocal = confirm(
            `⚠️ 当前数据来源为 [NoteMark字段]\n\n` +
            `字段模式下无法添加新的标记。\n\n` +
            `是否切换到本地模式以添加标记？`
        );
        
        if (!convertToLocal) {
            showMessage('已取消标记创建', 'warning');
            this.hideToolbar();
            return;
        }
        
        // 切换模式
        this.switchDataSource();
        return;
    }
    
    // 原有的本地模式逻辑
    if (!this.currentSelection || this.currentSelection.length < 1) {
        showMessage('请选择至少1个字符', 'error');
        return;
    }
    
    try {
        const selection = window.getSelection();
        selection.removeAllRanges();
        
        if (this.currentRange) {
            selection.addRange(this.currentRange.cloneRange());
        } else {
            showMessage('无法获取选择范围', 'error');
            return;
        }
        
        const range = selection.getRangeAt(0);
        const selectedText = selection.toString().trim();
        
        if (!selectedText) {
            showMessage('没有选中文本', 'error');
            return;
        }
        
        const noteContent = type === 'note' ? '' : undefined;
        const htmlTag = extraData.htmlTag || '';
        const markData = this.dataManager.createNoteMarkData(selection, type, noteContent, htmlTag);
        
        if (!markData) {
            showMessage('创建标记数据失败', 'error');
            return;
        }
        
        const success = this.createMarkAtPositionForApply(range, selectedText, markData);
        
        if (success) {
            selection.removeAllRanges();
            this.hideToolbar();
            
            const editor = document.getElementById('ankiNoteEditor');
            const editorContent = editor?.querySelector('.anki-note-editor-content');
            
            if (editor && editorContent && this.editingNoteId) {
                markData._embedded = true;
                markData._sourceNoteId = this.editingNoteId;
                const inputEvent = new Event('input', { bubbles: true });
                editorContent.dispatchEvent(inputEvent);
                setTimeout(() => { this.saveEnhancedMark(markData); }, 300);
            } else {
                this.saveEnhancedMark(markData);
            }
            
            let message = '';
            if (type === 'note') {
                message = '已添加笔记标记，点击标记可编辑';
                setTimeout(() => {
                    const newMarkElement = document.querySelector(`[data-mark-id="${markData.id}"]`);
                    if (newMarkElement) {
                        this.activeMarkElement = newMarkElement;
                        this.showNoteEditor(newMarkElement);
                    }
                }, 100);
            } else if (type === 'html-tag') {
                message = `已添加<${htmlTag}>标签`;
            } else {
                message = `已添加${this.getMarkName(type)}标记`;
            }
            
            showMessage(message, 'success');
            this.updatePanelToggle();
        }
    } catch (error) {
        showMessage('添加标记失败', 'error');
    }
}

    createMarkAtPositionForApply(range, selectedText, markData) {
        try {
            const { type, htmlTag } = markData;
            const startNode = range.startContainer;
            if (type === 'html-tag' && htmlTag && ['h1','h2','h3','h4','h5','h6'].includes(htmlTag)) {
                if (startNode.parentNode && startNode.parentNode.tagName === 'DIV' && startNode.parentNode.textContent.trim() === selectedText) {
                    const div = startNode.parentNode;
                    const heading = document.createElement(htmlTag);
                    heading.textContent = selectedText;
                    heading.setAttribute('data-mark-id', markData.id);
                    heading.className = 'mark';
                    this.bindMarkEvents(heading, type);
                    div.parentNode.replaceChild(heading, div);
                    this.saveEnhancedMark(markData);
                    return true;
                }
            }
            let element;
            if (type === 'html-tag' && htmlTag) {
                if (['h1','h2','h3','h4','h5','h6'].includes(htmlTag)) {
                    element = document.createElement(htmlTag);
                    element.textContent = selectedText;
                    element.setAttribute('data-mark-id', markData.id);
                    element.className = 'mark';
                } else {
                    element = document.createElement('span');
                    element.setAttribute('data-mark-id', markData.id);
                    element.className = 'mark';
                    const htmlElement = document.createElement(htmlTag);
                    htmlElement.textContent = selectedText;
                    element.appendChild(htmlElement);
                    if (htmlTag === 'u') {
                        setTimeout(() => {
                            if (window.convertSingleUnderline) window.convertSingleUnderline(htmlElement);
                        }, 10);
                    }
                }
            } else {
                element = document.createElement('span');
                element.setAttribute('data-mark-id', markData.id);
                element.className = `mark mark-${type}`;
                element.textContent = selectedText;
            }
            this.bindMarkEvents(element, type);
            range.deleteContents();
            range.insertNode(element);
            this.saveEnhancedMark(markData);
            return true;
        } catch (error) {
            return false;
        }
    }

    getTextNodeFromElement(element) {
        const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, null, false);
        return walker.nextNode();
    }
    
    saveEnhancedMark(markData) {
    try {
        // 简化：保存标记总是使用本地存储，不再区分数据源
        let currentMarks = this.storage.getAllNoteMarks();
        
        const existingIndex = currentMarks.findIndex(m => m.id === markData.id);
        if (existingIndex >= 0) {
            const originalTimestamp = currentMarks[existingIndex].timestamp;
            currentMarks[existingIndex] = { ...markData, timestamp: originalTimestamp };
        } else {
            currentMarks.push({ ...markData, timestamp: new Date().toISOString() });
        }
        
        const success = this.storage.saveAllNoteMarks(currentMarks);
        
        if (success) {
            const shouldBeCurrent = markData.text && document.body.textContent.includes(markData.text);
            
            if (this.categorizedMarks) {
                // 从分类数据中移除旧标记
                this.categorizedMarks.currentCardMarks = this.categorizedMarks.currentCardMarks.filter(m => m.id !== markData.id);
                this.categorizedMarks.otherCardMarks = this.categorizedMarks.otherCardMarks.filter(m => m.id !== markData.id);
                
                // 根据是否在当前卡片中重新分类
                if (shouldBeCurrent) {
                    this.categorizedMarks.currentCardMarks.push(markData);
                } else {
                    this.categorizedMarks.otherCardMarks.push(markData);
                }
            }
            
            // 处理嵌入式标记的特殊逻辑
            if (markData._embedded === true && markData._sourceNoteId) {
                const sourceNote = currentMarks.find(m => m.id === markData._sourceNoteId);
                if (sourceNote && sourceNote.text && document.body.textContent.includes(sourceNote.text)) {
                    if (this.categorizedMarks) {
                        const inCurrent = this.categorizedMarks.currentCardMarks.some(m => m.id === markData.id);
                        const inOther = this.categorizedMarks.otherCardMarks.some(m => m.id === markData.id);
                        if (inOther) {
                            this.categorizedMarks.otherCardMarks = this.categorizedMarks.otherCardMarks.filter(m => m.id !== markData.id);
                            this.categorizedMarks.currentCardMarks.push(markData);
                        } else if (!inCurrent) {
                            this.categorizedMarks.currentCardMarks.push(markData);
                        }
                    }
                }
            }
            
            // 刷新笔记面板显示
            const notesPanel = document.getElementById('ankiNotesPanel');
            if (notesPanel && notesPanel.classList.contains('popup-visible')) {
                this.operations.refreshNotesDisplay(this.lastSearchTerm);
            }
            
            this.updatePanelToggle();
        }
        
        return success;
        
    } catch (error) {
        showMessage('保存标记失败', 'error');
        return false;
    }
}
    
bindMarkEvents(markElement, type) {
    let clickTimer = null;
    if (!this.isMobile) {
        markElement.addEventListener('dblclick', (e) => {
            e.stopPropagation();
            e.preventDefault();
            if (clickTimer) {
                clearTimeout(clickTimer);
                clickTimer = null;
            }
            const message = type === 'note' ? '确定要移除此笔记标记吗？' : '确定要移除此标记吗？';
            if (confirm(message)) this.removeMark(markElement);
        });
        
        if (type === 'note') {
            markElement.addEventListener('click', (e) => {
                e.stopPropagation();
                e.preventDefault();
                if (clickTimer) clearTimeout(clickTimer);
                clickTimer = setTimeout(() => {
                    const markId = markElement.getAttribute('data-mark-id');
                    if (markId && this.operations && this.operations.openNotePreview) {
                        this.operations.openNotePreview(markId);
                    }
                    clickTimer = null;
                }, 200);
            });
        }
    } else {
        let lastTapTime = 0;
        let tapTimer;
        markElement.addEventListener('touchstart', (e) => {
            const target = e.target;
            const isClozeElement = target.closest('cloze2, cloze2_w');
            
            if (isClozeElement) {
                if (!markElement._lastClozeTouchTime) {
                    markElement._lastClozeTouchTime = Date.now();
                }
                
                const now = Date.now();
                const timeSinceLastClozeTouch = now - markElement._lastClozeTouchTime;
                
                if (timeSinceLastClozeTouch < 200 && timeSinceLastClozeTouch > 0) {
                    clearTimeout(tapTimer);
                    markElement._lastClozeTouchTime = 0;
                    const message = type === 'note' ? '确定要移除此笔记标记吗？' : '确定要移除此标记吗？';
                    if (confirm(message)) this.removeMark(markElement);
                    return;
                }
                
                markElement._lastClozeTouchTime = now;
                return;
            }
            
            e.stopPropagation();
            e.preventDefault();
            const now = Date.now();
            const timeSinceLastTap = now - lastTapTime;
            if (timeSinceLastTap < 300 && timeSinceLastTap > 0) {
                clearTimeout(tapTimer);
                const message = type === 'note' ? '确定要移除此笔记标记吗？' : '确定要移除此标记吗？';
                if (confirm(message)) this.removeMark(markElement);
                lastTapTime = 0;
            } else {
                lastTapTime = now;
                if (type === 'note') {
                    tapTimer = setTimeout(() => {
                        const markId = markElement.getAttribute('data-mark-id');
                        if (markId && this.operations && this.operations.openNotePreview) {
                            this.operations.openNotePreview(markId);
                        }
                    }, 300);
                }
            }
        });
    }
}
    
