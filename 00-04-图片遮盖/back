    setupEventListeners() {
        const mainBall = document.getElementById('mainControlBall');
        
        const newMainBall = mainBall.cloneNode(true);
        mainBall.parentNode.replaceChild(newMainBall, mainBall);
        
        const fixedMainBall = document.getElementById('mainControlBall');
        
        fixedMainBall.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            this.toggleMenuSystem();
        });

        fixedMainBall.addEventListener('touchstart', (e) => {
            if (e.touches.length === 1) {
                e.preventDefault();
                e.stopPropagation();
                this.toggleMenuSystem();
            }
        }, { passive: false });

        const handleOutsideClick = (e) => {
            const mainBall = document.getElementById('mainControlBall');
            const menu = document.getElementById('unifiedMenu');
            const dataDialog = document.getElementById('dataManagementDialog');
            const guideDialog = document.getElementById('guideDialog');
            const copyDialog = document.getElementById('copyToFieldDialog');
            const ankiCloze = window.AnkiClozeInstance;
            
            const isMenuElement = menu && menu.contains(e.target);
            const isDataDialogElement = dataDialog && dataDialog.contains(e.target);
            const isGuideDialogElement = guideDialog && guideDialog.contains(e.target);
            const isCopyDialogElement = copyDialog && copyDialog.contains(e.target);
            const isGuideBtn = e.target.closest('#guideBtn');
            
            const isInsideAnyDialog = isMenuElement || isDataDialogElement ||
                                    isGuideDialogElement || isCopyDialogElement || isGuideBtn;
            
            if (!mainBall.contains(e.target) && !isInsideAnyDialog) {
                if (menu && menu.style.display === 'block') {
                    mainBall.classList.remove('active');
                    menu.style.display = 'none';
                    if (ankiCloze) {
                        ankiCloze.collapseAllSubMenus();
                    }
                }
            }
        };
        
        document.addEventListener('click', handleOutsideClick);
        document.addEventListener('touchstart', (e) => {
            handleOutsideClick(e);
        });
        
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const ankiCloze = window.AnkiClozeInstance;
                const guideDialog = document.getElementById('guideDialog');
                if (guideDialog && guideDialog.style.display === 'flex') {
                    hideGuideDialog();
                    return;
                }
                const dataDialog = document.getElementById('dataManagementDialog');
                if (dataDialog && dataDialog.style.display === 'flex') {
                    hideDataManagement();
                    return;
                }
                const copyDialog = document.getElementById('copyToFieldDialog');
                if (copyDialog && copyDialog.style.display === 'flex') {
                    hideCopyToFieldDialog();
                    return;
                }
                const menu = document.getElementById('unifiedMenu');
                if (menu && menu.style.display === 'block') {
                    const mainBall = document.getElementById('mainControlBall');
                    mainBall.classList.remove('active');
                    menu.style.display = 'none';
                    if (ankiCloze) {
                        ankiCloze.collapseAllSubMenus();
                    }
                } else if (ankiCloze) {
                    ankiCloze.deactivateCurrentImage();
                }
            }
        });
        
        document.addEventListener('keydown', (e) => {
            if ((e.key === 'Delete' || e.key === 'Backspace') && this.selectedMask && this.mode === 'edit') {
                e.preventDefault();
                this.deleteSelectedMask();
            }
        });
        
        document.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key === 'z') {
                e.preventDefault();
                this.undoAllActions();
            }
        });

        document.addEventListener('mousedown', (e) => {
            if (this.selectedMask && !e.target.closest('.cloze-mask')) {
                this.selectedMask.classList.remove('selected');
                this.removeMaskControls(this.selectedMask);
                this.selectedMask = null;
            }
        });
        
        const penSizeSlider = document.getElementById('penSizeSlider');
        const eraserSizeSlider = document.getElementById('eraserSizeSlider');
        if (penSizeSlider) {
            penSizeSlider.addEventListener('input', (e) => {
                this.updatePenSize(e.target.value);
            });
        }
        if (eraserSizeSlider) {
            eraserSizeSlider.addEventListener('input', (e) => {
                this.updateEraserSize(e.target.value);
            });
        }
    },
    
    cleanupBeforeRestart() {
        try {
            document.querySelectorAll('img').forEach(img => {
                img.removeAttribute('data-cloze-id');
                img.removeAttribute('data-cloze-pending-popup');
                
                img.style.pointerEvents = '';
                img.style.cursor = '';
                img.style.userSelect = '';
                
                img.classList.remove('active');
                
                const newImg = img.cloneNode(true);
                if (img.parentNode) {
                    img.parentNode.replaceChild(newImg, img);
                }
            });
            
            document.querySelectorAll('.cloze-image-wrapper').forEach(wrapper => {
                try {
                    const img = wrapper.querySelector('img');
                    if (img && wrapper.parentNode) {
                        wrapper.parentNode.insertBefore(img, wrapper);
                    }
                    wrapper.remove();
                } catch (e) {
                    wrapper.remove();
                }
            });
            
            const globalToolbar = document.getElementById('global-cloze-toolbar');
            if (globalToolbar && globalToolbar.parentNode) {
                globalToolbar.parentNode.removeChild(globalToolbar);
                this.globalToolbar = null;
            }
            
            if (this.cleanupGlobalToolbarPositioning) {
                this.cleanupGlobalToolbarPositioning();
                this.cleanupGlobalToolbarPositioning = null;
            }
            
            document.querySelectorAll('.system-notification').forEach(el => el.remove());
            
            const loadingIndicator = document.getElementById('loadingIndicator');
            if (loadingIndicator && loadingIndicator.parentNode) {
                loadingIndicator.style.display = 'none';
            }
            
            if (this.maskPreview && this.maskPreview.element) {
                this.maskPreview.element.remove();
                this.maskPreview = null;
            }
            
            if (this.eraserPreview) {
                this.eraserPreview.remove();
                this.eraserPreview = null;
            }
            
            const mainBall = document.getElementById('mainControlBall');
            if (mainBall) {
                mainBall.classList.remove('active', 'disabled');
                mainBall.style.opacity = '0.3';
            }
            
            const modeTabs = document.querySelectorAll('.mode-tab');
            modeTabs.forEach(tab => {
                tab.classList.remove('active');
                if (tab.classList.contains('edit')) {
                    tab.classList.add('active');
                }
            });
            
            const editContent = document.getElementById('editModeContent');
            const reviewContent = document.getElementById('reviewModeContent');
            if (editContent) editContent.style.display = 'block';
            if (reviewContent) reviewContent.style.display = 'none';
            
            if (typeof $ !== 'undefined') {
                $(document).off('.anki-cloze');
                $(window).off('.anki-cloze');
            }
            
            const eventTypes = ['click', 'mousedown', 'mousemove', 'mouseup',
                               'touchstart', 'touchmove', 'touchend',
                               'keydown', 'keyup', 'scroll', 'resize'];
            
            eventTypes.forEach(type => {
                document.removeEventListener(type, this.handleAnyEvent || (() => {}));
                window.removeEventListener(type, this.handleAnyEvent || (() => {}));
            });
            
            ['popup1', 'popup2', 'popup3', 'popup4', 'note-popup', 'expand-popup', 'reference-popup', 'conclude-popup', 'ankiNoteEditor', 'ankiNotePreview', 'ankiNotesPanel'].forEach(popupId => {
                const popup = document.getElementById(popupId);
                if (popup && popup._clozeScrollHandler) {
                    popup.removeEventListener('scroll', popup._clozeScrollHandler);
                    delete popup._clozeScrollHandler;
                }
            });
            
            if (this.responsiveRenderer && typeof this.responsiveRenderer.cleanup === 'function') {
                this.responsiveRenderer.cleanup();
            }
            
            if (this._timeoutIds) {
                this._timeoutIds.forEach(id => clearTimeout(id));
                this._timeoutIds.clear();
            }
            
            if (this._intervalIds) {
                this._intervalIds.forEach(id => clearInterval(id));
                this._intervalIds.clear();
            }
            
            if (this.debounceTimer) {
                clearTimeout(this.debounceTimer);
                this.debounceTimer = null;
            }
            
            this.maskHistory.clear();
            this.drawHistory.clear();
            
            const collections = [
                'imageIdMap'
            ];
            
            collections.forEach(propName => {
                if (this[propName] && typeof this[propName].clear === 'function') {
                    this[propName].clear();
                } else if (Array.isArray(this[propName])) {
                    this[propName] = [];
                }
            });
            
            this.activeImage = null;
            this.activeImageName = null;
            this.selectedMask = null;
            this.isDrawingMask = false;
            this.isMovingMask = false;
            this.isResizingMask = false;
