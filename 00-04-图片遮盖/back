function DynamicWrapping() {
    const ankiCloze = window.AnkiClozeInstance;
    if (!ankiCloze) return;
    
    const unwrappedImages = document.querySelectorAll('img:not([data-no-cloze]):not([data-cloze-id])');
    if (unwrappedImages.length === 0) return;
    
    const imagesToWrap = Array.from(unwrappedImages).map((img, index) => ({ img, index }));
    ankiCloze.wrapAllImages(imagesToWrap);
}

