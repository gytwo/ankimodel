    const handlemove = (e) => {
        e.preventDefault();
        e.stopPropagation();
        this.startMoveMask();
        return false;
    };
    
    // PC端：点击事件
    moveBtn.addEventListener('click', handlemove);
    
    // 移动端：触摸事件
