function generateOverallStatsHTML(stats) {
    // 计算总图片数
    const totalImages = stats.total.images;
    
    // 计算包装失败数（图片数 - 已包装数）
    const totalWrapFailed = totalImages - stats.total.wrapped;
    const mainPageWrapFailed = stats.mainPage.images - stats.mainPage.wrapped;
    const popupWrapFailed = stats.popup.images - stats.popup.wrapped;
    const noteMarkWrapFailed = stats.noteMark.total - stats.noteMark.wrapped;
    
    return `
