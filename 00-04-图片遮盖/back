}

function showStatisticsError(message) {
    const statisticsContent = document.getElementById('statisticsContent');
    if (!statisticsContent) return;
    statisticsContent.innerHTML = `
    <div style="text-align: center; padding: 40px; color: #FF3B30;">
        <div style="font-size: 48px; margin-bottom: 16px;">❌</div>
        <div style="font-size: 16px; font-weight: 600; margin-bottom: 8px;">统计生成失败</div>
        <div style="font-size: 13px; color: #666; max-width: 300px; margin: 0 auto; line-height: 1.5; margin-bottom: 16px;">
            ${message || '未知错误'}
        </div>
        <button onclick="refreshStatistics()" style="
            background: #4A90E2;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
            ">
            重试刷新
        </button>
    </div>
    `;
}

function updateLastRefreshTime() {
    const timeElement = document.getElementById('lastRefreshTime');
    if (timeElement) {
        timeElement.textContent = new Date().toLocaleTimeString();
    }
}

function initStatistics() {
    setTimeout(() => {
        if (window.AnkiClozeInstance) {
            refreshStatistics();
        }
    }, 2000);
    const observer = new MutationObserver(() => {
        const dataDialog = document.getElementById('dataManagementDialog');
        if (dataDialog && dataDialog.style.display === 'flex') {
            setTimeout(refreshStatistics, 300);
        }
    });
    const dataDialog = document.getElementById('dataManagementDialog');
    if (dataDialog) {
        observer.observe(dataDialog, { attributes: true });
    }
}

window.refreshStatistics = refreshStatistics;
window.initStatistics = initStatistics;

document.addEventListener('keydown', function(e) {
    if (e.ctrlKey && e.shiftKey && e.key === 'S') {
        e.preventDefault();
        const dataDialog = document.getElementById('dataManagementDialog');
        if (dataDialog && dataDialog.style.display === 'flex') {
            refreshStatistics();
        }
    }
});

