    positionNoteEditor(editor, markElement) {
        const rect = markElement.getBoundingClientRect();
        const editorWidth = 460;
        const editorHeight = 460;
        const viewportWidth = window.innerWidth;
        const viewportHeight = window.innerHeight;
        let editorX, editorY;
        if (rect.bottom + editorHeight + 20 < viewportHeight) {
            editorX = rect.left;
            editorY = rect.bottom + 10;
        } else if (rect.top - editorHeight - 20 > 0) {
            editorX = rect.left;
            editorY = rect.top - editorHeight - 10;
        } else {
            editorX = (viewportWidth - editorWidth) / 2;
            editorY = (viewportHeight - editorHeight) / 2;
        }
        editorX = Math.max(10, Math.min(editorX, viewportWidth - editorWidth - 10));
        editorY = Math.max(10, Math.min(editorY, viewportHeight - editorHeight - 10));
        editor.style.left = editorX + 'px';
