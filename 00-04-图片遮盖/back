    clearCurrentImageData() {
    if (!this.activeImage) {
        this.showNotification('请先单击图片激活编辑', 'warning');
        return;
    }
    
    const imgId = this.activeImage;
    const data = this.getCurrentImageData();
    const maskCount = data.masks?.length || 0;
    const drawingCount = data.drawings?.length || 0;
    
    if (maskCount === 0 && drawingCount === 0) {
        this.showNotification('当前图片没有遮罩或涂鸦', 'info');
        return;
    }
    
    try {
        if (maskCount > 0) {
            this.saveMaskHistory(imgId, 'clear_masks', {
                masks: JSON.parse(JSON.stringify(data.masks))
            });
        }
        if (drawingCount > 0) {
            this.saveDrawHistory(imgId, 'clear_drawings', {
                drawings: JSON.parse(JSON.stringify(data.drawings))
            });
        }
        
        const allData = this.storage.getAllData();
        if (allData[imgId]) {
            delete allData[imgId];
            
            const key = `anki-cloze-${this.storage.config.fieldName}`;
            localStorage.setItem(key, JSON.stringify(allData));
        }
        
        if (this.selectedMask) {
            this.selectedMask.classList.remove('selected');
            this.removeMaskControls(this.selectedMask);
            this.selectedMask = null;
        }
        
        this.redrawImage(imgId);
        this.redrawCanvas(imgId);
        
        this.showNotification(`已清空${maskCount}个遮罩和${drawingCount}个涂鸦`, 'success');
    } catch (error) {
        this.showNotification('清空失败', 'error');
    }
},

    clearCurrentData() {
    
    const currentPageImageIds = this.storage.getCurrentPageImageIds();
    
    if (currentPageImageIds.size === 0) {
        this.showNotification('当前卡片没有图片', 'warning');
        return;
    }
    
    const allData = this.storage.getAllData();
    let currentCardImageCount = 0;
    let totalMasks = 0;
    let totalDrawings = 0;
    
    currentPageImageIds.forEach(imgId => {
        const imgData = allData[imgId];
        if (imgData) {
            currentCardImageCount++;
            totalMasks += (imgData.masks && imgData.masks.length) || 0;
            totalDrawings += (imgData.drawings && imgData.drawings.length) || 0;
        }
    });
    
    if (currentCardImageCount === 0) {
        this.showNotification('当前卡片没有图片数据', 'info');
        return;
    }
    
    const confirmationMessage = `确定要清除当前卡片的所有图片数据吗？\n\n` +
        `📊 将清除：\n` +
        `• 当前卡片 ${currentPageImageIds.size} 张图片\n` +
        `• 其中 ${currentCardImageCount} 张有编辑数据\n` +
        `• 包含 ${totalMasks} 个遮罩，${totalDrawings} 个涂鸦\n\n` +
        `⚠️ 此操作无法撤销！`;
    
    if (!confirm(confirmationMessage)) {
        return;
    }
    
        document.querySelectorAll('.cloze-mask-layer').forEach(layer => {
            layer.innerHTML = '';
        });
        
        document.querySelectorAll('.cloze-drawing-layer').forEach(canvas => {
            if (canvas.getContext) {
                canvas.getContext('2d').clearRect(0, 0, canvas.width, canvas.height);
            }
        });

    try {
        let newAllData = { ...allData };
        let deletedCount = 0;
        
        currentPageImageIds.forEach(imgId => {
            if (newAllData[imgId]) {
                delete newAllData[imgId];
                deletedCount++;
                
                this.maskHistory.delete(imgId);
                this.drawHistory.delete(imgId);
                
                const wrapper = this.getWrapperByImgId(imgId);
                if (wrapper) {
                    const maskLayer = wrapper.querySelector('.cloze-mask-layer');
                    const drawLayer = wrapper.querySelector('.cloze-drawing-layer');
                    if (maskLayer) maskLayer.innerHTML = '';
                    if (drawLayer) {
                        const ctx = drawLayer.getContext('2d');
                        ctx.clearRect(0, 0, drawLayer.width, drawLayer.height);
                    }
                }
            }
        });
        
        const key = `anki-cloze-${this.storage.config.fieldName}`;
        localStorage.setItem(key, JSON.stringify(newAllData));
        

        this.showNotification(`已清除当前卡片 ${deletedCount} 张图片的数据`, 'success');
        
        if (this.refreshDataManagement) {
            setTimeout(() => this.refreshDataManagement(), 500);
        }
        
        return true;
        
    } catch (error) {
        this.showNotification(`清除失败: ${error.message}`, 'error');
        return false;
    }
},
    
