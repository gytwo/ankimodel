    };
}

// 1. 将元素提到最前面的函数
function bringElementToFront(element) {
    window.popupZIndex.currentMax += 10;
    element.style.zIndex = window.popupZIndex.currentMax;
}

// 2. 宽松边界检查函数
function ensureElementNotFullyInvisible(element, left, top) {
    const elementWidth = element.offsetWidth;
    const elementHeight = element.offsetHeight;
    const windowWidth = window.innerWidth;
    const windowHeight = window.innerHeight;
    
    let adjustedLeft = left;
    let adjustedTop = top;
    
    if (left >= windowWidth) {
        adjustedLeft = windowWidth - 20;
    } else if (left + elementWidth <= 0) {
        adjustedLeft = -elementWidth + 20;
    }
    
    if (top >= windowHeight) {
        adjustedTop = windowHeight - 20;
    } else if (top + elementHeight <= 0) {
        adjustedTop = -elementHeight + 20;
    }
    
    return {
        left: adjustedLeft,
        top: adjustedTop
    };
}

// 3. 添加缩放功能
function setupResizeFunctionality(element, isSearchBox = false) {
    if (element.querySelector('.resize-handle')) {
