                eraserPreviewVisible = true;
            }
        };
        
        const hideEraserPreview = () => {
            if (this.eraserPreview) {
                this.eraserPreview.classList.remove('visible');
                eraserPreviewVisible = false;
            }
        };
        
        const startDrawing = (e) => {
            const wrapper = canvas.parentElement;
            if (wrapper.classList.contains('review-mode')) {
                return;
            }
            if (!this.activeImage || this.currentLayer !== 'drawing' || this.mode !== 'edit') {
                return;
            }
            if (this.currentTool !== 'pen' && this.currentTool !== 'eraser') {
                return;
            }

            isDrawing = true;
            const rect = canvas.getBoundingClientRect();
            let clientX, clientY;
            if (e.type.includes('touch')) {
                clientX = e.touches[0].clientX;
                clientY = e.touches[0].clientY;
            } else {
                clientX = e.clientX;
                clientY = e.clientY;
            }
            lastX = clientX - rect.left;
            lastY = clientY - rect.top;
            
            if (this.currentTool === 'pen') {
                const data = this.getCurrentImageData();
                const wrapper = canvas.parentElement;
                const img = wrapper.querySelector('img');
                const naturalWidth = img.naturalWidth || rect.width;
                const naturalHeight = img.naturalHeight || rect.height;
                const absolutePos = CoordinateSystem.displayToAbsolute(
                    lastX,
                    lastY,
                    naturalWidth,
                    naturalHeight,
                    rect.width,
                    rect.height
                );
                const naturalRelX = (absolutePos.x / naturalWidth) * 100;
                const naturalRelY = (absolutePos.y / naturalHeight) * 100;
                const newPath = {
                    type: 'pen',
                    color: this.settings.drawColor,
                    size: this.settings.penSize,
                    points: [[naturalRelX, naturalRelY]]
                };
                
                const currentData = data;
                const newDrawings = [...(currentData.drawings || []), newPath];
                const newData = {
                    masks: currentData.masks || [],
                    drawings: newDrawings,
                    note: currentData.note || ''
                };
                
                this.saveDrawHistory(this.activeImage, 'add_drawing', {
                    oldDrawings: currentData.drawings || [],
                    newDrawings: newDrawings
                });
                
                this.saveImageData(this.activeImage, newData);
                
                ctx.beginPath();
                ctx.arc(lastX, lastY, this.settings.penSize / 2, 0, Math.PI * 2);
                ctx.fillStyle = this.settings.drawColor;
                ctx.fill();
            } else if (this.currentTool === 'eraser') {
                createEraserPreview();
                updateEraserPreview(lastX, lastY);
                this.eraseAt(lastX, lastY, imgId);
            }
        };
        
        const draw = (e) => {
            if (!isDrawing) return;
            e.preventDefault();
            const rect = canvas.getBoundingClientRect();
            let clientX, clientY;
            if (e.type.includes('touch')) {
                clientX = e.touches[0].clientX;
                clientY = e.touches[0].clientY;
            } else {
                clientX = e.clientX;
                clientY = e.clientY;
            }
            const x = clientX - rect.left;
            const y = clientY - rect.top;
            
            if (this.currentTool === 'pen') {
                const data = this.getCurrentImageData();
                if (!data || !data.drawings || data.drawings.length === 0) return;
                ctx.beginPath();
                ctx.moveTo(lastX, lastY);
                ctx.lineTo(x, y);
                ctx.strokeStyle = this.settings.drawColor;
                ctx.lineWidth = this.settings.penSize;
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';
                ctx.stroke();
                const wrapper = canvas.parentElement;
                const img = wrapper.querySelector('img');
                const naturalWidth = img.naturalWidth || rect.width;
                const naturalHeight = img.naturalHeight || rect.height;
                const absolutePos = CoordinateSystem.displayToAbsolute(
                    x,
                    y,
                    naturalWidth,
                    naturalHeight,
                    rect.width,
                    rect.height
                );
                const naturalRelX = (absolutePos.x / naturalWidth) * 100;
                const naturalRelY = (absolutePos.y / naturalHeight) * 100;
                
                const currentData = this.getCurrentImageData();
                if (currentData.drawings && currentData.drawings.length > 0) {
                    const lastDrawing = currentData.drawings[currentData.drawings.length - 1];
                    lastDrawing.points.push([naturalRelX, naturalRelY]);
                    
                    this.saveImageData(this.activeImage, currentData);
                }
            } else if (this.currentTool === 'eraser') {
                updateEraserPreview(x, y);
                this.eraseAt(x, y, imgId);
            }
            lastX = x;
            lastY = y;
        };
        
        const stopDrawing = () => {
            if (!isDrawing) return;
            isDrawing = false;
            hideEraserPreview();
            this.redrawCanvas(imgId);
