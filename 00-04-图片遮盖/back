    if (!statisticsContent) return;
    statisticsContent.innerHTML = `
    <div style="text-align: center; padding: 40px; color: #4A90E2;">
        <div style="font-size: 48px; margin-bottom: 16px; animation: spin 1s linear infinite;">🔄</div>
        <div style="font-size: 16px; font-weight: 600; margin-bottom: 8px;">正在分析图片数据...</div>
        <div style="font-size: 13px; color: #666; max-width: 300px; margin: 0 auto; line-height: 1.5;">
            正在统计包装和初始化状态，请稍候
        </div>
        <style>
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        </style>
    </div>
