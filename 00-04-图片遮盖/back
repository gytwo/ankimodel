    generateImageItemHTML(item) {
    const hasMasks = item.maskCount > 0;
    const hasDrawings = item.drawingCount > 0;
    const hasNote = item.note && item.note.trim() !== '';
    const isActive = this.activeImage === item.id;
    const activeClass = isActive ? ' active' : '';
    
    const displayName = hasNote ? item.note : item.id.replace('img-', '');
    
    let badgesHTML = '';
    if (hasMasks) {
        badgesHTML += `<span class="image-badge mask-badge" title="遮罩数量">🎭${item.maskCount}</span>`;
    }
    if (hasDrawings) {
        badgesHTML += `<span class="image-badge drawing-badge"  title="涂鸦数量">🎨${item.drawingCount}</span>`;
    }
    
    const escapedImageName = item.imageName
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    
    return `
    <div class="image-data-item${activeClass}">
    <div class="image-display-name" onclick="commonImageJump('${item.id}', '${item.imageName}')" 
         title="点击跳转到此图片并激活">
        ${displayName}
    </div>
    <div class="image-stats">
        ${badgesHTML}
        <button class="copy-id-btn" data-image-id="${item.id}" onclick="copyImageId(this)" 
