function generateFailedListsHTML(stats) {
    // 内嵌的生成未包装列表函数
    function generateNotWrappedListHTML(notWrappedList, title) {
        if (notWrappedList.length === 0) return '';
        
        let html = `<div class="failed-subcategory" style="margin-top: 12px;">
            <div style="font-size: 12px; color: #666; font-weight: 600; margin-bottom: 8px; padding-left: 5px;">${title}</div>`;
        
        notWrappedList.forEach((item, index) => {
            // 获取图片ID
            let imgId = item.id;
            if (!imgId && window.AnkiClozeInstance && window.AnkiClozeInstance.imageIdMap) {
                imgId = window.AnkiClozeInstance.imageIdMap.get(item.filename);
            }
            if (!imgId) {
                imgId = `img-${item.filename.replace(/\.[^/.]+$/, '')}`;
            }
            
            const displayName = item.filename || item.id || '未知图片';
            const escapedFilename = item.filename ? 
                item.filename.replace(/"/g, '&quot;').replace(/'/g, '&#39;') : '';
            
            html += `
            <div class="failed-item" 
                 onclick="commonImageJump('${imgId}', '${escapedFilename}')"
                 title="点击跳转到此图片${item.opened === false ? '（自动打开NoteMark）' : ''}">
                <div style="flex: 1; min-width: 0;">
                    <div class="failed-id">${imgId}</div>
                </div>
                <div style="display: flex; align-items: center; gap: 5px;">
                    <button class="copy-name-btn" data-image-name="${escapedFilename}" 
                            onclick="copyImageName(this); event.stopPropagation();" 
                            title="点击复制图片名称: ${displayName}">
                        🔗
                    </button>
                </div>
            </div>`;
        });
        
        html += `</div>`;
        return html;
    }
    
    // 计算各分类的未包装图片列表
    const mainPageNotWrapped = [];
    const popupNotWrapped = [];
    const noteMarkNotWrapped = [];
    
    // 1. 主页面未包装列表 = allImages中过滤掉wrappedImages
    if (stats.mainPage.allImages && stats.mainPage.allImages.length > 0) {
        const wrappedSet = new Set(stats.mainPage.wrappedImages.map(img => img.filename || img.id));
        stats.mainPage.allImages.forEach(img => {
            if (!wrappedSet.has(img.filename || img.id)) {
                mainPageNotWrapped.push({
                    ...img
                });
            }
        });
    }
    
    // 2. Popup未包装列表
    if (stats.popup.allImages && stats.popup.allImages.length > 0) {
        const wrappedSet = new Set(stats.popup.wrappedImages.map(img => img.filename || img.id));
        stats.popup.allImages.forEach(img => {
            if (!wrappedSet.has(img.filename || img.id)) {
                popupNotWrapped.push({
                    ...img
                });
            }
        });
    }
    
    // 3. NoteMark未包装列表
    if (stats.noteMark.allImages && stats.noteMark.allImages.length > 0) {
        const wrappedSet = new Set(stats.noteMark.wrappedImages.map(img => img.filename || img.id));
        stats.noteMark.allImages.forEach(img => {
            if (!wrappedSet.has(img.filename || img.id)) {
                noteMarkNotWrapped.push({
                    ...img
                });
            }
        });
    }
    
    const allNotWrappedCount = mainPageNotWrapped.length + popupNotWrapped.length + noteMarkNotWrapped.length;
    
    if (allNotWrappedCount > 0) {
        let html = `
        <div class="stat-group" style="border-left-color: #FF9800; flex-shrink: 0;">
            <div class="stat-group-title">
                <span class="stat-group-title-icon" style="background: #FF9800; flex-shrink: 0;">📦</span>
                <span>未包装列表：共${allNotWrappedCount}张（🏠${mainPageNotWrapped.length}张 🗂️${popupNotWrapped.length}张 📝${noteMarkNotWrapped.length}张）</span>
            </div>
            <div class="failed-list">
        `;
        
        // 主页面未包装列表
        if (mainPageNotWrapped.length > 0) {
            html += generateNotWrappedListHTML(mainPageNotWrapped, '🏠 主页面图片');
        }
        
        // Popup未包装列表
        if (popupNotWrapped.length > 0) {
            html += generateNotWrappedListHTML(popupNotWrapped, '🗂️ Popup图片');
        }
        
        // NoteMark未包装列表
        if (noteMarkNotWrapped.length > 0) {
            html += generateNotWrappedListHTML(noteMarkNotWrapped, '📝 NoteMark图片');
        }
        
        html += `
            </div>
            
            <!-- 说明部分 -->
            <div style="margin-top: 15px; padding: 10px 15px; background: #fff8e1; border-radius: 6px; border: 1px dashed #ffb74d;">
               <div style="font-size: 10px; color: #666; line-height: 1.4;">
                    <div style="color: #FF3B30;">⚠️ 说明：</div>
                    <div>1. 点击图片名称可跳转到对应图片/自动打开图片所在弹窗</div>
                    <div>2. 点击🔗按钮可复制图片文件名</div>
                    <div>3. NoteMark图片会在打开后自动重启包装</div>
                    <div>4. 若点击图片无反应，请点击左上角重启图片系统</div>
                </div>
            </div>
        </div>
        `;
        return html;
    } else {
        return `
        <div class="stat-group" style="border-left-color: #34C759;">
            <div class="stat-group-title">
                <span class="stat-group-title-icon" style="background: #34C759;">✅</span>
                <span>所有图片均已包装</span>
            </div>
            <div style="text-align: center; padding: 20px; color: #34C759;">
                <div style="font-size: 48px; margin-bottom: 10px;">🎉</div>
                <div style="font-size: 14px; font-weight: 600;">所有图片均已成功包装</div>
                <div style="font-size: 12px; color: #666; margin-top: 5px;">
                    总计：${stats.total.images}张图片<br>
                    已包装：${stats.total.wrapped}张
                </div>
            </div>
        </div>
        `;
    }
}



