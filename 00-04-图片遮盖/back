<script>
// 全局可调用的单个<u>标签转换函数
window.convertSingleUnderline = function(uTag) {
    // 跳过已经转换过的
    if (uTag.closest('.cloze-inactive') || uTag.closest('cloze2')) {
        return false;
    }
    
    var parent = uTag.parentNode;
    
    // 跳过script和style
    if (parent.tagName === 'SCRIPT' || parent.tagName === 'STYLE') {
        return false;
    }
    
    // 复用convertUnderlines里面的逻辑
    function genId() {
        return Math.floor(Math.random() * 65536).toString(16).padStart(4, '0');
    }
    
    // 获取当前最大的cloze编号
    var currentNumber = 0;
    document.querySelectorAll('[data-ordinal]').forEach(function(el) {
        var ordinal = parseInt(el.getAttribute('data-ordinal'));
        if (!isNaN(ordinal) && ordinal > currentNumber) {
            currentNumber = ordinal;
        }
    });
    currentNumber++;
    
    var content = uTag.textContent || uTag.innerText;
    var id = genId();
    
    // 创建新元素
    var newSpan = document.createElement('span');
    newSpan.className = 'cloze-inactive';
    newSpan.setAttribute('data-ordinal', currentNumber);
    
    var cloze2_w = document.createElement('cloze2_w');
    cloze2_w.className = 'cz-' + currentNumber;
    cloze2_w.setAttribute('data-cloze-id', id);
    
    var cloze2 = document.createElement('cloze2');
    cloze2.className = 'cz-' + currentNumber + ' czi-' + id;
    cloze2.textContent = content;
    
    // 组装
    newSpan.appendChild(cloze2_w);
    newSpan.appendChild(cloze2);
    
    // 只替换这个u标签
    parent.replaceChild(newSpan, uTag);
    
    // 绑定挖空点击事件
    cloze2.onclick = cloze2_w.onclick = function(event) { 
        toggleCloze(this);
        event.stopPropagation();
     }
    return true;
};
</script>


