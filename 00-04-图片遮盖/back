                            if (current.id && ['popup1', 'popup2', 'popup3', 'popup4', 'note-popup', 'expand-popup', 'reference-popup', 'conclude-popup', 'ankiNoteEditor', 'ankiNotePreview', 'ankiNotesPanel'].includes(current.id)) {
                                if (!this.isPopupVisible(current)) {
