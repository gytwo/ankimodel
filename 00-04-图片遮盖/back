    async initializeImages() {
        try {
            const imgElements = await this.discoverAllImages();
            const allImages = imgElements.map((img, index) => ({ img, index }));
            
            await this.wrapAllImages(allImages);
            this.restoreAllMarks();
            // 移除：this.systemActivated = true;
        } catch (error) {
        }
    },

    restoreAllMarks() {
        try {
            const allData = this.storage.getAllData();
            
            Object.keys(allData).forEach(imgId => {
                if (!imgId.startsWith('img-')) return;
            
                const wrapper = this.getWrapperByImgId(imgId);
                if (!wrapper) return;
            
                if (!wrapper.hasAttribute('data-layers-initialized')) {
                    this.createBasicLayers(wrapper, imgId);
                }
            
                this.redrawImage(imgId);
                this.redrawCanvas(imgId);
            });
        } catch (error) {
        console.error('初始化渲染失败:', error);
    }
},
    
    async discoverAllImages() {
        const allImages = document.querySelectorAll('img:not([data-no-cloze])');
        const imagesArray = Array.from(allImages);
        return imagesArray;
    },
    
    async wrapAllImages(images) {
        const wrapPromises = images.map(({ img, index }) => {
            return new Promise(async (resolve) => {
                try {
                    const imgId = this.generateStableImageId(img);
                    img.dataset.clozeId = imgId;
                    
                    if (img.closest('.cloze-image-wrapper')) {
                        resolve({ success: true, imgId, wrapper: img.closest('.cloze-image-wrapper') });
                        return;
                    }
                    
                    const rect = img.getBoundingClientRect();
                    
                    if (rect.width > 0 && rect.height > 0) {
                        const wrapper = await this.createImageWrapper(img, index);
                        if (wrapper) {
                            resolve({ success: true, imgId, wrapper });
                        } else {
                            resolve({ success: false, imgId, wrapper: null, reason: '立即包装返回null' });
                        }
                    } else {
                        const wrapper = await this.delayedWrap(img, index, imgId);
                        if (wrapper) {
                            resolve({ success: true, imgId, wrapper });
                        } else {
                            resolve({ success: false, imgId, wrapper: null, reason: '延迟包装超时' });
                        }
                    }
                } catch (error) {
                    resolve({ success: false, imgId: null, error: error.message });
                }
            });
        });
        
        await Promise.allSettled(wrapPromises);
    },
    
    async createImageWrapper(img, index) {
        const imgId = img.dataset.clozeId || this.generateStableImageId(img);
        const filename = this.getImageFilename(img);
        
        return new Promise((resolve) => {
            const rect = img.getBoundingClientRect();
            
            const originalParent = img.parentNode;
            const originalNextSibling = img.nextSibling;
            const originalStyle = img.getAttribute('style') || '';
            
            const wrapper = document.createElement('div');
            wrapper.className = 'cloze-image-wrapper';
            
            wrapper.appendChild(img);
            
            if (originalNextSibling) {
                originalParent.insertBefore(wrapper, originalNextSibling);
            } else {
                originalParent.appendChild(wrapper);
            }
            
            if (!img.dataset.clozeId) {
                img.dataset.clozeId = imgId;
            }
            
            if (originalStyle) {
                img.setAttribute('style', originalStyle);
            }
            
            img.style.pointerEvents = 'auto';
            img.style.cursor = 'pointer';
            img.style.userSelect = 'none';
            
            wrapper.dataset.initialWidth = rect.width;
            wrapper.dataset.initialHeight = rect.height;
            wrapper.dataset.displaySize = `${rect.width}x${rect.height}`;
            wrapper.dataset.creationTime = Date.now();
            wrapper.dataset.imgId = imgId;
            
            const handleClick = (e) => {
                e.preventDefault();
                e.stopPropagation();
                this.handleImageClick(imgId);
            };
            
            img.addEventListener('click', handleClick);
            img.addEventListener('touchstart', (e) => {
                if (e.touches.length === 1) {
                    handleClick(e);
                }
            });
            
            if (img.complete && img.naturalHeight > 0) {
                this.imageIdMap.set(filename, imgId);
                resolve(wrapper);
            } else {
                let isResolved = false;
                const timeoutId = setTimeout(() => {
                    if (isResolved) return;
                    
                    isResolved = true;
                    img.removeEventListener('load', onLoad);
                    img.removeEventListener('error', onError);
                    
                    resolve(null);
                }, 5000);
                
                const onLoad = () => {
                    if (isResolved) return;
                    isResolved = true;
                    
                    clearTimeout(timeoutId);
                    this.imageIdMap.set(filename, imgId);
                    
                    img.removeEventListener('load', onLoad);
                    img.removeEventListener('error', onError);
                    
                    resolve(wrapper);
                };
                
                const onError = () => {
                    if (isResolved) return;
                    isResolved = true;
                    
                    clearTimeout(timeoutId);
                    this.imageIdMap.set(filename, imgId);
                    
                    img.removeEventListener('load', onLoad);
                    img.removeEventListener('error', onError);
                    
                    resolve(wrapper);
                };
                
                img.addEventListener('load', onLoad);
                img.addEventListener('error', onError);
            }
        });
    },
    
    async delayedWrap(img, index, imgId) {
        return new Promise((resolve) => {
            const maxAttempts = 30;
            const checkInterval = 100;
            let attempts = 0;
            
            const checkAndCreate = () => {
                attempts++;
                const img = wrapper.querySelector('img');
                if (!img) return;
                
                const imgRect = img.getBoundingClientRect();
                
                if (imgRect.width > 0 && imgRect.height > 0) {
                    this.createBasicLayers(wrapper, imgId);
                    return;
                }
                
                if (attempts >= maxAttempts) {
                    return;
                }
                
                setTimeout(checkAndCreate, checkInterval);
            };
            
            setTimeout(checkAndCreate, 0);
        });
    },
    
    generateStableImageId(imgElement) {
        try {
            const filename = this.getImageFilename(imgElement);
            let cleanName = filename
                .split('?')[0]
                .split('#')[0]
                .split('/')
                .pop()
                .replace(/\.[^/.]+$/, '');
            if (cleanName.length < 3 || /[^a-zA-Z0-9_-]/.test(cleanName)) {
                cleanName = this.generateHash(filename);
            }
            const imageId = `img-${cleanName}`;
            const originalFilename = this.getImageFilename(imgElement);
            this.imageIdMap.set(originalFilename, imageId);
            return imageId;
        } catch (error) {
            const index = Array.from(document.querySelectorAll('img')).indexOf(imgElement);
            return `img-fallback-${index}`;
        }
    },
    
    getImageFilename(imgElement) {
        try {
            const src = imgElement.src || '';
            if (!src) {
                return 'unknown-image';
            }
            const url = new URL(src, window.location.origin);
            const pathname = url.pathname;
            const filename = pathname.split('/').pop() || 'image';
            if (!filename.includes('.')) {
                return filename + '.jpg';
            }
            return filename;
        } catch (error) {
            const src = imgElement.src || '';
            const parts = src.split('/');
            return parts[parts.length - 1] || 'unknown-image';
        }
    },
    
    generateHash(str) {
        let hash = 0;
        for (let i = 0; i < str.length; i++) {
            const char = str.charCodeAt(i);
            hash = ((hash << 5) - hash) + char;
            hash = hash & hash;
        }
        return Math.abs(hash).toString(36).substr(0, 8);
    },
    
    handleImageClick(imgId) {   
        const wrapper = this.getWrapperByImgId(imgId);
        if (!wrapper) {
            return;
        }
        
        this.activateImage(imgId, wrapper);
    },
    
    activateImage(imgId, wrapper) {

        if (this.activeImage && this.activeImage !== imgId) {
            this.deactivateCurrentImage();
        }

        try {
            this.activeImage = imgId;
            this.activeImageName = this.getImageName(imgId);
            
            const img = wrapper.querySelector('img');
            const imgRect = img.getBoundingClientRect();
            const wrapperRect = wrapper.getBoundingClientRect();
            
            if (!wrapper.hasAttribute('data-layers-initialized')) {
                this.createBasicLayers(wrapper, imgId);
            }
            
            this.redrawImage(imgId);
            this.redrawCanvas(imgId);
            
            if (this.globalToolbar) {
                const toolbarTop = wrapperRect.top - 32;
                const safeTop = Math.max(0, toolbarTop);
                this.globalToolbar.style.top = `${safeTop}px`;
                this.globalToolbar.style.left = `${wrapperRect.left}px`;
                this.globalToolbar.style.width = `${wrapperRect.width}px`;
                this.globalToolbar.style.display = 'flex';
                this.globalToolbar.dataset.positionMode =
                    wrapperRect.top < 0 ? 'fixed-top' :
                    safeTop === 0 ? 'adjusted' : 'relative';
                this.setupGlobalToolbarPositioning();
                this.bindGlobalToolbarEvents(imgId);
            }
            
            if (!wrapper.querySelector('.active-label')) {
                this.createActiveLabel(wrapper);
            }
            
            wrapper.classList.add('active');
            this.setLayersInteractive(wrapper, true);
            
            this.switchToReviewMode();
            this.activateCurrentLayer();
            this.activateControlMenu();
            
            const data = this.getImageData(imgId);
            const maskCount = data?.masks?.length || 0;
            const drawingCount = data?.drawings?.length || 0;
            
            const dataSource = this.storage.getImageDataSourceInfo();
            const sourceText = dataSource.displayName;
            
            if (maskCount > 0 || drawingCount > 0) {
                this.showNotification(`已激活图片（${sourceText}），${maskCount}个遮罩，${drawingCount}个涂鸦`, 'success');
            } else {
                this.showNotification(`已激活空白图片（${sourceText}），可以开始编辑`, 'info');
            }
        } catch (error) {
        }
        
        this.refreshDataManagement();
    },
    
    createActiveLabel(wrapper) {
        const label = document.createElement('div');
        label.className = 'active-label';
        label.textContent = '已激活';
        wrapper.appendChild(label);
    },
    
    setupGlobalToolbarPositioning() {
        if (!this.globalToolbar) return;
        
        if (this.cleanupGlobalToolbarPositioning) {
            this.cleanupGlobalToolbarPositioning();
        }
        
        const updateToolbarPosition = () => {
            if (!this.activeImage || !this.globalToolbar) {
                this.globalToolbar.style.display = 'none';
                return;
            }
            
            const wrapper = this.getWrapperByImgId(this.activeImage);
            if (!wrapper) {
                this.globalToolbar.style.display = 'none';
                return;
            }
            
            const popupInfo = this.isImageInPopup(wrapper);
            const isInPopup = popupInfo.inPopup;
            const popup = popupInfo.popup;
            
            if (isInPopup && popup) {
                const isVisible = this.isPopupVisible(popup);
                if (!isVisible) {
                    this.globalToolbar.style.display = 'none';
                    this.deactivateCurrentImage();
                    return;
                }
            }
            
            let targetTop, targetLeft, targetWidth;
            let positionMode;
            
            if (isInPopup && popup) {
                const popupRect = popup.getBoundingClientRect();
                const wrapperRect = wrapper.getBoundingClientRect();
                
                targetTop = Math.max(popupRect.top, wrapperRect.top - 32);
                
                if (wrapperRect.top - 32 < popupRect.top) {
                    targetTop = popupRect.top;
                    positionMode = 'popup-adjusted';
                } else {
                    targetTop = Math.min(wrapperRect.top - 32, popupRect.bottom - 32);
                    positionMode = 'popup-relative';
                }
                
                targetLeft = Math.max(popupRect.left, 
                                    Math.min(wrapperRect.left, 
                                           popupRect.right - wrapperRect.width));
                targetWidth = Math.min(wrapperRect.width, popupRect.right - targetLeft);
                
            } else {
                const wrapperRect = wrapper.getBoundingClientRect();
                const viewportWidth = window.innerWidth;
                const viewportHeight = window.innerHeight;
                
