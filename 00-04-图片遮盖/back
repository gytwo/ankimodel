        maskLayer.addEventListener('touchcancel', handleTouchEnd);
    },
    
    setupDrawingEvents(canvas, imgId) {
        const ctx = canvas.getContext('2d');
        let isDrawing = false;
        let lastX = 0;
        let lastY = 0;
        let eraserPreviewVisible = false;
        
        const createEraserPreview = () => {
            if (this.eraserPreview) {
                this.eraserPreview.remove();
            }
            const wrapper = canvas.parentElement;
            this.eraserPreview = document.createElement('div');
            this.eraserPreview.className = 'eraser-preview';
            wrapper.appendChild(this.eraserPreview);
            const circle = document.createElement('div');
            circle.className = 'eraser-preview-circle';
            this.eraserPreview.appendChild(circle);
        };
        
        const updateEraserPreview = (x, y) => {
            if (!this.eraserPreview) return;
            const radius = this.settings.eraserSize / 2;
            const circle = this.eraserPreview.querySelector('.eraser-preview-circle');
            circle.style.left = x + 'px';
            circle.style.top = y + 'px';
            circle.style.width = this.settings.eraserSize + 'px';
            circle.style.height = this.settings.eraserSize + 'px';
