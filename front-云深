<template id="ak-front"><script>
    /*
     * 【主题色系初始化 — 正面】
     * 在页面最早期运行，防止色系切换闪烁。
     * 正背面各自独立执行此脚本，通过 localStorage (anki_cfg_ 前缀) 共享偏好，
     * 实现翻牌后色系记忆互通。
     */
    (function () {
      /* 定义或复用 ankiStorage 模块（若 CSS 文件已在模板顶部加载则复用，否则在此创建） */
      window.ankiStorage = window.ankiStorage || (function () {
        var P = 'anki_cfg_';
        return {
          setConfig: function (k, v) {
            try { localStorage.setItem(P + k, JSON.stringify(v)); }
            catch (e) { window['_acfg_' + k] = v; }
          },
          getConfig: function (k) {
            try {
              var v = localStorage.getItem(P + k);
              return v !== null ? JSON.parse(v) : undefined;
            } catch (e) { return window['_acfg_' + k]; }
          }
        };
      })();
      /* 读取保存的色系（'1'=象牙笺，'2'=竹露），立即应用主题类，防止闪烁 */
      var saved = window.ankiStorage.getConfig('cardTheme') || '1';
      var h = document.documentElement;
      h.classList.remove('theme-xiangya', 'theme-zhulu');
      h.classList.add(saved === '2' ? 'theme-zhulu' : 'theme-xiangya');
    })();
    </script>
