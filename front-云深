            function navigateMarks(direction) {
                if (totalMarks === 0) return;
    
                if (direction === 'prev') {
                    currentMark = currentMark > 1 ? currentMark - 1 : totalMarks;
                } else {
                    currentMark = currentMark < totalMarks ? currentMark + 1 : 1;
                }
    
                navigateToMark(currentMark);
                updateResults();
            }
    
            function navigateToMark(index) {
                $('mark').removeClass('current');
                var $mark = $('mark').eq(index - 1).addClass('current');
                
                var markOffset = $mark.offset().top;
                var markHeight = $mark.outerHeight();
                var windowHeight = $(window).height();
                
                var scrollTop = markOffset - (windowHeight / 2) + (markHeight / 2);
                
                $('html, body').animate({
                    scrollTop: scrollTop
                }, 200);
            }
    
            $('#prevMark').click(function() {
                navigateMarks('prev');
            });
    
            $('#nextMark').click(function() {
                navigateMarks('next');
            });
    
