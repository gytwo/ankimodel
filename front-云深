                        this.querySelector('.bullet-dot').style.backgroundColor = 'transparent';
                        saveState(index, false);
                    }
                };
            }
        }
    });
    
    function toggleReveal(element) {
    if (!element || !element.classList) {
        return;
    }
    
    var className = element.classList[0];  
    var elements = document.querySelectorAll('.' + className);
    
    for (var i = 0; i < elements.length; i++) {
        if (!(elements[i].tagName.toLowerCase() === 'cloze2' && elements[i].style.display === 'inline')) {
            elements[i].classList.toggle('reveal-cloze2');
        }
    }
    }
    
    function tick() {
    var elements = document.querySelectorAll('cloze2, cloze2_w');
    var allHaveRevealClass = true;
    var hasNonInlineCloze2 = false;
    
    elements.forEach(function(element) {
        var isInlineCloze2 = (element.tagName.toLowerCase() === 'cloze2' && element.style.display === 'inline');
        var isRevealClass = element.classList.contains('reveal-cloze2');
    
        if (!isInlineCloze2) {
            hasNonInlineCloze2 = true;
            if (!isRevealClass) {
                allHaveRevealClass = false;
            }
        }
    });
    
    elements.forEach(function(element) {
        var isInlineCloze2 = (element.tagName.toLowerCase() === 'cloze2' && element.style.display === 'inline');
        var isRevealClass = element.classList.contains('reveal-cloze2');
    
        if (!isInlineCloze2) {
            if (allHaveRevealClass) {
                if (isRevealClass) {
                    element.classList.remove('reveal-cloze2');
                }
            } else {
                if (!isRevealClass) {
                    element.classList.add('reveal-cloze2');
                }
            }
        }
    });
    
    var button = document.querySelector('.custom-button');
    if (button) {
        if (button.textContent === '全隐') {
            button.textContent = '全显';
        } else {
            button.textContent = '全隐';
        }
    }
    }
    
        
              function addMobileClickHandler(selector, callback) {
                  const distanceThreshold = 10;
                  let touchStartPosition = null;
              
                  document.querySelectorAll(selector).forEach(function(element) {
                      element.addEventListener('touchstart', function(event) {
                          const touches = event.touches;
                          if (touches.length === 1) {
                              const touch = touches[0];
                              touchStartPosition = {
                                  x: touch.clientX,
                                  y: touch.clientY
                              };
                          } else {
                              touchStartPosition = null;
                          }
                      });
              
                      element.addEventListener('touchend', function(event) {
                          const changedTouches = event.changedTouches;
                          if (touchStartPosition && changedTouches.length === 1) {
                              const changedTouch = changedTouches[0];
                              const touchEndX = changedTouch.clientX;
                              const touchEndY = changedTouch.clientY;
                              const diffX = Math.abs(touchStartPosition.x - touchEndX);
                              const diffY = Math.abs(touchStartPosition.y - touchEndY);
                              if (diffX < distanceThreshold && diffY < distanceThreshold) {
                                  callback(event);
                              }
                          }
                          touchStartPosition = null;
                      });
