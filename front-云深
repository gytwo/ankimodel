    document.querySelectorAll('.bullet').forEach(function(content, index) {
        var childrenDiv = content.parentElement.querySelector('.children');
        
        if (childrenDiv) {
            let isExpanded = loadState(index);  
            
            if (isExpanded || childrenDiv.querySelector('span.cloze')) {
                childrenDiv.style.display = 'block';  
                content.querySelector('.bullet-dot').style.boxShadow = 'none';
                content.querySelector('.bullet-dot').style.backgroundColor = 'rgb(100, 106, 115)';
            } else {
                childrenDiv.style.display = 'none';  
                content.querySelector('.bullet-dot').style.boxShadow = getCollapsedBulletShadow();
                content.querySelector('.bullet-dot').style.backgroundColor = 'transparent';
            }
    
            /* 移动端（iOS/Android）的 WebView 对 div.onclick 不可靠，
             * 且 innerHTML 被替换后 JS 属性会丢失；改用 touchstart+touchend，
             * 与 addMobileClickHandler 模式一致。桌面端保持 onclick。 */
            if (/webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
                var _bs = null;
                content.addEventListener('touchstart', function(e) {
                    _bs = e.touches.length === 1
                        ? { x: e.touches[0].clientX, y: e.touches[0].clientY } : null;
                });
                content.addEventListener('touchend', function(e) {
                    if (_bs && e.changedTouches.length === 1) {
                        var dx = Math.abs(_bs.x - e.changedTouches[0].clientX);
                        var dy = Math.abs(_bs.y - e.changedTouches[0].clientY);
                        if (dx < 10 && dy < 10) {
                            if (childrenDiv.style.display === 'none') {
                                childrenDiv.style.display = 'block';
                                content.querySelector('.bullet-dot').style.boxShadow = 'none';
                                content.querySelector('.bullet-dot').style.backgroundColor = 'rgb(100, 106, 115)';
                                saveState(index, true);
                            } else {
                                childrenDiv.style.display = 'none';
                                content.querySelector('.bullet-dot').style.boxShadow = getCollapsedBulletShadow();
                                content.querySelector('.bullet-dot').style.backgroundColor = 'transparent';
                                saveState(index, false);
                            }
                        }
                    }
                    _bs = null;
                });
            } else {
                content.onclick = function() {
                    if (childrenDiv.style.display === 'none') {
                        childrenDiv.style.display = 'block';
                        this.querySelector('.bullet-dot').style.boxShadow = 'none';
                        this.querySelector('.bullet-dot').style.backgroundColor = 'rgb(100, 106, 115)';
