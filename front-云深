    });
    
    function addToggleOnClick() {
        var elements = document.querySelectorAll('cloze2_w, cloze2');
        /* 移动端 iOS 对自定义元素的 onclick HTML 属性合成 click 不可靠，
         * 需显式绑定 touch 事件；stopPropagation 防止冒泡触发父级 .cloze，
         * preventDefault 阻止之后合成的 click 避免双重触发。 */
        var isMob = /webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        elements.forEach(function(element) {
            element.setAttribute('onclick', 'toggleReveal(this)');
            if (isMob) {
                var _sp = null;
                element.addEventListener('touchstart', function(e) {
                    _sp = e.touches.length === 1
                        ? { x: e.touches[0].clientX, y: e.touches[0].clientY } : null;
                    e.stopPropagation();
                });
                element.addEventListener('touchend', function(e) {
                    if (_sp && e.changedTouches.length === 1) {
                        var dx = Math.abs(_sp.x - e.changedTouches[0].clientX);
                        var dy = Math.abs(_sp.y - e.changedTouches[0].clientY);
                        if (dx < 10 && dy < 10) {
                            e.preventDefault();
                            toggleReveal(e.currentTarget || e.srcElement);
                        }
                    }
                    _sp = null;
                });
            }
        });
    }
    
    addToggleOnClick();
    
    function optimizeClozeElements(element) {
    if (!element) {
        element = document.body;
    }
    
    let i = 0;
    while (i < element.children.length) {
        const child = element.children[i];
    
        optimizeClozeElements(child);
    
        if (child.tagName && child.tagName.toLowerCase() === 'cloze2') {
            const cloze2_w = child.querySelector('cloze2_w');
            const innerCloze2 = child.querySelector('cloze2:not(cloze2_w)');
    
            if (cloze2_w && innerCloze2) {
                element.insertBefore(cloze2_w, child);
                element.insertBefore(innerCloze2, child);
    
                while (child.firstChild) {
                    element.insertBefore(child.firstChild, child);
                }
    
                child.remove();
                continue;
            }
        }
    
        if (
            child.tagName &&
            child.tagName.toLowerCase() === 'cloze2_w' &&
            i > 0
        ) {
            const prevSibling = element.children[i - 1];
            if (
                prevSibling.tagName &&
                prevSibling.tagName.toLowerCase() === 'cloze2_w' &&
                prevSibling.className === child.className
            ) {
                child.remove();
                continue;
            }
        }
    
        i++;
    }
    }
    
