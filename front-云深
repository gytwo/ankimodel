    <script>
    /* ── toggle：点击 .cloze 切换显示/隐藏，同步控制毛玻璃遮罩 ── */
    function toggle(element) {
        if (!element || !element.getAttribute) {
            return;
        }
        var classNames = element.getAttribute("data-cloze").match(/cz-\d+/);
        var clozeClass = classNames ? classNames[0] : null;
        if (clozeClass) {
            var cloze2Class = 'cloze2.' + clozeClass;
            var virtualElement = document.createElement("div");
            virtualElement.innerHTML = element.getAttribute("data-cloze");
            var clozeContentElement = virtualElement.querySelector(cloze2Class);
            if (clozeContentElement) {
                var clozeContent = clozeContentElement.innerHTML;
                var isCurrentlyRevealed = (element.innerHTML.trim() === clozeContent.trim());
                if (isCurrentlyRevealed) {
                    /* 收回：恢复 [...] 并重建毛玻璃遮罩 */
                    element.innerHTML = '<span class="cloze-placeholder">[...]</span>';
                    var frosted = document.createElement('span');
                    frosted.className = 'cloze-frosted';
                    element.appendChild(frosted);
                } else {
                    /* 展开：显示真实内容，遮罩随 innerHTML 替换自动消失 */
                    element.innerHTML = clozeContent;
                }
            }
        }
    }
    
    document.querySelectorAll('li.node').forEach(function(node) {
    
    var contentDiv = node.querySelector('div.content.mm-editor');
    
    if (contentDiv && contentDiv.textContent.trim().startsWith('例')) {
        
