        });
    
      function saveState(index, isExpanded) {
          const deckNameElement = document.querySelector('.floating');
          if (!deckNameElement) return; 
          const deckName = deckNameElement.textContent.trim();
      
          let allDecksStates = JSON.parse(localStorage.getItem('decksBulletStates')) || {};
          let currentDeckStates = allDecksStates[deckName] || {};
          currentDeckStates[index] = isExpanded;
          allDecksStates[deckName] = currentDeckStates;
          localStorage.setItem('decksBulletStates', JSON.stringify(allDecksStates));
      }
      
        function loadState(index) {
            const deckNameElement = document.querySelector('.floating');
            if (!deckNameElement) return false; 
            const deckName = deckNameElement.textContent.trim();
        
            let allDecksStates = JSON.parse(localStorage.getItem('decksBulletStates')) || {};
            let savedDeckStates = allDecksStates[deckName];
        
            if (!savedDeckStates) {
                return false;
            }
        
            return savedDeckStates[index] || false;
        }
      
      
