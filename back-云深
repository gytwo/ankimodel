<script>
/*
 * AnkiNoteLinker 融合版（iOS / Android / 桌面 兼容）
 *
 * 改动说明（相对原始脚本）：
 *   1. 先做替换，再对比新旧字符串——有变化才写回 innerHTML，
 *      避免无匹配时也触发 DOM 重建，从而保留 .cloze / .bullet 的事件监听器。
 *   2. 若 innerHTML 确实被替换，则立即为容器内新生成的 .cloze 节点
 *      重新绑定事件，逻辑与 setupClozeEvents() 完全一致：
 *      iOS/Android 用 touchstart + touchend，桌面用 click。
 *   3. 将 ||= 改为 = ... || ...，兼容不支持逻辑赋值运算符的旧版 iOS Safari。
 *   4. innerHTML 替换同样会销毁 .bullet 的事件绑定；在此同步重建，
 *      与主初始化代码逻辑完全一致：移动端 touch，桌面 onclick。
 */
var disableLinks = false; // 改为 true 则仅显示文本，移除跳转功能
if (!window.AnkiNoteLinkerIsActive) {
    const renderLinks = function () {
        /* 移动端检测：与模板中 setupClozeEvents() 完全相同的判断条件 */
        var isMobile = /webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        var touchThreshold = 10;

        document.querySelectorAll('.linkRender').forEach(function (element) { // 若自定义了 class，此处同步修改（保留前面的 .）
            var original = element.innerHTML;
            var replaced = original.replace(
                /\[((?:[^\[]|\\\[)*)\|nid(\d{13})\]/g,
                function (match, title, nid) {
                    title = title.replace(/\\\[/g, '[');
                    var link;
                    if (document.documentElement.classList.contains('iphone') ||
                        document.documentElement.classList.contains('ipad')) {
                        link = 'anki://x-callback-url/search?query=nid%3a' + nid;
                    } else {
                        try {
                            /* 用 = ... || ... 代替 ||=，兼容旧版 iOS Safari */
                            window.jsAPI = window.jsAPI || new AnkiDroidJS({ version: '0.0.3', developer: 'github.com/gugutu' });
                            link = 'javascript:window.jsAPI.ankiSearchCard(`nid:' + nid + '`)';
                        } catch (e) {
                            link = "https://ankiuser.net/edit/" + nid + "' target='_blank";
                        }
                    }
                    return disableLinks ? title : "<a href='" + link + "' class='noteLink'>" + title + "</a>";
                }
            );

            /* ── 关键优化：无变化则跳过，不重建 DOM ── */
            if (replaced === original) return;

            element.innerHTML = replaced;

            /*
             * innerHTML 替换后，容器内所有 .cloze 节点都是全新的 DOM 对象，
             * 原本由 setupClozeEvents() 绑定的 touch/click 监听器已丢失。
             * 以下代码按相同策略重新绑定，确保挖空点击在 iOS/Android 正常工作。
             */
            element.querySelectorAll('span.cloze').forEach(function (clozeEl) {
                if (isMobile) {
                    /* 移动端：复用 addMobileClickHandler 的触摸位移检测逻辑 */
                    var startPos = null;
                    clozeEl.addEventListener('touchstart', function (e) {
                        startPos = (e.touches.length === 1)
                            ? { x: e.touches[0].clientX, y: e.touches[0].clientY }
                            : null;
                    });
                    clozeEl.addEventListener('touchend', function (e) {
                        if (startPos && e.changedTouches.length === 1) {
                            var dx = Math.abs(startPos.x - e.changedTouches[0].clientX);
                            var dy = Math.abs(startPos.y - e.changedTouches[0].clientY);
                            if (dx < touchThreshold && dy < touchThreshold) {
                                if (typeof toggle === 'function') toggle(e.currentTarget || e.srcElement);
                            }
                        }
                        startPos = null;
                    });
                } else {
                    /* 桌面端：直接监听 click 事件，与原逻辑一致 */
                    clozeEl.addEventListener('click', function (e) {
                        e.stopPropagation();
                        if (typeof toggle === 'function') toggle(e.currentTarget || e.srcElement);
                    });
                }
            });

            /*
             * innerHTML 替换同样销毁了 .bullet 节点的事件绑定（onclick 是 JS 属性，
             * 序列化为字符串时不保留）。以下按主初始化代码完全相同的逻辑重建：
             * 移动端用 touch，桌面用 onclick。
             * .linkRender 包裹了全部内容，容器内 bullet 本地索引 === 全局索引，
             * 可直接传入 saveState / getCollapsedBulletShadow。
             */
            element.querySelectorAll('.bullet').forEach(function (bContent, bIdx) {
                var bCh = bContent.parentElement.querySelector('.children');
                if (!bCh) return;
                if (isMobile) {
                    var bs = null;
                    bContent.addEventListener('touchstart', function (e) {
                        bs = e.touches.length === 1
                            ? { x: e.touches[0].clientX, y: e.touches[0].clientY } : null;
                    });
                    bContent.addEventListener('touchend', function (e) {
                        if (bs && e.changedTouches.length === 1) {
                            var dx = Math.abs(bs.x - e.changedTouches[0].clientX);
                            var dy = Math.abs(bs.y - e.changedTouches[0].clientY);
                            if (dx < touchThreshold && dy < touchThreshold) {
                                if (bCh.style.display === 'none') {
                                    bCh.style.display = 'block';
                                    bContent.querySelector('.bullet-dot').style.boxShadow = 'none';
                                    bContent.querySelector('.bullet-dot').style.backgroundColor = 'rgb(100, 106, 115)';
                                    if (typeof saveState === 'function') saveState(bIdx, true);
                                } else {
                                    bCh.style.display = 'none';
                                    bContent.querySelector('.bullet-dot').style.boxShadow =
                                        typeof getCollapsedBulletShadow === 'function'
                                        ? getCollapsedBulletShadow()
                                        : '0 0 0 2px rgb(100, 106, 115), 0 0 0 4px rgb(200, 200, 200)';
                                    bContent.querySelector('.bullet-dot').style.backgroundColor = 'transparent';
                                    if (typeof saveState === 'function') saveState(bIdx, false);
                                }
                            }
                        }
                        bs = null;
                    });
                } else {
                    bContent.onclick = (function (cnt, ch, idx) {
                        return function () {
                            if (ch.style.display === 'none') {
                                ch.style.display = 'block';
                                cnt.querySelector('.bullet-dot').style.boxShadow = 'none';
                                cnt.querySelector('.bullet-dot').style.backgroundColor = 'rgb(100, 106, 115)';
                                if (typeof saveState === 'function') saveState(idx, true);
                            } else {
                                ch.style.display = 'none';
                                cnt.querySelector('.bullet-dot').style.boxShadow =
                                    typeof getCollapsedBulletShadow === 'function'
                                    ? getCollapsedBulletShadow()
                                    : '0 0 0 2px rgb(100, 106, 115), 0 0 0 4px rgb(200, 200, 200)';
                                cnt.querySelector('.bullet-dot').style.backgroundColor = 'transparent';
                                if (typeof saveState === 'function') saveState(idx, false);
                            }
                        };
                    })(bContent, bCh, bIdx);
                }
            });

            /* innerHTML 替换同样销毁了 cz-* 类元素（cloze2_w / cloze2）的 click / touch 事件。
             * 桌面端重建 click；移动端重建 touch 事件。
             * stopPropagation 防冒泡，preventDefault 防合成 click 与 onclick 属性双重触发。 */
            element.querySelectorAll('[class^="cz-"]').forEach(function (el) {
                el.addEventListener('click', function (e) {
                    e.stopPropagation();
                    if (typeof toggleReveal === 'function') toggleReveal(e.currentTarget || e.srcElement);
                });
                if (isMobile) {
                    var _sp = null;
                    el.addEventListener('touchstart', function (e) {
                        _sp = e.touches.length === 1
                            ? { x: e.touches[0].clientX, y: e.touches[0].clientY } : null;
                        e.stopPropagation();
                    });
                    el.addEventListener('touchend', function (e) {
                        if (_sp && e.changedTouches.length === 1) {
                            var dx = Math.abs(_sp.x - e.changedTouches[0].clientX);
                            var dy = Math.abs(_sp.y - e.changedTouches[0].clientY);
                            if (dx < 10 && dy < 10) {
                                e.preventDefault();
                                if (typeof toggleReveal === 'function') toggleReveal(e.currentTarget || e.srcElement);
                            }
                        }
                        _sp = null;
                    });
                }
            });
        });
    };

    document.readyState !== 'loading'
        ? renderLinks()
        : document.addEventListener('DOMContentLoaded', renderLinks, { once: true });
}
