      const annotationLinks = document.querySelectorAll('a[href^="#_msocom_"]');
    
      annotationLinks.forEach(link => {
        const match = link.getAttribute('href').match(/#_msocom_(\d+)/);
        if (!match) return;
    
        const tooltipId = `tooltip-${match[1]}`;
        const tooltip = document.getElementById(tooltipId);
    
        if (!tooltip) {
          return;
        }
    
        
        link.onclick = function(event) {
          event.preventDefault(); 
          event.stopPropagation(); 
    
          
          if (currentTooltip) {
            if (currentTooltip === tooltip) {
              currentTooltip.style.display = 'none';
              currentTooltip = null;
            } else {
              currentTooltip.style.display = 'none';
              tooltip.style.display = 'block';
              currentTooltip = tooltip;
            }
          } else {
            tooltip.style.display = 'block';
            currentTooltip = tooltip;
          }
    
          
          const rect = link.getBoundingClientRect();
          tooltip.style.position = 'absolute';
          tooltip.style.left = `${rect.left}px`;
          tooltip.style.top = `${rect.bottom + window.scrollY}px`;
    
          
          const tooltipRect = tooltip.getBoundingClientRect();
          const viewportWidth = document.documentElement.clientWidth; 
    
          if (tooltipRect.right > viewportWidth) {
            const overflow = tooltipRect.right - viewportWidth;
            tooltip.style.left = `${rect.left - overflow}px`; 
          }
        };
      });
    
      
      document.addEventListener('click', function(event) {
        handleTooltipClick(event);
      });
    
      document.addEventListener('touchstart', function(event) {
        handleTooltipClick(event);
      });
    
      function handleTooltipClick(event) {
        
        if (currentTooltip && !currentTooltip.contains(event.target) && !event.target.closest('a[href^="#_msocom_"]')) {
          currentTooltip.style.display = 'none';
          currentTooltip = null;
        }
      }
    }
    
    
