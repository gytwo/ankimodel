    // 为tooltip中的图片添加悬停放大功能
    function setupTooltipImageHover(tooltip) {
      const images = tooltip.querySelectorAll('img');
      
      images.forEach(img => {
        let isEnlarged = false;
        
        // 桌面设备的鼠标悬停事件
        img.addEventListener('mouseenter', function() {
          // 检查tooltip是否已显示
          if (tooltip.style.display === 'block') {
            tooltip.classList.add('enlarged');
            isEnlarged = true;
          }
        });
        
        img.addEventListener('mouseleave', function() {
          tooltip.classList.remove('enlarged');
          isEnlarged = false;
        });
        
        // 移动设备点击事件支持
        img.onclick = function(e) {
          isEnlarged = !isEnlarged;
          if (isEnlarged) {
            img.classList.add('enlarged');
          } else {
            img.classList.remove('enlarged');
          }
          e.preventDefault();
          e.stopPropagation();
        };
        
  
        
  
        
        // 当tooltip关闭时重置放大状态
        const observer = new MutationObserver(function(mutations) {
          mutations.forEach(function(mutation) {
            if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
              if (tooltip.style.display === 'none') {
                isEnlarged = false;
              }
            }
          });
        });
        
        observer.observe(tooltip, {
          attributes: true,
          attributeFilter: ['style']
        });
      });
    }
    
    function processCardContent() {
      
      let tooltipCounter = 0;
      let currentTooltip = null;
    
      
      const existingTooltips = document.querySelectorAll('.tooltip');
      existingTooltips.forEach(tooltip => tooltip.remove());
    
      
      const aTags = document.querySelectorAll('a:not([href])');
    
      aTags.forEach((aTag, index) => {
    
        const textContent = aTag.textContent.trim();
        const hasChildElements = aTag.children.length > 0;
    
        if (textContent === "" && !hasChildElements) {
    
          let nextElement = aTag.nextSibling;
          let pureHtmlContent = "";
    
          while (nextElement) {
            if (nextElement.nodeType === 3 && nextElement.textContent.trim()) {
              pureHtmlContent += nextElement.textContent.trim() + " ";
            } else if (nextElement.nodeType === 1) {
              pureHtmlContent += nextElement.outerHTML;
            }
            nextElement = nextElement.nextSibling;
          }
    
          pureHtmlContent = pureHtmlContent.trim();
    
          
          const linkPattern = /<a href="#_msoanchor_\d+">.*?\[☁️\d+\].*?<\/a>/g;
          pureHtmlContent = pureHtmlContent.replace(linkPattern, '');
    
          
          pureHtmlContent = pureHtmlContent.replace(/&nbsp;/g, '');
    
          if (pureHtmlContent) {
    
            
            const tooltip = document.createElement('div');
            tooltip.className = 'tooltip';
            tooltip.id = `tooltip-${++tooltipCounter}`;
            tooltip.innerHTML = pureHtmlContent;
            document.body.appendChild(tooltip);
            
            // 为tooltip中的图片添加悬停放大功能
            setupTooltipImageHover(tooltip);
          }
    
          
          const parentElement = aTag.parentElement;
          if (parentElement) {
            parentElement.style.display = 'none';
          }
        }
