            }
  document.querySelectorAll('li.node').forEach(function(node) {
      
      var contentDiv = node.querySelector('div.content.mm-editor');
      
      if (contentDiv && contentDiv.textContent.trim().startsWith('例')) {
          
          // 检查是否有有效的兄弟节点（note mm-editor、包含图片、或image-list/image-item类型）
          var hasValidSibling = false;
          var nextSibling = contentDiv.nextElementSibling;
          
          while (nextSibling) {
              // 可能一：存在 note mm-editor 类型的兄弟节点
              if (nextSibling.classList && nextSibling.classList.contains('note') && nextSibling.classList.contains('mm-editor')) {
                  hasValidSibling = true;
                  break;
              }
              // 可能二：兄弟节点中存在图片
              if (nextSibling.querySelector && nextSibling.querySelector('img')) {
                  hasValidSibling = true;
                  break;
              }
              // 可能三：兄弟节点是image-list或image-item类型
              if (nextSibling.classList && (nextSibling.classList.contains('image-list') || nextSibling.classList.contains('image-item'))) {
                  hasValidSibling = true;
                  break;
              }
              nextSibling = nextSibling.nextElementSibling;
          }
          
          // 当存在有效的兄弟节点时才添加可伸缩功能
          if (hasValidSibling) {
              var childrenWrapper = document.createElement('div');
              childrenWrapper.classList.add('children');
  
              var nextSibling = contentDiv.nextElementSibling;
              while (nextSibling) {
                  
                  childrenWrapper.appendChild(nextSibling);
