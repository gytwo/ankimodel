       Button 10 L3      → 定位到当前挖空
       Button 11 R3      → 色系切换
       左摇杆 Y 轴       → 上下滚动页面（比例速度，含死区）
       右摇杆 Y 轴       → 页面缩放（上拨放大，下拨缩小） */
    var gpMap = {
      0:  function () { triggerEase(1); },
      1:  function () { triggerEase(3); },
      2:  function () { triggerEase(2); },
      3:  function () { triggerEase(4); },
      4:  function () { hideLastCloze(); },
      5:  function () { revealNextCloze(); },
      6:  function () { toggleExpandCollapse(); },
      7:  function () { if (typeof tick === 'function') tick(); },
      10: function () { if (typeof scrollToElement === 'function') scrollToElement(); },
      11: function () { if (typeof toggleTheme === 'function') toggleTheme(); }
    };
  
    /* 取消上一轮轮询（翻牌时旧循环仍在运行，不取消会双重触发） */
    if (typeof window.ankiGamepadPollId !== 'undefined') {
      cancelAnimationFrame(window.ankiGamepadPollId);
    }
  
    /* 摇杆参数 */
    var STICK_DEADZONE   = 0.25;
    var STICK_SCROLL_SPD = 10;
    var ZOOM_SPEED       = 0.005;
    var ZOOM_MIN         = 0.3;
    var ZOOM_MAX         = 3.0;
  
    function pollGamepad() {
      /* 若本侧已触发评分，停止调度，让下一侧接管 */
      if (gamepadShouldStop) return;
      var gamepads = navigator.getGamepads();
      for (var gi = 0; gi < gamepads.length; gi++) {
        var gp = gamepads[gi];
        if (!gp) continue;
  
        /* ── 按钮事件（边沿检测 + 防抖） ── */
        for (var idx in gpMap) {
          var btn = gp.buttons[idx];
          var pressed = btn && (btn.pressed || btn.value > 0.5);
          var now = Date.now();
          if (pressed && !gpWasPressed[idx] &&
              (now - (gpLastFire[idx] || 0)) >= GP_DEBOUNCE_MS) {
            gpMap[idx]();
            gpLastFire[idx] = now;
          }
          gpWasPressed[idx] = pressed;
        }
  
        if (gp.axes) {
          /* ── 左摇杆 Y 轴（axes[1]）→ 滚动页面：-1=上，+1=下 ── */
          if (gp.axes.length > 1 && Math.abs(gp.axes[1]) > STICK_DEADZONE) {
            window.scrollBy(0, gp.axes[1] * STICK_SCROLL_SPD);
          }
  
          /* ── 右摇杆 Y 轴（axes[3]）→ 缩放页面：-1=上=放大，+1=下=缩小 ── */
          if (gp.axes.length > 3 && Math.abs(gp.axes[3]) > STICK_DEADZONE) {
            var curZoom = parseFloat(document.body.style.zoom) || 1;
            var newZoom = curZoom - gp.axes[3] * ZOOM_SPEED;
            newZoom = Math.max(ZOOM_MIN, Math.min(ZOOM_MAX, newZoom));
            document.body.style.zoom = newZoom;
          }
        }
      }
      window.ankiGamepadPollId = requestAnimationFrame(pollGamepad);
    }
  
    /* 预填当前按钮状态：防止翻牌时仍按住的按钮在新循环启动后立刻重触发 */
    var _initGps = navigator.getGamepads();
    for (var _ig = 0; _ig < _initGps.length; _ig++) {
      if (!_initGps[_ig]) continue;
      _initGps[_ig].buttons.forEach(function (b, idx) {
        if (b && (b.pressed || b.value > 0.5)) gpWasPressed[idx] = true;
      });
    }
  
  window.ankiGamepadPollId = requestAnimationFrame(pollGamepad);
})();
