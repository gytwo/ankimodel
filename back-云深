  }
  
var czElements = document.querySelectorAll('[class^="cz-"]');
/* 移动端 iOS 对自定义元素 click 合成不可靠，需显式 touch 事件；
 * stopPropagation 防冒泡到父级，preventDefault 阻止合成 click 防双重触发。 */
var _czIsMob = /webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

czElements.forEach(function(element) {
    element.addEventListener('click', function(event) {
        
        event.stopPropagation();
        
        var clickedElement = event.currentTarget; 
        toggleReveal(clickedElement);
    });
    if (_czIsMob) {
        var _czSp = null;
        element.addEventListener('touchstart', function(e) {
            _czSp = e.touches.length === 1
                ? { x: e.touches[0].clientX, y: e.touches[0].clientY } : null;
            e.stopPropagation();
        });
        element.addEventListener('touchend', function(e) {
            if (_czSp && e.changedTouches.length === 1) {
                var dx = Math.abs(_czSp.x - e.changedTouches[0].clientX);
                var dy = Math.abs(_czSp.y - e.changedTouches[0].clientY);
                if (dx < 10 && dy < 10) {
                    e.preventDefault();
                    toggleReveal(e.currentTarget || e.srcElement);
                }
            }
            _czSp = null;
        });
    }
});
       
       
      
      
      function addMobileClickHandler(selector, callback) {
          const distanceThreshold = 10;
          let touchStartPosition = null;
      
          document.querySelectorAll(selector).forEach(function(element) {
              element.addEventListener('touchstart', function(event) {
                  const touches = event.touches;
                  if (touches.length === 1) {
                      const touch = touches[0];
                      touchStartPosition = {
                          x: touch.clientX,
                          y: touch.clientY
                      };
                  } else {
                      touchStartPosition = null;
                  }
              });
      
              element.addEventListener('touchend', function(event) {
                  const changedTouches = event.changedTouches;
                  if (touchStartPosition && changedTouches.length === 1) {
                      const changedTouch = changedTouches[0];
                      const touchEndX = changedTouch.clientX;
                      const touchEndY = changedTouch.clientY;
                      const diffX = Math.abs(touchStartPosition.x - touchEndX);
                      const diffY = Math.abs(touchStartPosition.y - touchEndY);
                      if (diffX < distanceThreshold && diffY < distanceThreshold) {
                          callback(event);
                      }
                  }
                  touchStartPosition = null;
              });
          });
      }
  
      
      function setupClozeEvents() {
          if (/webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
              
              addMobileClickHandler('.cloze', function(event) {
                  toggle(event.target || event.srcElement);
              });
          } else {
              
              document.querySelectorAll('.cloze').forEach(function(element) {
                  element.addEventListener('click', function(event) {
                      toggle(event.target || event.srcElement);
                  });
              });
          }
      }
      
      
      setupClozeEvents();
        
  
  
   function tick() {
      var elements = document.querySelectorAll('cloze2, cloze2_w');
      var allHaveRevealClass = true;
      var hasNonInlineCloze2 = false;
  
      elements.forEach(function(element) {
          var isInlineCloze2 = (element.tagName.toLowerCase() === 'cloze2' && element.style.display === 'inline');
          var isRevealClass = element.classList.contains('reveal-cloze2');
  
          if (!isInlineCloze2) {
              hasNonInlineCloze2 = true;
              if (!isRevealClass) {
                  allHaveRevealClass = false;
              }
          }
      });
  
      elements.forEach(function(element) {
          var isInlineCloze2 = (element.tagName.toLowerCase() === 'cloze2' && element.style.display === 'inline');
          var isRevealClass = element.classList.contains('reveal-cloze2');
  
          if (!isInlineCloze2) {
              if (allHaveRevealClass) {
                  if (isRevealClass) {
                      element.classList.remove('reveal-cloze2');
                  }
              } else {
                  if (!isRevealClass) {
                      element.classList.add('reveal-cloze2');
                  }
              }
          }
      });
  
        
      var button = document.querySelector('.custom-button');
      if (button) {
          if (button.textContent === '全隐') {
              button.textContent = '全显';
          } else {
              button.textContent = '全隐';
          }
      }
  }
  
    
    
    
      
      setTimeout(function () {
          var clozeBoxes = document.querySelector('.cloze cloze2_w');
          if (clozeBoxes) {
              document.querySelectorAll('cloze2.' + clozeBoxes.className).forEach(function(element) {
                  element.style.display = 'inline';
              });
          }
      }, 0);
     
     
   
      function saveState(index, isExpanded) {
          
          const deckNameElement = document.querySelector('.floating');
          if (!deckNameElement) return; 
          const deckName = deckNameElement.textContent.trim();
      
          
          let allDecksStates = JSON.parse(localStorage.getItem('decksBulletStates')) || {};
      
          
          let currentDeckStates = allDecksStates[deckName] || {};
      
          
          currentDeckStates[index] = isExpanded;
      
          
          allDecksStates[deckName] = currentDeckStates;
      
          
          localStorage.setItem('decksBulletStates', JSON.stringify(allDecksStates));
      }
    
  
        function loadState(index) {
          
            const deckNameElement = document.querySelector('.floating');
            if (!deckNameElement) return false; 
            const deckName = deckNameElement.textContent.trim();
        
          
            let allDecksStates = JSON.parse(localStorage.getItem('decksBulletStates')) || {};
        
          
            let savedDeckStates = allDecksStates[deckName];
        
          
            if (!savedDeckStates) {
                return false;
            }
        
          
            return savedDeckStates[index] || false;
        }
    
    
