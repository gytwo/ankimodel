  /* =====================================
    填空样式【多卡多空cloze,cloze2】 
    ===================================== */

  /* 隐藏的挖空切换器 */
  .cloze2-toggle { 
      display: none; 
  }

  /* 磨砂遮罩层（挖空未揭示时的毛玻璃效果） */
  .cloze-frosted {
    position: absolute;
    inset: 0;
    border-radius: 0.5em;
    backdrop-filter: blur(var(--frosted-blur));
    -webkit-backdrop-filter: blur(var(--frosted-blur));
    background-color: var(--frosted-bg);
    pointer-events: none;
    z-index: 101;
    line-height: 1.6em;
  }

  /* 主要挖空容器样式 */
  .cloze {
      display: inline-block;
      max-width: 100%; /* 防止元素超出父容器宽度 */
      box-sizing: border-box; /* 确保 padding 和 border 不会增加元素的总宽度 */
      background-color: var(--cloze-bg);
      padding: 0.1em 0.3em;
      border: 0.1em solid var(--cloze-border);
      border-radius: 0.5em;
      box-shadow: 0px 1px 3px rgba(255, 255, 255, 0.5);
      cursor: pointer;
      line-height: 1.2em;
      position: relative; /* 确保元素是相对定位，便于 z-index 生效 */
      z-index: 100;
  }

/* 挖空容器滚动条样式 */
  .cloze::-webkit-scrollbar {
      display: block; /* 覆盖全局的 display: none，以显示滚动条 */
      height: 4px; /* 设置水平滚动条高度，使其更纤细 */
  }

  .cloze::-webkit-scrollbar-track {
     // background: rgba(0, 0, 0, 0.1); /* 滚动条轨道颜色 */
      background: var(--cloze-track);
      border-radius: 4px;
  }

  .cloze::-webkit-scrollbar-thumb {
     // background: rgba(0, 0, 0, 0.4); /* 滚动条滑块颜色 */
      background: var(--cloze-thumb);
      border-radius: 4px;
  }

  .cloze::-webkit-scrollbar-thumb:hover {
     // background: rgba(0, 0, 0, 0.6); /* 鼠标悬停时滑块颜色 */
     background: var(--cloze-thumb-hover);
  }

 
 /* ========== 关键修复：.cloze内的cloze2应该显示 ========== */

/* .cloze容器内的cloze2应该显示，其他隐藏 */
.cloze cloze2 {
    visibility: visible;
    opacity: 1;
    overflow: visible;
    display: inline;
}

/* .cloze容器内的cloze2_w应该隐藏 */
.cloze cloze2_w {
    visibility: hidden;
    opacity: 0;
    overflow: hidden;
    display: inline-block;

}

/* ========== 非.cloze内的cloze2显示控制 ========== */

/* 隐藏状态 - 使用visibility而不是display */
cloze2:not(.reveal-cloze2):not(.cloze cloze2) {
    visibility: hidden;
    opacity: 0;
    overflow: hidden;
    display: inline-block;
    position: relative;
    width: 0.1px;
    height: 0.1px;
}

cloze2_w:not(.reveal-cloze2):not(.cloze cloze2_w) {
    /* cloze2_w占位符应该显示 */
    display: inline-block;
    visibility: visible;
    opacity: 1;
    position: relative;
}

/* 显示状态 */
cloze2.reveal-cloze2:not(.cloze cloze2) {
    visibility: visible;
    opacity: 1;
    overflow: visible;
    display: inline-block;
    border: 0.1em solid var(--reveal-border);
    background-color: var(--reveal-bg);
    padding-left: 0.3em;
    padding-right: 0.3em;
    cursor: pointer;
    border-radius: 0.3em;
    line-height: 1.4em;
    position: relative;
    z-index: 101;
    width: auto;
    height: auto;
}

cloze2_w.reveal-cloze2:not(.cloze cloze2_w) {
    /* 当显示答案时，占位符完全隐藏 */
    visibility: hidden;
    opacity: 0;
    overflow: hidden;
    display: inline-block;
    width: 0.1px;
    height: 0.1px;
}



/* 占位符样式 */
cloze2_w:not(.cloze cloze2_w)::before {
	content: "~~"; /* 设置伪元素的内容为≈符号 */
  cursor: pointer;
  color: var(--cloze2_w-color);
	font-size: 1.5em; /* 设置伪元素的文本大小为原来的1.5倍 */
	position: relative;
	z-index: 101;
  visibility: visible;
  opacity: 1;
  display: inline-block;
}

/* 当显示答案时，隐藏占位符的伪元素 */
cloze2_w.reveal-cloze2:not(.cloze cloze2_w)::before {
    visibility: hidden;
    opacity: 0;
}

.nightMode cloze2_w::before {
	color:#9ec9f3;
}

.nightMode cloze2.reveal-cloze2 {
	  border: 0.1em solid #9ec9f3; /* 使用淡蓝色虚线边框 */
    background-color: #333333; /* 设置背景颜色 */
   	color:black;
	  cursor: pointer;
}
  /* =====================================
    数学公式样式优化
    ===================================== */
    /* 包含数学公式的挖空容器特殊设置 */
  .cloze:has(math, mfrac, msub, msup, msubsup, mrow, mi, mo, mn, semantics) {
      overflow-x: auto; /* 包含数学元素时启用水平滚动条 */
      overflow-y: hidden; /* 确保不显示垂直滚动条 */
      vertical-align: -0.45em; /* 真挖空容器大幅向下调整，与文字对齐 */
  }


  /* 已揭示挖空的数学公式处理 */
  cloze2.reveal-cloze2:has(math, mfrac, msub, msup, msubsup, mrow, mi, mo, mn, semantics) {
      overflow-x: auto;
      overflow-y: hidden;
      vertical-align: -0.45em;
  }

  /* 兼容性类名方案 */
  .cloze.has-math,
  cloze2.reveal-cloze2.has-math {
      overflow-x: auto;
      overflow-y: hidden;
      vertical-align: -0.45em;
  }

  /* 已揭示挖空的滚动条样式 */
  cloze2.reveal-cloze2::-webkit-scrollbar {
      display: block;
      height: 4px;
  }

  cloze2.reveal-cloze2::-webkit-scrollbar-track {
     // background: rgba(0, 0, 0, 0.1);
      background: var(--reveal-track);
      border-radius: 4px;
  }

  cloze2.reveal-cloze2::-webkit-scrollbar-thumb {
     // background: rgba(0, 0, 0, 0.4);
      background: var(--reveal-thumb);
      border-radius: 4px;
  }

  cloze2.reveal-cloze2::-webkit-scrollbar-thumb:hover {
        background: var(--reveal-thumb-hover);
     // background: rgba(0, 0, 0, 0.6);
  }


  /* 数学公式中分数和角标的大小调整 */
  cloze2.reveal-cloze2 mfrac > *,
  cloze2.reveal-cloze2 msub > *:nth-child(2),
  cloze2.reveal-cloze2 msup > *:nth-child(2),
  cloze2.reveal-cloze2 msubsup > *:nth-child(n+2) {
      font-size: 0.9em;
  }

  .cloze mfrac > *,
  .cloze msub > *:nth-child(2),
  .cloze msup > *:nth-child(2),
  .cloze msubsup > *:nth-child(n+2) {
      font-size: 0.9em;
  }

  /* 数学括号自动伸缩样式 - 智能版本 */
  mo[fence="true"] {
      font-size: inherit; /* 继承父元素字体大小 */
      line-height: 0.7; /* 紧凑的行高 */
      vertical-align: middle; /* 垂直居中对齐 */
      display: inline-block; /* 确保变换生效 */
      margin: 0 0.1em; /* 左右留小间距 */
  }

  /* 根据表格行数自动调整括号大小 */
  /* 2行表格 */
  mrow:has(mtable mtr:nth-child(2):last-child) > mo[fence="true"] {
      font-size: 1.8em;
      transform: scaleY(1.2);
      transform-origin: center;
  }

  /* 3行表格 */
  mrow:has(mtable mtr:nth-child(3):last-child) > mo[fence="true"] {
      font-size: 2.4em;
      transform: scaleY(1.4);
      transform-origin: center;
  }

  /* 4行表格 */
  mrow:has(mtable mtr:nth-child(4):last-child) > mo[fence="true"] {
      font-size: 3em;
      transform: scaleY(1.6);
      transform-origin: center;
  }

  /* 5行表格 */
  mrow:has(mtable mtr:nth-child(5):last-child) > mo[fence="true"] {
      font-size: 3.6em;
      transform: scaleY(1.8);
      transform-origin: center;
  }

  /* 6行及以上表格 */
  mrow:has(mtable mtr:nth-child(n+6)) > mo[fence="true"] {
      font-size: 4.2em;
      transform: scaleY(2);
      transform-origin: center;
  }


