.stat-group.main-page .stat-group-title-icon {
background: #34C759;
}

.stat-group.popup {
border-left-color: #FF9500;
background: linear-gradient(135deg, rgba(255, 149, 0, 0.05), rgba(255, 149, 0, 0.02));
}
.stat-group.popup .stat-group-title {
color: #FF9500;
}
.stat-group.popup .stat-group-title-icon {
background: #FF9500;
}

.stat-group.total {
border-left-color: #5856D6;
background: linear-gradient(135deg, rgba(88, 86, 214, 0.05), rgba(88, 86, 214, 0.02));
}
.stat-group.total .stat-group-title {
color: #5856D6;
}
.stat-group.total .stat-group-title-icon {
background: #5856D6;
}

/* 统计网格 */
.stats-grid {
display: grid;
grid-template-columns: repeat(5, 1fr);
gap: 12px;
margin-top: 15px;
}

.stat-card {
background: #f8f9fa;
border-radius: 8px;
padding: 14px;
text-align: center;
border: 1px solid #e9ecef;
transition: all 0.2s ease;
cursor: pointer;
min-height: 80px;
display: flex;
flex-direction: column;
justify-content: center;
}

.stat-card:hover {
transform: translateY(-2px) scale(1.02);
box-shadow: 0 5px 15px rgba(0,0,0,0.15);
}

.stat-card-count {
font-size: 22px;
font-weight: 800;
margin-bottom: 6px;
transition: all 0.3s ease;
}

.stat-card-label {
font-size: 11px;
color: #666;
font-weight: 600;
text-transform: uppercase;
letter-spacing: 0.5px;
}

.stat-card.blank {
border-top: 3px solid #8E8E93;
background: linear-gradient(135deg, #f8f9fa, #e9ecef);
}
.stat-card.blank .stat-card-count { color: #8E8E93; }

.stat-card.with-data {
border-top: 3px solid #34C759;
background: linear-gradient(135deg, rgba(52, 199, 89, 0.1), rgba(52, 199, 89, 0.05));
}
.stat-card.with-data .stat-card-count { color: #34C759; }

.stat-card.wrapped {
border-top: 3px solid #4A90E2;
background: linear-gradient(135deg, rgba(74, 144, 226, 0.1), rgba(74, 144, 226, 0.05));
}
.stat-card.wrapped .stat-card-count { color: #4A90E2; }

.stat-card.preloaded {
border-top: 3px solid #5856D6;
background: linear-gradient(135deg, rgba(88, 86, 214, 0.1), rgba(88, 86, 214, 0.05));
}
.stat-card.preloaded .stat-card-count { color: #5856D6; }

.stat-card.failed {
border-top: 3px solid #FF3B30;
background: linear-gradient(135deg, rgba(255, 59, 48, 0.1), rgba(255, 59, 48, 0.05));
}
.stat-card.failed .stat-card-count { color: #FF3B30; }



/* 总结部分 */
.statistics-summary {
margin-top: 20px;
padding: 20px;
background: linear-gradient(135deg, #f0f8ff 0%, #e6f2ff 100%);
border-radius: 10px;
border: 1px solid #d1e8ff;
}

.summary-title {
font-size: 14px;
font-weight: 700;
color: #4A90E2;
margin-bottom: 15px;
display: flex;
align-items: center;
gap: 8px;
}

.summary-grid {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
gap: 15px;
margin-bottom: 20px;
}

.summary-card {
background: white;
padding: 15px;
border-radius: 8px;
border: 1px solid #e9ecef;
text-align: center;
transition: all 0.3s ease;
}

.summary-card:hover {
transform: translateY(-2px);
box-shadow: 0 5px 15px rgba(74, 144, 226, 0.2);
}

.summary-card-label {
font-size: 12px;
color: #666;
margin-bottom: 8px;
display: flex;
align-items: center;
justify-content: center;
gap: 6px;
}

.summary-card-value {
font-size: 20px;
font-weight: 800;
color: #4A90E2;
}

.summary-tips {
padding: 15px;
background: white;
border-radius: 8px;
border: 1px solid #e9ecef;
border-left: 4px solid #34C759;
}

.tips-title {
font-size: 12px;
color: #666;
margin-bottom: 8px;
display: flex;
align-items: center;
gap: 6px;
}

.tips-content {
font-size: 11px;
color: #333;
line-height: 1.5;
}

/* ==================== 新增的失败列表样式 ==================== */
.failed-list {
max-height: 200px;
overflow-y: auto;
border: 1px solid #e9ecef;
border-radius: 8px;
margin-top: 10px;
}

.failed-item {
padding: 10px 12px;
border-bottom: 1px solid #f0f0f0;
font-size: 10px;
display: flex;
justify-content: space-between;
align-items: center;
transition: background-color 0.2s;
flex-wrap: wrap;  /* 添加这个！ */
}

.failed-item:hover {
background-color: #f8f9fa;
}

.failed-item:last-child {
border-bottom: none;
}


.failed-id {
font-size: 10px;
color: #999;
margin-top: 2px;
word-break: break-all;
min-width: 10px; 
}

.failed-reason {
font-size: 10px;
padding: 2px 8px;
border-radius: 10px;
font-weight: 600;
margin-left: 10px;
white-space: normal;  
}



/* 成功状态样式 */
.success-state {
text-align: center;
padding: 20px;
color: #34C759;
background: rgba(52, 199, 89, 0.05);
border-radius: 8px;
margin-top: 10px;
}

.success-icon {
font-size: 32px;
margin-bottom: 10px;
}

/* 加载动画 */
@keyframes fadeIn {
from {
opacity: 0;
transform: translateY(10px);
}
to {
opacity: 1;
transform: translateY(0);
}
}

.data-statistics-content > div {
animation: fadeIn 0.5s ease forwards;
}

.data-statistics-content > div:nth-child(1) { animation-delay: 0.1s; }
.data-statistics-content > div:nth-child(2) { animation-delay: 0.2s; }
.data-statistics-content > div:nth-child(3) { animation-delay: 0.3s; }
.data-statistics-content > div:nth-child(4) { animation-delay: 0.4s; }

/* 空状态 */
.empty-stats {
text-align: center;
padding: 40px 20px;
color: #8E8E93;
}

.empty-stats-icon {
font-size: 48px;
margin-bottom: 16px;
opacity: 0.5;
}

.empty-stats-title {
font-size: 16px;
font-weight: 600;
margin-bottom: 8px;
}

.empty-stats-message {
font-size: 13px;
max-width: 300px;
margin: 0 auto;
line-height: 1.5;
}

/* 响应式设计 */
@media (max-width: 768px) {
.data-statistics-card {
margin: 0 16px 16px;
}
.stats-grid {
grid-template-columns: repeat(3, 1fr);
gap: 8px;
}
.stat-card {
padding: 10px 6px;
min-height: 70px;
}
.stat-card-count {
font-size: 18px;
}
.stat-card-label {
font-size: 10px;
}
.stat-group {
padding: 12px;
}
.stat-group-title {
font-size: 14px;
}
.progress-bar-container {
height: 20px;
}
.progress-bar {
font-size: 10px;
line-height: 20px;
}
.summary-grid {
grid-template-columns: 1fr;
}
}

@media (max-width: 480px) {
.stats-grid {
grid-template-columns: repeat(2, 1fr);
}
}


/* ==================== 响应式设计 ==================== */
@media (max-width: 768px) {
.quick-btn {
width: 26px;
height: 26px;
font-size: 13px;
}
.quick-toolbar-left { font-size: 10px; }
.quick-toolbar-center { gap: 1px; }
.quick-toolbar-right { font-size: 9px; }
.mode-status { font-size: 9px; padding: 1px 4px; min-width: 35px; }
.tool-name { font-size: 9px; padding: 1px 4px; }
.tool-btn,
.action-btn {
padding: 10px 12px;
font-size: 14px;
min-height: 44px;
}
/* 数据管理和使用指南响应式 */
    #dataManagementDialog {
        width: 90%;
        left: 5%;
        right: 5%;
        max-height: 95vh;
    }

    #guideDialog {
        width: 90%;
        left: 5%;
        right: 5%;
        max-height: 95vh;
    }

.quick-actions-grid {
grid-template-columns: repeat(2, 1fr);
padding: 16px;
}
.guide-card,
.data-comparison-card,
.operation-log-card,
.field-info-card {
margin-left: 16px;
margin-right: 16px;
}
.card-content {
padding: 16px;
}
.data-comparison-table {
font-size: 12px;
}
.data-comparison-table th,
.data-comparison-table td {
padding: 10px 12px;
}
.section-grid,
.info-grid {
