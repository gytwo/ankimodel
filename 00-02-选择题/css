  /* =====================================
    字体与基础设置
    ===================================== */

  /* 全局样式重置 */
  ::-webkit-scrollbar {
      display: none;
  }

  html {
      margin: 0;
      padding: 0;
  }

  body {
      transform: none !important;
      background-color: var(--body-bg) ; 
      color: var(--body-color);
      max-width: 790px;
      margin: auto;
      padding: 0;
      font-family: 'Source Sans Pro', -apple-system, BlinkMacSystemFont, 'PingFang SC',Helvetica, Arial, 'Microsoft YaHei', 微软雅黑, 黑体, Heiti, sans-serif,SimSun, 宋体, serif,'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji';
  }

  body.narrow {
      max-width: 790px;
      margin-left: auto;
      margin-right: auto;
      padding-left: 0px;
      padding-right: 0px;
  }

  /* =====================================
    卡片基础样式
    ===================================== */
  .card {
	    font-family: lxgw;
      font-size: 16px;
      text-align: left;
      background-color: var(--card-bg);
     // padding: 2rem 1.5rem 1rem 0.5rem; /* 上右下左*/
      padding: 2.5rem 3rem;
    // box-shadow: 0 1px 2px 0 rgba(60,64,67,0.3), 0 1px 3px 1px rgba(60,64,67,0.15);
  }
     .special {
      font-size: 30px;
      text-align: center;
  }


  /* =====================================
    图片样式
    ===================================== */
  img {
      width: auto;
      height: auto;
      margin: 0 auto;
      max-width: 100%;
      max-height: 100%;
  }

  /* =====================================
    超链接样式
    ===================================== */
a {
	text-decoration: none; /* 去掉超链接下划线 */
}

.nightmode a {
	color: white; /* 亮蓝色超链接 */
}

  /* =====================================
    页眉样式
    ===================================== */

    /* 页眉按钮样式 */
    button.header-container {
    all: unset; /* 重置所有按钮默认样式 */
    position: fixed;
    top: 0;
    left: 0px;
    right: 0px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 4px 12px;
    z-index: 1000;
    font-size: 12px;
    color: #666;
   // background-color: #C7EDCC;
    background-color: var(--card-bg);
    cursor: pointer;
    width: 100%;
    box-sizing: border-box;
    transition: background-color 0.2s;
}

    /* 内部布局 */
    #source-display {
    flex: 1;
    text-align: center;
    white-space: nowrap;
    overflow-x: auto;
    margin: 0 12px;
}

   /* 夜间模式 */
   .nightMode button.header-container {
    background-color: #3A3A3A;
    color: #E0E0E0;
}

  /* =====================================
    details样式
    ===================================== */
details > summary {
    cursor: pointer !important;
    list-style: none !important;
    position: relative !important;
    padding-left: 15px !important;
    display: block !important;
    min-height: 28px !important;
    line-height: 28px !important;
}

/* 圆点固定位置 */
details > summary::before {
    content: '' !important;
    position: absolute !important;
    left: 0px !important;
    top: 12px !important;
    width: 3px !important;
    height: 3px !important;
    border-radius: 3px !important;
    background-color: rgb(100, 106, 115) !important;
    transition: all 0.2s ease !important;
    z-index: 1 !important;
}

/* 移除默认箭头 */
details > summary::-webkit-details-marker,
details > summary::marker {
    display: none !important;
}

/* 折叠状态 */
details:not([open]) > summary::before {
    box-shadow: 
        0 0 0 2px rgb(100, 106, 115),
        0 0 0 4px rgb(200, 200, 200) !important;
    background-color: transparent !important;
}

/* 展开状态 */
details[open] > summary::before {
    box-shadow: none !important;
    background-color: rgb(100, 106, 115) !important;
}

/*嵌套缩进*/
details details { margin-left: 5px; }

 /* =====================================
    简单表格样式
    ===================================== */

table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
}

th, td {
