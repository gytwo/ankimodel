}

.no-data-message .title {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
}

.no-data-message .subtitle {
    font-size: 12px;
    opacity: 0.7;
}

/* 滚动条样式 */
.image-data-list-content::-webkit-scrollbar {
    width: 6px;
}

.image-data-list-content::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 3px;
}

.image-data-list-content::-webkit-scrollbar-thumb {
    background: #c1c1c1;
    border-radius: 3px;
}

.image-data-list-content::-webkit-scrollbar-thumb:hover {
    background: #a8a8a8;
}



/* ==================== 系统通知和状态 ==================== */
.system-notification {
position: fixed;
top: 20px;
left: 50%;
transform: translateX(-50%);
background: #333;
color: white;
padding: 12px 20px;
border-radius: 8px;
z-index: 100002;
display: flex;
align-items: center;
gap: 10px;
box-shadow: 0 4px 16px rgba(0,0,0,0.3);
animation: slideDown 0.3s ease;
max-width: 90%;
word-break: break-word;
line-height: 1.4;
font-size: 14px;
}

.system-notification.info { background: #4A90E2; }
.system-notification.warning { background: #FF9500; }
.system-notification.success { background: #34C759; }
.system-notification.error { background: #FF3B30; }

@keyframes slideDown {
from { opacity: 0; transform: translateX(-50%) translateY(-20px); }
to { opacity: 1; transform: translateX(-50%) translateY(0); }
}

.loading-indicator {
position: fixed;
top: 50%;
left: 50%;
transform: translate(-50%, -50%);
background: rgba(0, 0, 0, 0.8);
color: white;
padding: 20px 30px;
border-radius: 12px;
z-index: 100001;
display: flex;
flex-direction: column;
align-items: center;
gap: 15px;
box-shadow: 0 8px 32px rgba(0,0,0,0.5);
animation: fadeIn 0.3s ease;
min-width: 200px;
text-align: center;
}

.loading-spinner {
width: 40px;
height: 40px;
border: 4px solid rgba(255,255,255,0.3);
border-radius: 50%;
border-top-color: #4A90E2;
animation: spin 1s ease-in-out infinite;
}

.loading-progress {
width: 100%;
height: 6px;
background: rgba(255,255,255,0.2);
border-radius: 3px;
overflow: hidden;
}

.loading-progress-bar {
height: 100%;
background: #4A90E2;
border-radius: 3px;
width: 0%;
transition: width 0.3s ease;
}

@keyframes spin {
to { transform: rotate(360deg); }
}

.storage-status {
position: fixed;
bottom: 10px;
right: 10px;
background: rgba(0, 0, 0, 0.7);
color: white;
padding: 6px 10px;
border-radius: 6px;
font-size: 10px;
z-index: 9999;
display: none;
}

.storage-status.saving { background: rgba(255, 193, 7, 0.8); }
.storage-status.saved { background: rgba(40, 167, 69, 0.8); }
.storage-status.error { background: rgba(220, 53, 69, 0.8); }

.field-status {
position: fixed;
bottom: 50px;
right: 10px;
background: rgba(0, 0, 0, 0.7);
color: white;
padding: 6px 10px;
border-radius: 6px;
font-size: 10px;
z-index: 9999;
display: none;
max-width: 300px;
}

.field-status.found { background: rgba(40, 167, 69, 0.8); }
.field-status.not-found { background: rgba(255, 193, 7, 0.8); }
.field-status.auto-created { background: rgba(0, 123, 255, 0.8); }

