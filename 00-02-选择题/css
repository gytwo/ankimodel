border: 1px solid #e9ecef;
}

.data-statistics-header {
padding: 12px 16px;
min-height: 52px; /* 🔥 设置最小高度保持一致 */
background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
border-bottom: 1px solid #dee2e6;
display: flex;
justify-content: space-between;
align-items: center;
}

.data-statistics-title {
font-size: 16px;
font-weight: 700;
color: #333;
display: flex;
align-items: center;
gap: 10px;
}

.data-statistics-content {
    padding: 10px;
