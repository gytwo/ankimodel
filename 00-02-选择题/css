background: linear-gradient(135deg, rgba(88, 86, 214, 0.05), rgba(88, 86, 214, 0.02));
}
.stat-group.total .stat-group-title {
color: #5856D6;
}
.stat-group.total .stat-group-title-icon {
background: #5856D6;
}

/* 统计网格 */
.stats-grid {
display: grid;
grid-template-columns: repeat(5, 1fr);
gap: 12px;
margin-top: 15px;
}

.stat-card {
background: #f8f9fa;
border-radius: 8px;
padding: 14px;
text-align: center;
border: 1px solid #e9ecef;
transition: all 0.2s ease;
cursor: pointer;
min-height: 80px;
display: flex;
flex-direction: column;
justify-content: center;
}

.stat-card:hover {
transform: translateY(-2px) scale(1.02);
box-shadow: 0 5px 15px rgba(0,0,0,0.15);
}

.stat-card-count {
font-size: 22px;
font-weight: 800;
margin-bottom: 6px;
transition: all 0.3s ease;
}

.stat-card-label {
font-size: 11px;
color: #666;
font-weight: 600;
text-transform: uppercase;
letter-spacing: 0.5px;
}

.stat-card.blank {
border-top: 3px solid #8E8E93;
background: linear-gradient(135deg, #f8f9fa, #e9ecef);
}
.stat-card.blank .stat-card-count { color: #8E8E93; }

.stat-card.with-data {
border-top: 3px solid #34C759;
background: linear-gradient(135deg, rgba(52, 199, 89, 0.1), rgba(52, 199, 89, 0.05));
}
.stat-card.with-data .stat-card-count { color: #34C759; }

.stat-card.wrapped {
border-top: 3px solid #4A90E2;
background: linear-gradient(135deg, rgba(74, 144, 226, 0.1), rgba(74, 144, 226, 0.05));
}
.stat-card.wrapped .stat-card-count { color: #4A90E2; }

.stat-card.preloaded {
border-top: 3px solid #5856D6;
background: linear-gradient(135deg, rgba(88, 86, 214, 0.1), rgba(88, 86, 214, 0.05));
}
.stat-card.preloaded .stat-card-count { color: #5856D6; }

.stat-card.failed {
border-top: 3px solid #FF3B30;
background: linear-gradient(135deg, rgba(255, 59, 48, 0.1), rgba(255, 59, 48, 0.05));
}
.stat-card.failed .stat-card-count { color: #FF3B30; }



