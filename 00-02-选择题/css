background: linear-gradient(135deg, rgba(52, 199, 89, 0.05), rgba(52, 199, 89, 0.02));
}
.stat-group.main-page .stat-group-title {
color: #34C759;
}
.stat-group.main-page .stat-group-title-icon {
background: #34C759;
}

.stat-group.popup {
border-left-color: #FF9500;
background: linear-gradient(135deg, rgba(255, 149, 0, 0.05), rgba(255, 149, 0, 0.02));
}
.stat-group.popup .stat-group-title {
color: #FF9500;
}
.stat-group.popup .stat-group-title-icon {
background: #FF9500;
}

.stat-group.total {
