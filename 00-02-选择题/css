/* ==================== 使用指南样式 ==================== */
#guideDialog {
    position: fixed;
    top: 30px;                     /* 固定顶部距离 */
    right: 40px;
    background: white;
    border: 1px solid #ddd;
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.12);
    z-index: 10001;
    width: 450px;
    height: 600px;
    max-height: 100%;         
    overflow: auto;
    font-family: inherit;
    cursor: grab;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
    display: flex;
    flex-direction: column;
    touch-action: pan-y;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
