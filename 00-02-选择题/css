align-items: center;
width: 100%;
padding: 8px 10px;
margin: 3px 0;
border: none;
border-radius: 6px;
background: #f8f9fa;
cursor: pointer;
font-size: 12px;
color: #333;
transition: all 0.15s;
text-align: left;
line-height: 1.2;
touch-action: manipulation;
}

.tool-btn:hover {
background: #e9ecef;
}

.tool-btn:active {
